# NASA/JPL "Power of 10" coding standard — C# enforcement, solution-wide.
# Rationale and ratchet plan: docs/coding-standards-power-of-10.md
root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# ============================================================================
#  ERROR — the mission-critical rules. These break the build by design; a hit
#  is either a real defect or an intentional construct that must be justified
#  with an inline  #pragma warning disable <ID> // why...  before it.
# ============================================================================

# Rule 2 — all loops must have a fixed upper bound (no statically-infinite loop).
dotnet_diagnostic.S2189.severity = error
# Rule 1 — simple control flow: no unbounded recursion.
dotnet_diagnostic.S2190.severity = error
# Rule 2 (temporal) — forward a CancellationToken so every async I/O is time-bounded.
dotnet_diagnostic.CA2016.severity = error
# Rule 7 — pass the right token; don't silently drop a passed-in one.
dotnet_diagnostic.CA2247.severity = error

# ============================================================================
#  WARNING — high-value rules worth seeing. Kept short and meaningful on purpose
#  (the noise buckets below are demoted so these don't get buried).
# ============================================================================

# Rule 7 — do not ignore a method's return value (e.g. an unchecked Result).
dotnet_diagnostic.CA1806.severity = warning
dotnet_diagnostic.S2201.severity = warning
# Rule 6 — declare data at the smallest scope / no dead state.
dotnet_diagnostic.IDE0059.severity = warning   # unnecessary value assignment
dotnet_diagnostic.S1481.severity  = warning    # unused local variable
dotnet_diagnostic.S1144.severity  = warning    # unused private member
dotnet_diagnostic.S4487.severity  = warning    # unread private field
# Resource safety — an actually-undisposed instance (real leak; e.g. SiphogClient was one).
dotnet_diagnostic.S2930.severity  = warning
# Error handling — swallowed / overly-broad exception handling (mild safety value).
# CA1031 (broad catch of Exception) is intentional at our UI / async / hardware
# boundaries — e.g. the E-Stop motion backstop must swallow anything so one device's
# failure can't stop the others. These catches already log, so the rule is noise here.
# The real "don't silently swallow" signal is kept via S2486/S108 (still warning).
dotnet_diagnostic.CA1031.severity = suggestion # catch of general Exception (logged at boundaries)
dotnet_diagnostic.S2486.severity  = warning    # exception ignored WITHOUT explanation
dotnet_diagnostic.S108.severity   = warning    # empty code block

# ============================================================================
#  SUGGESTION — visible in the IDE, never spams the build log.
#  Rule 4 complexity debt lives here for now; ratchet to `warning`/`error` per
#  assembly as it's cleaned (active-alignment code first). See the docs.
# ============================================================================
dotnet_diagnostic.S138.severity  = suggestion  # method too long
dotnet_diagnostic.S1541.severity = suggestion  # cyclomatic complexity
dotnet_diagnostic.S3776.severity = suggestion  # cognitive complexity
dotnet_diagnostic.S3358.severity = suggestion  # nested ternary
# Type owns an IDisposable field — in this codebase that's usually a transient
# per-run CancellationTokenSource disposed in finally, so it's not a leak; making
# the type IDisposable would just relocate the warning to its owner. Real leaks are
# caught by S2930 instead. (See the CancellationTokenSource discussion in git log.)
dotnet_diagnostic.CA1001.severity = suggestion
dotnet_diagnostic.S125.severity  = suggestion  # commented-out code
dotnet_diagnostic.S1244.severity = suggestion  # float equality (review case-by-case)
dotnet_diagnostic.S6966.severity = suggestion  # await CancelAsync
dotnet_diagnostic.S1135.severity = suggestion  # TODO comments are legitimate work markers, not build warnings
dotnet_style_qualification_for_field = false:suggestion
csharp_prefer_braces = true:suggestion

# ============================================================================
#  NONE — noise for this codebase. A single-locale industrial app on a fixed
#  rig; globalization + micro-perf/collection lints add no value here.
# ============================================================================
# Globalization (machine runs one locale; culture-specific parsing is intentional).
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
# Micro-perf / collection-method preferences (no measurable impact in this UI/host).
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.S6602.severity  = none
dotnet_diagnostic.S6603.severity  = none
dotnet_diagnostic.S6605.severity  = none
dotnet_diagnostic.S6610.severity  = none
dotnet_diagnostic.S3267.severity  = none       # "use LINQ Where" loop rewrites
# Can-be-static / naming nits.
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.S2325.severity  = none
