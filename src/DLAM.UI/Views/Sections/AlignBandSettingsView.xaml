<!-- Machine › Settings, DLAM panel: the Run page's alignment band (AlignBandSettingsViewModel). -->
<UserControl x:Class="DLAM.UI.Views.Sections.AlignBandSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Run page alignment band" Foreground="{StaticResource Text}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBlock Text="The lens hexapods, the photocurrent feedback and the presets behind the Run page's XCAN / climb buttons. Levels in µA."
                   Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left lens hexapod" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LeftDevice, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Right lens hexapod" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RightDevice, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="SMU" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Smu, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Feedback channel" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="3" Grid.Column="1" Width="120" Height="26" HorizontalAlignment="Left" Margin="0,0,0,8"
                      SelectedIndex="{Binding FeedbackChannelIndex}">
                <ComboBoxItem Content="ch1" />
                <ComboBoxItem Content="ch2" />
            </ComboBox>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Axes" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Axes, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Axis set every scan covers (order is always Z, Y, X)" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Coarse ladder (µm)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CoarseStepsUm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Fine ladder (µm)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FineStepsUm, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="0" Grid.Column="3" Text="XCAN exit target (0 = off)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding ExitTargetUa, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Min starting signal" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MinSignalUa, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="A scan refuses to start below this photocurrent — the light is probably off" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Two-lens target" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding TwoLensTargetUa, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="3" Text="Two-lens zone low" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding ZoneLowUa, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="4" Grid.Column="3" Text="Climb target (stops at 85 %)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding ClimbTargetUa, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="5" Grid.Column="3" Text="Climb Z step (µm)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding ClimbZStepUm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="6" Grid.Column="3" Text="Climb Z budget (µm, ≤ 200)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding ClimbMaxZUm, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </StackPanel>
</UserControl>
