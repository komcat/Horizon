<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MVTec.HalconDotNet" Version="25110.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <!-- Basler Pylon .NET wrapper from the local pylon installation (must match native runtime).
       Resolved per machine: PYLON_DEV_DIR (set by the pylon installer) first, then the
       pylon 8 ("pylon 8") and pylon 9+ ("pylon") default install dirs. Within the SDK,
       prefer the net8.0 build (pylon 9+) over the root x64 build (.NET Framework). -->
  <PropertyGroup>
    <PylonDevDir Condition="'$(PYLON_DEV_DIR)' != '' And Exists('$(PYLON_DEV_DIR)Assemblies\Basler.Pylon')">$(PYLON_DEV_DIR)</PylonDevDir>
    <PylonDevDir Condition="'$(PylonDevDir)' == '' And Exists('C:\Program Files\Basler\pylon 8\Development\Assemblies\Basler.Pylon')">C:\Program Files\Basler\pylon 8\Development\</PylonDevDir>
    <PylonDevDir Condition="'$(PylonDevDir)' == '' And Exists('C:\Program Files\Basler\pylon\Development\Assemblies\Basler.Pylon')">C:\Program Files\Basler\pylon\Development\</PylonDevDir>
    <PylonAssembly Condition="Exists('$(PylonDevDir)Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll')">$(PylonDevDir)Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</PylonAssembly>
    <PylonAssembly Condition="'$(PylonAssembly)' == ''">$(PylonDevDir)Assemblies\Basler.Pylon\x64\Basler.Pylon.dll</PylonAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckPylonSdk" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(PylonAssembly)')">
    <Error Text="Basler pylon .NET SDK not found (looked for '$(PylonAssembly)'). Install pylon with the Developer/.NET components, or set PYLON_DEV_DIR." />
  </Target>

  <!-- IDS peak .NET SDK — only included when the SDK is installed -->
  <PropertyGroup>
    <HAS_IDS_PEAK Condition="Exists('C:\Program Files\IDS\ids_peak\generic_sdk\api\binding\dotnet\x86_64\ids_peak_dotnet.dll')">true</HAS_IDS_PEAK>
  </PropertyGroup>
  <ItemGroup Condition="'$(HAS_IDS_PEAK)' == 'true'">
    <!-- Private=true so the managed bindings land next to the .exe. Without it the
         adapter compiles but throws FileNotFoundException at runtime on a target
         that has no IDS Peak SDK installed (same contract as Basler.Pylon above). -->
    <Reference Include="ids_peak_dotnet">
      <HintPath>C:\Program Files\IDS\ids_peak\generic_sdk\api\binding\dotnet\x86_64\ids_peak_dotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ids_peak_ipl_dotnet">
      <HintPath>C:\Program Files\IDS\ids_peak\generic_sdk\ipl\binding\dotnet\x86_64\ids_peak_ipl_dotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ids_peak_afl_dotnet">
      <HintPath>C:\Program Files\IDS\ids_peak\generic_sdk\afl\binding\dotnet\x86_64\ids_peak_afl_dotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HAS_IDS_PEAK)' != 'true'">
    <Compile Remove="Adapters\IDSPeakCameraAdapter.cs" />
  </ItemGroup>

</Project>
