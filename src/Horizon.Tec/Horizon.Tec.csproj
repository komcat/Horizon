<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Config\Horizon.Config.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <!-- Thorlabs Kinesis SDK native DLLs for TTC-001 — copied to output if the
       standard Kinesis installer path is present. Falls through silently if
       the SDK is not installed; the adapter still loads but Connect() throws
       DllNotFoundException at runtime. -->
  <ItemGroup>
    <None Include="C:\Program Files\Thorlabs\Kinesis\Thorlabs.MotionControl.TCube.TEC.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="Thorlabs.MotionControl.TCube.TEC.dll"
          Condition="Exists('C:\Program Files\Thorlabs\Kinesis\Thorlabs.MotionControl.TCube.TEC.dll')" />
    <None Include="C:\Program Files\Thorlabs\Kinesis\Thorlabs.MotionControl.DeviceManager.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="Thorlabs.MotionControl.DeviceManager.dll"
          Condition="Exists('C:\Program Files\Thorlabs\Kinesis\Thorlabs.MotionControl.DeviceManager.dll')" />
  </ItemGroup>

</Project>
