<Application x:Class="Horizon.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:Horizon.UI.Mvvm"
             xmlns:vm="clr-namespace:Horizon.UI.ViewModels"
             xmlns:vms="clr-namespace:Horizon.UI.ViewModels.Sections"
             xmlns:v="clr-namespace:Horizon.UI.Views"
             xmlns:vsec="clr-namespace:Horizon.UI.Views.Sections"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <mvvm:BoolToBrushConverter x:Key="BoolToBrush" />
            <mvvm:BoolToStatusTextConverter x:Key="BoolToStatusText" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Theme palette — bound to Windows SystemColors so Horizon.UI follows
                 the user's system colours/accent (live via DynamicResource). Must
                 precede any style/template below that references these keys. -->
            <SolidColorBrush x:Key="Bg"       Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
            <SolidColorBrush x:Key="Panel"    Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
            <SolidColorBrush x:Key="Text"     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
            <SolidColorBrush x:Key="Subtle"   Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
            <SolidColorBrush x:Key="Edge"     Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}" />
            <SolidColorBrush x:Key="Accent"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
            <SolidColorBrush x:Key="OnAccent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

            <!-- Fixed status colours — semantic, intentionally theme-independent. -->
            <SolidColorBrush x:Key="Danger" Color="#E74C3C" />
            <SolidColorBrush x:Key="Warn"   Color="#FFB74D" />
            <SolidColorBrush x:Key="Ok"     Color="#81C784" />

            <!-- Horizontal device picker — a persistent button per device,
                 single-select with the active one highlighted. Used by every
                 Machine-page section in place of a device drop-down. -->
            <Style x:Key="DeviceSelector" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{StaticResource Panel}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="Padding" Value="14,5" />
                            <Setter Property="Margin" Value="0,2,6,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- View resolution: the shell binds a view model; WPF picks the view. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <v:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MachinePageViewModel}">
                <v:MachinePageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
                <v:PlaceholderPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubListPageViewModel}">
                <v:SubListPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeckPageViewModel}">
                <v:DeckPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProgramEditorPageViewModel}">
                <v:ProgramEditorPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScriptPageViewModel}">
                <v:ScriptPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:StatusSectionViewModel}">
                <vsec:StatusSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PlaceholderSectionViewModel}">
                <vsec:PlaceholderSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SmuSectionViewModel}">
                <vsec:SmuSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MeasurementSectionViewModel}">
                <vsec:MeasurementSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:IoSectionViewModel}">
                <vsec:IoSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PneumaticSectionViewModel}">
                <vsec:PneumaticSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MotionSectionViewModel}">
                <vsec:MotionSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:LaserSectionViewModel}">
                <vsec:LaserSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:TecSectionViewModel}">
                <vsec:TecSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PowerSupplySectionViewModel}">
                <vsec:PowerSupplySectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:CameraSectionViewModel}">
                <vsec:CameraSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SettingsSectionViewModel}">
                <vsec:SettingsSectionView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
