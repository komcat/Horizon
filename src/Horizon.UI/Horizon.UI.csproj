<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 platform version so SkiaSharp.Views.WPF resolves its
         net8.0-windows lib (not the net462 fallback). -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.UI</RootNamespace>
    <AssemblyName>Horizon.UI</AssemblyName>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- HALCON native bundle — Horizon.Engine references MVTec.HalconDotNet (Vision facet). -->
  <ItemGroup>
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="24050.0.0" />
    <!-- SkiaSharp WPF surface for live telemetry charts. -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
    <!-- Code editor for the .moon script page (syntax highlight + completion). -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <!-- Layer 3 references the engine + workflow interfaces only. -->
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>

</Project>
