<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.UI</RootNamespace>
    <AssemblyName>Horizon.UI</AssemblyName>
  </PropertyGroup>

  <!-- HALCON native bundle — Horizon.Engine references MVTec.HalconDotNet (Vision facet). -->
  <ItemGroup>
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="24050.0.0" />
  </ItemGroup>

  <!-- Layer 3 references the engine + workflow interfaces only. -->
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>

</Project>
