<Window x:Class="Horizon.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon — Starting"
        Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="HORIZON"
                       Foreground="{StaticResource Accent}" FontSize="34" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Text="Layer 3 operator UI"
                       Foreground="{StaticResource Subtle}" FontSize="13" Margin="2,0,0,18" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Starting…"
                           Foreground="{StaticResource Text}" FontSize="14" Margin="0,0,0,8" />
                <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0" />
            </StackPanel>

            <Border Grid.Row="3" Margin="0,16,0,0"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Panel}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="{StaticResource Subtle}"
                               FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" Margin="8" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Visibility="Collapsed" />
                <StackPanel x:Name="ErrorButtons" Orientation="Horizontal"
                            HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Retry" Width="84" Height="28" Margin="0,0,8,0"
                            Click="OnRetryClick" />
                    <Button Content="Exit" Width="84" Height="28"
                            Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
