<Window x:Class="Horizon.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Identity strip: current product + signed-in operator + log in/out.
             Always visible (home launcher and pages). -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HORIZON" Foreground="{StaticResource Subtle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Product: " Foreground="{StaticResource Subtle}" />
                        <Run Text="{Binding ProductLabel, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0">
                        <Run Text="Operator: " Foreground="{StaticResource Subtle}" />
                        <Run Text="{Binding OperatorLabel, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Content="{Binding LoginButtonText}" Click="OnLoginLogout"
                            Width="82" Height="26" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shell chrome: Back + page title, hidden on the home launcher. -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="◄  Back" Command="{Binding GoHomeCommand}"
                        Height="32" Padding="14,0" FontWeight="SemiBold"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" />
                <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource Text}"
                           FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentView}" />
    </Grid>
</Window>
