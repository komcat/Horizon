<Window x:Class="Horizon.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shell chrome: Back + page title, hidden on the home launcher. -->
        <Border Grid.Row="0" Background="#161618" BorderBrush="#3A3A40" BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="◄  Back" Command="{Binding GoHomeCommand}"
                        Height="32" Padding="14,0" FontWeight="SemiBold"
                        Background="#2D6CDF" Foreground="White" BorderThickness="0" />
                <TextBlock Text="{Binding PageTitle}" Foreground="#E0E0E0"
                           FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
