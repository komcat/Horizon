<Window x:Class="Horizon.UI.ShutdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon — Closing"
        Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="#1E1E22">
    <Border BorderBrush="#3A3A40" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="HORIZON"
                       Foreground="#4FC3F7" FontSize="34" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Text="Disconnecting hardware"
                       Foreground="#8A8A92" FontSize="13" Margin="2,0,0,18" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Shutting down…"
                           Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8" />
                <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"
                             Foreground="#4FC3F7" Background="#2A2A30" BorderThickness="0" />
            </StackPanel>

            <Border Grid.Row="3" Margin="0,16,0,0"
                    Background="#161618" BorderBrush="#2A2A30" BorderThickness="1">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="#9AA0A6"
                               FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" Margin="8" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
