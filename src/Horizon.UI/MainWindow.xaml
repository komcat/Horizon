<Window x:Class="Horizon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E22">
    <Window.Resources>
        <!-- Dark-theme tweaks scoped to this window. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="#C8C8CE" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#3A3A40" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HORIZON" Foreground="#4FC3F7"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="#2A2A30" CornerRadius="3" Padding="8,3" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Engine: " Foreground="#8A8A92" />
                        <Run Text="{Binding EngineState, Mode=OneWay}" Foreground="#E0E0E0" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding DeviceSummary, Mode=OneWay}"
                       Foreground="#8A8A92" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="13" />

            <Button Grid.Column="2" Content="Reconnect" Width="100" Height="30"
                    Command="{Binding ReconnectCommand}" />
        </Grid>

        <!-- Hardware status dashboard -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#161618" RowBackground="#1E1E22" AlternatingRowBackground="#212126"
                  Foreground="#D0D0D4" BorderBrush="#3A3A40"
                  HorizontalGridLinesBrush="#2A2A30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="120" />
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="170" />
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding IsConnected, Converter={StaticResource BoolToStatusText}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"
                                    FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      Background="#2A2A30" Margin="0,4" />

        <!-- Log -->
        <Border Grid.Row="3" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1">
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}"
                     Background="Transparent" BorderThickness="0" Foreground="#D0D0D4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,1" TextElement.Foreground="{Binding Color}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="Consolas"
                                       FontSize="11.5" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
