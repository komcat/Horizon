<UserControl x:Class="Horizon.UI.Views.Sections.CameraSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#161618">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Camera picker -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Camera" Foreground="#8A8A92" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ListBox Style="{StaticResource DeviceSelector}" VerticalAlignment="Center" Margin="0,0,16,0"
                         ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" />
                <TextBlock Text="Connected" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Connected}" Foreground="#E0E0E0" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Grab controls + stats -->
        <Border Grid.Row="1" Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Start" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding StartCommand}" />
                <Button Content="Stop" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding StopCommand}" />
                <Button Content="Snap" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding SnapCommand}" />
                <Button Content="Pop out" Width="74" Height="26" Margin="0,0,16,0"
                        Command="{Binding PopOutCommand}" />
                <TextBlock Text="Grabbing" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Grabbing}" Foreground="#4FC3F7"
                           Margin="6,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Resolution}" Foreground="#E0E0E0" FontFamily="Consolas"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Fps}" Foreground="#E0E0E0" FontFamily="Consolas"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="Frames" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FramesReceived}" Foreground="#E0E0E0" FontFamily="Consolas"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Exposure controls -->
        <Border Grid.Row="2" Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exposure µs" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBox Width="80" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding ExposureUs}" />
                <TextBlock Text="Gain" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBox Width="56" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding Gain}" />
                <TextBlock Text="FPS" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBox Width="56" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding FrameRate}" />
                <CheckBox Content="Auto exposure" Foreground="#D0D0D4" VerticalAlignment="Center"
                          Margin="0,0,12,0" IsChecked="{Binding AutoExposure}" />
                <CheckBox Content="Auto gain" Foreground="#D0D0D4" VerticalAlignment="Center"
                          Margin="0,0,16,0" IsChecked="{Binding AutoGain}" />
                <Button Content="Apply" Width="64" Height="26" Margin="0,0,16,0"
                        Command="{Binding ApplyExposureCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="#9AA0A6" FontStyle="Italic"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Live preview -->
        <Border Grid.Row="3" Background="#101012" BorderBrush="#3A3A40" BorderThickness="1,0,1,1" Margin="0,0,0,0">
            <Grid>
                <TextBlock Text="No video — Start grabbing or open Pop out"
                           Foreground="#6A6A72" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoVideo, Converter={StaticResource BoolToVis}}" />
                <Image Source="{Binding Frame}" Stretch="Uniform" Margin="4"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="LowQuality" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
