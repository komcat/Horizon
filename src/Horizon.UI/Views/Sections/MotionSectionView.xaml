<UserControl x:Class="Horizon.UI.Views.Sections.MotionSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#161618">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Device-level controls + Stop -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Device" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <ListBox Style="{StaticResource DeviceSelector}" Margin="8,0,16,0" VerticalAlignment="Center"
                             ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                    <TextBlock Text="Connected" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Connected}" Foreground="#E0E0E0"
                               Margin="8,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="Moving" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IsMoving}" Foreground="#FFB74D"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Content="STOP" Width="110" Height="34"
                        FontWeight="Bold" Foreground="White" Background="#C0392B" BorderThickness="0"
                        Command="{Binding StopCommand}" />
            </Grid>
        </Border>

        <!-- Jog step + velocity -->
        <Border Grid.Row="1" Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Jog step" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBox Width="70" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding JogStep}" />
                <TextBlock Text="Velocity" Foreground="#8A8A92" VerticalAlignment="Center" />
                <TextBox Width="70" Margin="8,0,8,0" VerticalAlignment="Center" Text="{Binding Velocity}" />
                <Button Content="Apply" Width="64" Height="26" Margin="0,0,16,0"
                        Command="{Binding ApplyVelocityCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="#8A8A92" FontStyle="Italic"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Per-axis position + jog -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Axes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E22" BorderBrush="#3A3A40" BorderThickness="1,0,1,1" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="#4FC3F7" FontWeight="SemiBold"
                                           Width="60" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Position}" Foreground="#E0E0E0" FontFamily="Consolas"
                                           Width="140" VerticalAlignment="Center" />
                                <Button Content="−" Width="44" Height="28" Margin="0,0,6,0"
                                        FontSize="16" Command="{Binding JogNegativeCommand}" />
                                <Button Content="+" Width="44" Height="28"
                                        FontSize="16" Command="{Binding JogPositiveCommand}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
