<UserControl x:Class="Horizon.UI.Views.Sections.StatusSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="#C8C8CE" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#3A3A40" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DataGrid ItemsSource="{Binding Devices}"
              AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="#161618" RowBackground="#1E1E22" AlternatingRowBackground="#212126"
              Foreground="#D0D0D4" BorderBrush="#3A3A40"
              HorizontalGridLinesBrush="#2A2A30">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="120" />
            <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="170" />
            <DataGridTemplateColumn Header="Status" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding IsConnected, Converter={StaticResource BoolToStatusText}}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"
                                FontFamily="Consolas" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
