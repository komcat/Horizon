<UserControl x:Class="Horizon.UI.Views.DeckPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Run status — colour-coded per deck-entry state. -->
        <Style x:Key="RunStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatus}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Passed">
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Product" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <ComboBox Width="150" Margin="8,0,20,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" />
                    <TextBlock Text="Deck" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <ComboBox Width="170" Margin="8,0,6,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Decks}" SelectedItem="{Binding SelectedDeck}" />
                    <Button Content="New" Width="56" Height="26" Margin="0,0,20,0"
                            Command="{Binding NewDeckCommand}" />
                    <TextBlock Text="Name" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBox Width="160" Margin="8,0,6,0" VerticalAlignment="Center" Text="{Binding DeckName}" />
                    <Button Content="Save" Width="56" Height="26" Command="{Binding SaveDeckCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run" Width="74" Height="28" Margin="0,0,6,0"
                            FontWeight="SemiBold" Command="{Binding RunCommand}" />
                    <Button Content="Stop" Width="74" Height="28" Command="{Binding StopCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column headers -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="172" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Program" Foreground="{StaticResource Subtle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Enabled" Foreground="{StaticResource Subtle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Condition to run" Foreground="{StaticResource Subtle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Status" Foreground="{StaticResource Subtle}" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Entries -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="172" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Width="206" Height="26"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ItemsSource="{Binding Programs}" SelectedItem="{Binding Program}" />

                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <TextBox Grid.Column="2" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" FontFamily="Consolas"
                                         Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="3" Text="{Binding RunStatus}"
                                           Style="{StaticResource RunStatusText}" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Run" Width="48" Height="26" Margin="0,0,10,0"
                                            Command="{Binding RunCommand}" />
                                    <Button Content="▲" Width="30" Height="26" Margin="0,0,4,0"
                                            Command="{Binding MoveUpCommand}" />
                                    <Button Content="▼" Width="30" Height="26" Margin="0,0,4,0"
                                            Command="{Binding MoveDownCommand}" />
                                    <Button Content="✕" Width="30" Height="26"
                                            Command="{Binding RemoveCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add program" Width="120" Height="28" Margin="0,0,16,0"
                        Command="{Binding AddEntryCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Execution log -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Execution log" Foreground="{StaticResource Subtle}"
                           FontWeight="SemiBold" Padding="10,6" />
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Subtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="10,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
