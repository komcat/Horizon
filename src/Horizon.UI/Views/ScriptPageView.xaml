<UserControl x:Class="Horizon.UI.Views.ScriptPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Script" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Width="160" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ScriptNames}" SelectedItem="{Binding SelectedScript}" />
                <Button Content="Load" Width="56" Height="28" Margin="6,0,0,0" Command="{Binding LoadCommand}" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <TextBlock Text="Name" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Width="130" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Save" Width="56" Height="28" Margin="6,0,0,0" Command="{Binding SaveCommand}" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <ComboBox Width="170" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ExampleNames}" SelectedItem="{Binding SelectedExample}"
                          ToolTip="Load a ready-made snippet into the editor" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <Button Content="► Run" Width="76" Height="28" Command="{Binding RunCommand}" />
                <Button Content="■ Stop" Width="76" Height="28" Margin="6,0,0,0" Command="{Binding StopCommand}" />

                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4">
                    <avalonedit:TextEditor x:Name="Editor"
                                           Document="{Binding Document}"
                                           FontFamily="Consolas" FontSize="14"
                                           ShowLineNumbers="True"
                                           Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                           Padding="4"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto" />
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="{StaticResource Edge}" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4"
                        Margin="0,2,0,0">
                    <TextBox x:Name="OutputBox" FontFamily="Consolas" FontSize="13"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Subtle}"
                             BorderThickness="0" Padding="6" IsReadOnly="True" AcceptsReturn="True"
                             Text="{Binding Output, Mode=OneWay}" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Edge}" Margin="2,0" />

            <Border Grid.Column="2" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="machine API" Foreground="{StaticResource Text}"
                               FontWeight="SemiBold" Margin="8,6" />
                    <TextBox Grid.Row="1" Margin="8,0,8,6" Height="26" VerticalContentAlignment="Center"
                             Text="{Binding CommandFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter commands" />

                    <ListBox Grid.Row="2" x:Name="CommandsList" Margin="4,0,4,4"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding FilteredCommands}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnCommandInsert">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" ToolTip="{Binding Summary}">
                                    <TextBlock Text="{Binding Signature}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Subtle}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
