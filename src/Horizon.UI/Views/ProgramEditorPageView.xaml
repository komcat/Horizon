<UserControl x:Class="Horizon.UI.Views.ProgramEditorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Step list selection highlight + run-status colour. -->
        <Style x:Key="StepItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#D0D0D4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D6CDF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RunStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A92" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatus}" Value="Running">
                    <Setter Property="Foreground" Value="#FFB74D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Passed">
                    <Setter Property="Foreground" Value="#81C784" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                    <Setter Property="Foreground" Value="#E57373" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E22" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Product" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <ComboBox Width="140" Margin="8,0,20,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" />
                    <TextBlock Text="Program" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <ComboBox Width="170" Margin="8,0,6,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" />
                    <Button Content="New" Width="56" Height="26" Margin="0,0,20,0"
                            Command="{Binding NewProgramCommand}" />
                    <TextBlock Text="Name" Foreground="#8A8A92" VerticalAlignment="Center" />
                    <TextBox Width="170" Margin="8,0,6,0" VerticalAlignment="Center" Text="{Binding ProgramName}" />
                    <Button Content="Save" Width="56" Height="26" Command="{Binding SaveProgramCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run" Width="74" Height="28" Margin="0,0,6,0"
                            FontWeight="SemiBold" Command="{Binding RunCommand}" />
                    <Button Content="Stop" Width="74" Height="28" Command="{Binding StopCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step list | step detail -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step list -->
            <Border Grid.Column="0" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Steps" Foreground="#8A8A92" FontWeight="SemiBold" Padding="10,7" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource StepItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding RunStatus}"
                                               Style="{StaticResource RunStatusText}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,6">
                        <Button Content="+ Add" Width="60" Height="26" Margin="0,0,4,0"
                                Command="{Binding AddStepCommand}" />
                        <Button Content="Remove" Width="66" Height="26" Margin="0,0,4,0"
                                Command="{Binding RemoveStepCommand}" />
                        <Button Content="▲" Width="30" Height="26" Margin="0,0,4,0"
                                Command="{Binding MoveStepUpCommand}" />
                        <Button Content="▼" Width="30" Height="26"
                                Command="{Binding MoveStepDownCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step detail -->
            <Border Grid.Column="1" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1" Margin="4,0,0,0">
                <Grid>
                    <TextBlock Text="Select a step to edit" Foreground="#6A6A72"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoSelectedStep, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedStep, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12">
                            <TextBlock Text="Step" Foreground="#4FC3F7" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="Name" Foreground="#8A8A92" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding SelectedStep.Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Operation" Foreground="#8A8A92" Margin="0,0,0,2" />
                            <ComboBox IsEditable="True" Margin="0,0,0,8"
                                      ItemsSource="{Binding Ops}"
                                      Text="{Binding SelectedStep.Op, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Device" Foreground="#8A8A92" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding SelectedStep.Device, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Enabled" Foreground="#D0D0D4" Margin="0,0,20,0"
                                          IsChecked="{Binding SelectedStep.Enabled}" />
                                <CheckBox Content="Breakpoint" Foreground="#D0D0D4"
                                          IsChecked="{Binding SelectedStep.Breakpoint}" />
                            </StackPanel>

                            <TextBlock Text="Parameters" Foreground="#4FC3F7" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedStep.Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,6,0" FontFamily="Consolas"
                                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="1" Margin="0,0,6,0" FontFamily="Consolas"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Content="✕" Width="28" Height="24"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add parameter" Width="130" Height="26" HorizontalAlignment="Left"
                                    Margin="0,4,0,0" Command="{Binding SelectedStep.AddParamCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,7" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#9AA0A6" FontStyle="Italic" />
        </Border>

        <!-- Execution log -->
        <Border Grid.Row="3" Background="#161618" BorderBrush="#3A3A40" BorderThickness="1" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Execution log" Foreground="#8A8A92"
                           FontWeight="SemiBold" Padding="10,6" />
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log}"
                         Background="Transparent" BorderThickness="0" Foreground="#9AA0A6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="10,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
