<UserControl x:Class="Horizon.UI.Views.MachinePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- Engine header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HORIZON" Foreground="{StaticResource Accent}"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="{StaticResource Panel}" CornerRadius="3" Padding="8,3" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Engine: " Foreground="{StaticResource Subtle}" />
                        <Run Text="{Binding EngineState, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding DeviceSummary, Mode=OneWay}"
                       Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="13" />

            <Button Grid.Column="2" Content="Reconnect" Width="100" Height="30"
                    Command="{Binding ReconnectCommand}" />
        </Grid>

        <!-- Section rail + section content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding CurrentSection}"
                     Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Text}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1" Content="{Binding CurrentSection}" Margin="10,0,0,0" />
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      Background="{StaticResource Panel}" Margin="0,4" />

        <!-- Global log -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,1" TextElement.Foreground="{Binding Color}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="Consolas"
                                       FontSize="11.5" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
