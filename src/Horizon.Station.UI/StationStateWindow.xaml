<Window x:Class="Horizon.Station.UI.StationStateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Horizon.Station.UI"
        Title="{x:Static ui:StationApp.Title}"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource PromptBg}">
    <Border x:Name="FrameBorder" BorderBrush="{StaticResource PromptEdge}" BorderThickness="3">
        <StackPanel Margin="30,24">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource PromptTitle}" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource PromptText}" FontSize="15"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- UP only: what was recorded when the station went down. -->
            <Border x:Name="DownInfo" Background="#26FFFFFF" CornerRadius="4" Padding="12,10" Margin="0,0,0,14"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DownInfoHeader" Foreground="{StaticResource PromptTitle}" FontSize="14"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DownInfoReason" Foreground="{StaticResource PromptText}" FontSize="15"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Engineer / technician name *" Foreground="{StaticResource PromptText}" FontSize="14" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Height="40" FontSize="19" VerticalContentAlignment="Center" Margin="0,0,0,12" />

            <!-- DOWN: category + reason. -->
            <StackPanel x:Name="DownFields">
                <TextBlock Text="Category" Foreground="{StaticResource PromptText}" FontSize="14" Margin="0,0,0,4" />
                <ComboBox x:Name="CategoryBox" Height="34" FontSize="15" IsEditable="True" Margin="0,0,0,12" />
                <TextBlock Text="Reason for down — what is wrong *" Foreground="{StaticResource PromptText}" FontSize="14" Margin="0,0,0,4" />
                <TextBox x:Name="ReasonBox" Height="80" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
            </StackPanel>

            <!-- UP: real root cause + troubleshooting action. -->
            <StackPanel x:Name="UpFields" Visibility="Collapsed">
                <TextBlock Text="Root cause — what was really wrong *" Foreground="{StaticResource PromptText}" FontSize="14" Margin="0,0,0,4" />
                <TextBox x:Name="RootCauseBox" Height="70" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                <TextBlock Text="Troubleshooting / action taken *" Foreground="{StaticResource PromptText}" FontSize="14" Margin="0,0,0,4" />
                <TextBox x:Name="ActionBox" Height="80" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FFCDD2" FontSize="14" Margin="0,4,0,4" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Width="138" Height="45" FontSize="18" Margin="0,0,12,0" IsCancel="True" />
                <Button x:Name="OkButton" Width="180" Height="45" FontSize="18" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
