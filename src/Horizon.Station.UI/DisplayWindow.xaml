<Window x:Class="Horizon.Station.UI.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Horizon.Station.UI.Views"
        Title="Horizon — Camera"
        Height="620" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Panel}">
    <Window.Resources>
        <!-- Cyan when MoveClick is armed (matches the Run page). -->
        <SolidColorBrush x:Key="MoveOn" Color="#00C8FF" />

        <Style x:Key="MoveToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource MoveOn}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MoveOn}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Crosshair line — yellow normally, cyan while MoveClick is armed. -->
        <Style x:Key="CrosshairLine" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource Crosshair}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=MoveToggle}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource MoveOn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedCamera}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Resolution}" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Fps}" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Live feed with center crosshair, hover cursor crosshair, and MoveClick. -->
        <Grid Grid.Row="1" x:Name="FeedHost" Background="{StaticResource VideoBg}"
              MouseLeftButtonDown="OnFeedClick" MouseMove="OnFeedMouseMove" MouseLeave="OnFeedMouseLeave">
            <Image x:Name="MainImage" Source="{Binding Frame}" Stretch="Uniform" Margin="2"
                   RenderOptions.BitmapScalingMode="LowQuality" />

            <!-- Center crosshair: full-span lines. -->
            <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Style="{StaticResource CrosshairLine}" />
            <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource CrosshairLine}" />

            <!-- Vision detection flash — mirrors the Run feed: a yellow line drawn briefly when a
                 vision profile detects a facet line on this window's camera (see ShowDetectedLine). -->
            <Canvas x:Name="DetectionOverlay" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Line x:Name="DetectedLine" Stroke="#FFFFD500" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed" />
            </Canvas>

            <!-- Device-registration overlay — mirrors the Run feed: live gripper centre + outline,
                 or an edge marker + arrow + distance when it is out of frame. -->
            <v:ToolOverlayView x:Name="ToolOverlay" />

            <!-- Short cursor crosshair — follows the mouse while MoveClick is armed. -->
            <Grid x:Name="MainCursor" Width="20" Height="20" IsHitTestVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="{StaticResource MoveOn}" />
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Fill="{StaticResource MoveOn}" />
            </Grid>

            <TextBlock Text="No video" Foreground="{StaticResource Subtle}" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoVideo, Converter={StaticResource BoolToVis}}" />

            <!-- Top-left: MoveClick toggle. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6">
                <ToggleButton x:Name="MoveToggle" Style="{StaticResource MoveToggle}" Content="MoveClick"
                              Unchecked="OnMoveDisarmed"
                              ToolTip="Click the image to measure (and jog) from the crosshair centre" />
            </StackPanel>

            <!-- Bottom-left: last MoveClick measurement. -->
            <Border x:Name="MoveReadoutBox" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="{StaticResource Overlay}" CornerRadius="3" Margin="6" Padding="8,3" Visibility="Collapsed">
                <TextBlock x:Name="MoveReadout" Foreground="{StaticResource Roi}" FontFamily="Consolas" FontSize="12.5" />
            </Border>

            <!-- Alignment capture/confirm prompt, mirrored from the Run page via the shared
                 CapturePromptHub. Topmost child so its Capture/Cancel buttons are clickable;
                 its centre is click-through so MoveClick still works underneath. -->
            <v:CameraPromptOverlay x:Name="PopoutPrompt" />
        </Grid>
    </Grid>
</Window>
