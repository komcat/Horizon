<Window x:Class="Horizon.Station.UI.DutResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DUT Results"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderText" Foreground="{StaticResource Accent}" FontSize="16"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Width="90" Height="28" Click="OnRefresh" />
        </Grid>

        <!-- Serial list -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Serials" Foreground="{StaticResource Subtle}"
                           FontSize="12" Margin="10,8,10,4" />
                <ListBox x:Name="SerialList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Text}" Margin="4"
                         SelectionChanged="OnSerialSelected" />
            </DockPanel>
        </Border>

        <!-- Runs for the selected serial -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="3">
            <DockPanel Margin="8">
                <TextBlock x:Name="RunsHeader" DockPanel.Dock="Top" Foreground="{StaticResource Text}"
                           FontSize="13" FontWeight="SemiBold" Margin="2,2,2,8" Text="Select a serial." />
                <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" Foreground="{StaticResource Text}"
                          BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="150" />
                        <DataGridTextColumn Header="Ended" Binding="{Binding Ended}" Width="150" />
                        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="80" />
                        <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="130" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                        <DataGridTextColumn Header="Machine" Binding="{Binding Station}" Width="120" />
                        <DataGridTextColumn Header="Credential" Binding="{Binding Credential}" Width="140" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn Header="Values" Binding="{Binding Values}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
