<UserControl x:Class="Horizon.Station.UI.Views.FilterRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="34" />
        </Style>
        <Style x:Key="SVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="34" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,4">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock x:Name="StageLabel" Foreground="{StaticResource Subtle}" FontSize="11"
                           VerticalAlignment="Center" Width="20" />
                <ComboBox x:Name="KindCombo" Width="140" Height="26" VerticalContentAlignment="Center"
                          SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Binary threshold" />
                    <ComboBoxItem Content="Gaussian" />
                    <ComboBoxItem Content="Canny edge" />
                </ComboBox>
            </StackPanel>

            <!-- Min/Max (binary threshold + Canny low/high) -->
            <StackPanel x:Name="ThresholdPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="MinLabel" Text="Min" Style="{StaticResource SLbl}" />
                    <Slider x:Name="MinSlider" Width="150" Minimum="0" Maximum="255" Value="0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                    <TextBlock Style="{StaticResource SVal}"
                               Text="{Binding Value, ElementName=MinSlider, StringFormat=0}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="MaxLabel" Text="Max" Style="{StaticResource SLbl}" />
                    <Slider x:Name="MaxSlider" Width="150" Minimum="0" Maximum="255" Value="128"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                    <TextBlock Style="{StaticResource SVal}"
                               Text="{Binding Value, ElementName=MaxSlider, StringFormat=0}" />
                </StackPanel>
            </StackPanel>

            <!-- Gaussian mask -->
            <StackPanel x:Name="GaussPanel" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                <TextBlock Text="Mask" Style="{StaticResource SLbl}" />
                <ComboBox x:Name="GaussMaskCombo" Width="56" Height="24" VerticalContentAlignment="Center"
                          SelectionChanged="OnComboChanged">
                    <ComboBoxItem Content="3" IsSelected="True" />
                    <ComboBoxItem Content="5" />
                </ComboBox>
            </StackPanel>

            <!-- Canny smoothing -->
            <StackPanel x:Name="AlphaPanel" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                <TextBlock Text="Alpha" Style="{StaticResource SLbl}" />
                <Slider x:Name="AlphaSlider" Width="150" Minimum="0.2" Maximum="5" Value="1"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnSliderChanged" />
                <TextBlock Style="{StaticResource SVal}"
                           Text="{Binding Value, ElementName=AlphaSlider, StringFormat=0.0}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
