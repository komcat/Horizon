<UserControl x:Class="Horizon.Station.UI.Views.Sections.CameraSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Camera picker -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Camera" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ListBox Style="{StaticResource DeviceSelector}" VerticalAlignment="Center" Margin="0,0,16,0"
                         ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" />
                <TextBlock Text="Connected" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Connected}" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Grab controls + stats -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Start" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding StartCommand}" />
                <Button Content="Stop" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding StopCommand}" />
                <Button Content="Snap" Width="64" Height="26" Margin="0,0,6,0" Command="{Binding SnapCommand}" />
                <Button Content="Pop out" Width="74" Height="26" Margin="0,0,16,0"
                        Command="{Binding PopOutCommand}" />
                <TextBlock Text="Grabbing" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Grabbing}" Foreground="{StaticResource Accent}"
                           Margin="6,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Resolution}" Foreground="{StaticResource Text}" FontFamily="Consolas"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Fps}" Foreground="{StaticResource Text}" FontFamily="Consolas"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="Frames" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FramesReceived}" Foreground="{StaticResource Text}" FontFamily="Consolas"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Exposure controls -->
        <Border Grid.Row="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exposure µs" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="80" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding ExposureUs}" />
                <TextBlock Text="Gain" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="56" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding Gain}" />
                <TextBlock Text="FPS" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="56" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding FrameRate}" />
                <CheckBox Content="Auto exposure" Foreground="{StaticResource Text}" VerticalAlignment="Center"
                          Margin="0,0,12,0" IsChecked="{Binding AutoExposure}" />
                <CheckBox Content="Auto gain" Foreground="{StaticResource Text}" VerticalAlignment="Center"
                          Margin="0,0,16,0" IsChecked="{Binding AutoGain}" />
                <Button Content="Apply" Width="64" Height="26" Margin="0,0,16,0"
                        Command="{Binding ApplyExposureCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Lighting: one row per light (group or ungrouped channel); RGB lights add colour call-outs -->
        <Border Grid.Row="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,8"
                DataContext="{Binding Lighting}"
                Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Lighting" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ListBox Style="{StaticResource DeviceSelector}" VerticalAlignment="Center" Margin="0,0,12,0"
                             ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Visibility="{Binding HasMultipleDevices, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Connected" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Connected}" Foreground="{StaticResource Text}" Margin="6,0,12,0" VerticalAlignment="Center" />
                    <Button Content="Connect" Width="74" Height="26" Margin="0,0,6,0" Command="{Binding ConnectCommand}" />
                    <Button Content="Disconnect" Width="80" Height="26" Margin="0,0,6,0" Command="{Binding DisconnectCommand}" />
                    <Button Content="All off" Width="64" Height="26" Margin="0,0,16,0" Command="{Binding AllOffCommand}" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding NoLightsText}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           Visibility="{Binding NoLightsForCamera, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Lights}"
                              IsEnabled="{Binding Connected}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <!-- Row 1: level -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="130" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <!-- The selected camera's own lights read in the accent colour. -->
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForSelectedCamera}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CameraLabel}" Foreground="{StaticResource Subtle}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCamera, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Slider Width="240" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                            Value="{Binding Percent}" />
                                    <TextBox Width="44" Margin="8,0,2,0" VerticalAlignment="Center"
                                             Text="{Binding Percent, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                                    <TextBlock Text="%" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="Off" Width="44" Height="24" Margin="0,0,4,0" Command="{Binding OffCommand}" />
                                    <Button Content="100%" Width="48" Height="24" Margin="0,0,12,0" Command="{Binding FullCommand}" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Row 2: colour call-outs (only those the light has channels for) -->
                                <StackPanel Orientation="Horizontal" Margin="130,4,0,2"
                                            Visibility="{Binding HasColors, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding HasRgb, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Red" Width="56" Height="24" Margin="0,0,4,0" Command="{Binding RedCommand}" />
                                        <Button Content="Green" Width="56" Height="24" Margin="0,0,4,0" Command="{Binding GreenCommand}" />
                                        <Button Content="Blue" Width="56" Height="24" Margin="0,0,4,0" Command="{Binding BlueCommand}" />
                                        <Button Content="White" Width="56" Height="24" Margin="0,0,4,0" Command="{Binding WhiteCommand}"
                                                ToolTip="Red + green + blue mixed" />
                                    </StackPanel>
                                    <Button Content="Collimate" Width="76" Height="24" Margin="0,0,4,0" Command="{Binding CollimateCommand}"
                                            Visibility="{Binding HasCollimate, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="White + Collimate" Width="120" Height="24" Margin="0,0,4,0"
                                            Command="{Binding WhiteCollimateCommand}"
                                            ToolTip="Collimate + red + green + blue together"
                                            Visibility="{Binding HasRgbAndCollimate, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Live preview -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Margin="0,0,0,0">
            <Grid>
                <TextBlock Text="No video — Start grabbing or open Pop out"
                           Foreground="{StaticResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoVideo, Converter={StaticResource BoolToVis}}" />
                <Image Source="{Binding Frame}" Stretch="Uniform" Margin="4"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="LowQuality" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
