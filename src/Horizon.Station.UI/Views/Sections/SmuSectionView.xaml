<UserControl x:Class="Horizon.Station.UI.Views.Sections.SmuSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsec="clr-namespace:Horizon.Station.UI.Views.Sections">
    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Device-level controls -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Device" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <ListBox Style="{StaticResource DeviceSelector}" Margin="8,0,16,0" VerticalAlignment="Center"
                         ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                <TextBlock Text="Interval ms" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="60" Margin="8,0,16,0" VerticalAlignment="Center" Text="{Binding IntervalMs}" />
                <TextBlock Text="Connected" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Connected}" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Per-channel control strips — one per channel, each streams independently -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                       Width="90" VerticalAlignment="Center" />
                            <Button Content="Start" Width="70" Height="26" Margin="0,0,6,0"
                                    Command="{Binding StartCommand}" />
                            <Button Content="Stop" Width="70" Height="26" Margin="0,0,16,0"
                                    Command="{Binding StopCommand}" />
                            <TextBlock Text="Streaming" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsStreaming}" Foreground="{StaticResource Text}"
                                       Margin="6,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Text="I" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LatestCurrent}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                       Margin="6,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Text="V" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LatestVoltage}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                       Margin="6,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Text="Samples" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SampleCount}" Foreground="{StaticResource Text}" FontFamily="Consolas"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One combined chart — a colour-coded current trace per channel.
             Fixed 300x200 for a predictable layout. -->
        <vsec:SmuChartView Grid.Row="2" Margin="0,8,0,0"
                           Width="300" Height="200"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />

    </Grid>
</UserControl>
