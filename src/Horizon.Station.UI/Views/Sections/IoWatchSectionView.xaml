<UserControl x:Class="Horizon.Station.UI.Views.Sections.IoWatchSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <!-- Pin state dot, driven by Tag (bool?): accent = on, filled edge = off,
             hollow = unknown (device disconnected / pin not resolvable). -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="{StaticResource Edge}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <DataTrigger.Value><sys:Boolean>True</sys:Boolean></DataTrigger.Value>
                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{StaticResource Subtle}" />
                    <Setter Property="ToolTip" Value="State unknown — device not connected or pin not found" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WatchGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="RowBackground" Value="{StaticResource Bg}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Panel}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Watcher state -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="IO watch" Foreground="{StaticResource Subtle}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WatchStatus}" Foreground="{StaticResource Text}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Safety watch" Foreground="{StaticResource Subtle}" Margin="0,4,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SafetyStatus}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SafetyFlagRaised}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- io_watch.json bindings -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Bindings (io_watch.json) — input edge drives output" Style="{StaticResource CardTitle}" />
                <DataGrid Grid.Row="1" Style="{StaticResource WatchGrid}" ItemsSource="{Binding Bindings}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                        <DataGridTemplateColumn Header="Input" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <Ellipse Style="{StaticResource StateDot}" Tag="{Binding InputOn}" />
                                        <TextBlock Text="{Binding Input}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Output" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <Ellipse Style="{StaticResource StateDot}" Tag="{Binding OutputOn}" />
                                        <TextBlock Text="{Binding Output}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Indicator (mirrors output)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <Ellipse Style="{StaticResource StateDot}" Tag="{Binding IndicatorOn}"
                                                 Visibility="{Binding HasIndicator, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Indicator}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="80" />
                        <DataGridTextColumn Header="Debounce ms" Binding="{Binding DebounceMs}" Width="100" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="70" />
                        <DataGridTextColumn Header="Last fired" Binding="{Binding LastFired}" Width="120"
                                            FontFamily="Consolas" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Safety-watched inputs | event log -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Safety-watched inputs" Style="{StaticResource CardTitle}" />
                    <DataGrid Grid.Row="1" Style="{StaticResource WatchGrid}" ItemsSource="{Binding WatchedInputs}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Style="{StaticResource StateDot}" Tag="{Binding IsOn}" Margin="8,0" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*" />
                            <DataGridTextColumn Header="Pin" Binding="{Binding Pin}" Width="*" />
                            <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerEdge}" Width="80" />
                            <DataGridTextColumn Header="Critical" Binding="{Binding Critical}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Events (newest first)" Style="{StaticResource CardTitle}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" BorderThickness="0"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                             FontFamily="Consolas" Padding="6,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
