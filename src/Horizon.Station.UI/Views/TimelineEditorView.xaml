<UserControl x:Class="Horizon.Station.UI.Views.TimelineEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Horizon.Station.UI.ViewModels"
             xmlns:tl="clr-namespace:Horizon.Station.UI.ViewModels.Timeline"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectedBlock" Color="#00C8FF" />
        <!-- Translucent tint shown on the lane cell a dragged block would drop into. -->
        <SolidColorBrush x:Key="DropHighlight" Color="#3300C8FF" />
        <!-- Conditional-branch stage tints: then-branch (If→Else) pink, else-branch (Else→End If) yellow.
             Translucent so they read as a light wash over either theme. -->
        <SolidColorBrush x:Key="ThenRegion" Color="#33E91E63" />
        <SolidColorBrush x:Key="ElseRegion" Color="#33FFC400" />

        <!-- Port dots: where arrows leave (out) and arrive (in). Invisible until the
             pointer is over the node, or (in ports) while an arrow is being dragged. -->
        <SolidColorBrush x:Key="InPort" Color="#2F9E8F" />
        <SolidColorBrush x:Key="OutPort" Color="#F2994A" />
        <Style x:Key="PortDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stroke" Value="{StaticResource Bg}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InPortDot" TargetType="Ellipse" BasedOn="{StaticResource PortDot}">
            <Setter Property="Fill" Value="{StaticResource InPort}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsConnecting, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutPortDot" TargetType="Ellipse" BasedOn="{StaticResource PortDot}">
            <Setter Property="Fill" Value="{StaticResource OutPort}" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="ToolTip" Value="Drag to the next block to draw the arrow" />
        </Style>

        <!-- A command block node on the canvas — border colours by run status / selection,
             background by If / Else branch, faded when no arrow from Start reaches it. -->
        <Style x:Key="NodeBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Region}" Value="Then">
                    <Setter Property="Background" Value="{StaticResource ThenRegion}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Region}" Value="Else">
                    <Setter Property="Background" Value="{StaticResource ElseRegion}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Block.RunStatus}" Value="Running">
                    <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Block.RunStatus}" Value="Passed">
                    <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Block.RunStatus}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBlock}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Block.Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOrphan}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A parallel envelope — one node whose branches run at the same time. -->
        <Style x:Key="ParallelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6,8,8" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatus}" Value="Running">
                    <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Passed">
                    <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBlock}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DropHighlight}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOrphan}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Arrow between two nodes. -->
        <Style x:Key="LinkStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Text}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource SelectedBlock}" />
                    <Setter Property="StrokeThickness" Value="2.6" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkHead" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Text}" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SelectedBlock}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Palette command tile — drag onto the canvas, or double-click to add after the selected block. -->
        <Style x:Key="PaletteItem" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A block inside a parallel envelope — border colours by run status / selection. -->
        <Style x:Key="BlockBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatus}" Value="Running">
                    <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Passed">
                    <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBlock}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Typed parameter field templates + selector (shared with the param panel). -->
        <DataTemplate x:Key="TextParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NumberParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalContentAlignment="Right" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BoolParam">
            <CheckBox Content="{Binding Label}" Foreground="{StaticResource Text}"
                      Margin="0,2,0,8" IsChecked="{Binding BoolValue}" />
        </DataTemplate>
        <DataTemplate x:Key="ComboParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Options}" IsEditable="True" DropDownOpened="OnParamDropDownOpened"
                              Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Pinned position pickers only (align.* points on gantry-main). -->
                    <Button Grid.Column="1" Content="Go" Margin="4,0,0,0" Padding="8,0" MinWidth="36"
                            Command="{Binding GoCommand}"
                            Visibility="{Binding HasPositionActions, Converter={StaticResource BoolToVis}}"
                            ToolTip="Move the device to this position" />
                    <Button Grid.Column="2" Content="Teach here" Margin="4,0,0,0" Padding="8,0"
                            Command="{Binding TeachCommand}"
                            Visibility="{Binding HasPositionActions, Converter={StaticResource BoolToVis}}"
                            ToolTip="Save the device's current position under this name (asks first)" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <vm:ParamTemplateSelector x:Key="ParamSelector"
                                  Text="{StaticResource TextParam}"
                                  Number="{StaticResource NumberParam}"
                                  Bool="{StaticResource BoolParam}"
                                  Combo="{StaticResource ComboParam}" />
        <!-- ===== canvas node templates ===== -->
        <DataTemplate x:Key="StartNode">
            <Grid Background="Transparent" SizeChanged="OnNodeSizeChanged" MouseLeftButtonDown="OnNodeMouseDown">
                <Border Width="96" Height="34" CornerRadius="17" Background="{StaticResource Accent}" Cursor="SizeAll"
                        ToolTip="Every program starts here — drag from the orange dot to the first block">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBlock}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="START" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Border>
                <Ellipse Style="{StaticResource OutPortDot}" Tag="B" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,-6" MouseLeftButtonDown="OnOutPortMouseDown" />
                <Ellipse Style="{StaticResource OutPortDot}" Tag="R" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-6,0" MouseLeftButtonDown="OnOutPortMouseDown" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BlockNode">
            <Grid Background="Transparent" SizeChanged="OnNodeSizeChanged" MouseLeftButtonDown="OnNodeMouseDown">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove outgoing arrow" Click="OnDisconnectNode" />
                        <Separator />
                        <MenuItem Header="Copy" Click="OnCopyNode" />
                        <MenuItem Header="Paste after" Click="OnPasteAfterNode" />
                        <Separator />
                        <MenuItem Header="Delete block" Click="OnRemoveNode" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border Style="{StaticResource NodeBox}" Width="180" MinHeight="48" ToolTip="{Binding Block.Summary}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Ordinal}" Foreground="{StaticResource Accent}"
                                       FontSize="9.5" FontWeight="Bold" Margin="0,0,5,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Block.SelectedDevice}" Foreground="{StaticResource Subtle}"
                                       FontSize="9.5" Margin="6,0,0,0" MaxWidth="80" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Block.ShowDevice, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Block.Display}" Foreground="{StaticResource Subtle}" FontSize="9.5"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Block.ParamSummary}" Foreground="{StaticResource Text}" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Ellipse Style="{StaticResource InPortDot}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" />
                <Ellipse Style="{StaticResource InPortDot}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" />
                <Ellipse Style="{StaticResource OutPortDot}" Tag="B" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,-6" MouseLeftButtonDown="OnOutPortMouseDown" />
                <Ellipse Style="{StaticResource OutPortDot}" Tag="R" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-6,0" MouseLeftButtonDown="OnOutPortMouseDown" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ParallelNode">
            <Grid Background="Transparent" SizeChanged="OnNodeSizeChanged" MouseLeftButtonDown="OnNodeMouseDown">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove outgoing arrow" Click="OnDisconnectNode" />
                        <Separator />
                        <MenuItem Header="Copy" Click="OnCopyNode" />
                        <MenuItem Header="Paste after" Click="OnPasteAfterNode" />
                        <Separator />
                        <MenuItem Header="Delete parallel group" Click="OnRemoveNode" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border Style="{StaticResource ParallelBox}"
                        ToolTip="Parallel group — its branches run at the same time; the next block starts when all have finished">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Delete this parallel group" Click="OnRemoveNode" />
                            <TextBlock Text="{Binding Ordinal}" Foreground="{StaticResource Accent}" FontSize="9.5" FontWeight="Bold"
                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="PARALLEL" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Drag commands or blocks here" Foreground="{StaticResource Subtle}" FontSize="11"
                                   FontStyle="Italic" Margin="4,8,4,10" HorizontalAlignment="Center"
                                   Visibility="{Binding HasNoBranches, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Branches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                            CornerRadius="3" Margin="0,0,6,0" Padding="2,2,2,4" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource Subtle}" FontSize="9.5"
                                                       FontWeight="SemiBold" Margin="5,1,5,2" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource BlockBox}" Width="160" Background="{StaticResource Bg}"
                                                                MouseLeftButtonDown="OnInnerBlockMouseDown" ToolTip="{Binding Summary}">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Move out of the parallel group" Click="OnMoveOutBlock" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource Subtle}"
                                                                           FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ParamSummary}" Foreground="{StaticResource Text}"
                                                                           FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Ellipse Style="{StaticResource InPortDot}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" />
                <Ellipse Style="{StaticResource InPortDot}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" />
                <Ellipse Style="{StaticResource OutPortDot}" Tag="B" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,-6" MouseLeftButtonDown="OnOutPortMouseDown" />
                <Ellipse Style="{StaticResource OutPortDot}" Tag="R" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-6,0" MouseLeftButtonDown="OnOutPortMouseDown" />
            </Grid>
        </DataTemplate>

        <tl:CanvasNodeTemplateSelector x:Key="NodeSelector"
                                       Start="{StaticResource StartNode}"
                                       Block="{StaticResource BlockNode}"
                                       Parallel="{StaticResource ParallelNode}" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Program" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="180" Margin="8,0,8,0" VerticalAlignment="Center"
                         Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="3" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip="Latest committed version of this program (Commit to bump it)">
                    <TextBlock Text="{Binding CurrentVersionText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                </Border>
                <Button Width="70" Height="28" Margin="0,0,12,0" Click="OnLoad" ToolTip="Choose a program to load from the product">
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </Button>
                <Button Width="70" Height="28" Margin="0,0,6,0" Command="{Binding NewProgramCommand}" ToolTip="New program">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/new-file.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="New" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="70" Height="28" Margin="0,0,6,0" Command="{Binding SaveProgramCommand}"
                        ToolTip="Save the working program file (does not create a version)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/save-file.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBox Width="150" Height="28" Margin="0,0,6,0" VerticalContentAlignment="Center"
                         Text="{Binding CommitNote, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Optional note for the next commit (shows in the version repository)" />
                <Button Width="80" Height="28" Margin="0,0,16,0" Command="{Binding CommitProgramCommand}"
                        ToolTip="Save and record a new numbered version in the repository">
                    <TextBlock Text="Commit" VerticalAlignment="Center" />
                </Button>
                <Button Width="80" Height="28" Margin="0,0,16,0" Click="OnHistory" ToolTip="Program history">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/history-button.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="History" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="92" Height="28" Margin="0,0,16,0" Command="{Binding AddParallelCommand}"
                        ToolTip="Add a parallel group after the selected block — the commands inside it run at the same time">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/add-stage-button.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Parallel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="72" Height="28" Margin="0,0,6,0" FontWeight="SemiBold" Command="{Binding RunCommand}" ToolTip="Run program">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/run-button.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Run" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="116" Height="28" Margin="0,0,6,0" Command="{Binding RunSelectedCommand}"
                        ToolTip="Run only the selected block (or the selected parallel group)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/run-stage-button.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Run Selected" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="72" Height="28" Command="{Binding StopCommand}" ToolTip="Stop">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Horizon.Station.UI;component/assets/stop-button.png" Width="16" Height="16" Margin="0,0,5,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Canvas view controls: zoom + tidy. -->
                <Border Width="1" Background="{StaticResource Edge}" Margin="14,2,14,2" />
                <Button Content="−" Width="28" Height="28" Margin="0,0,4,0" FontWeight="Bold" Command="{Binding ZoomOutCommand}"
                        ToolTip="Zoom out (Ctrl + mouse wheel)" />
                <Button Content="+" Width="28" Height="28" Margin="0,0,10,0" FontWeight="Bold" Command="{Binding ZoomInCommand}"
                        ToolTip="Zoom in (Ctrl + mouse wheel)" />
                <Button Content="Tidy" Width="52" Height="28" Command="{Binding TidyCommand}"
                        ToolTip="Re-arrange the canvas: the sequence top to bottom, one block per stage row" />

                <TextBlock Text="●  unsaved changes" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- ===== FOUR COLUMNS: programs | palette | canvas | param panel ===== -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- FAR LEFT: the product's programs — search, click to open, eye to hide/show.
                 Hidden programs (per product, faam_hidden_programs.json) are left out unless
                 "Show hidden" is on, then listed dimmed. The open program is bold. -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Programs" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" Margin="2,2,0,8" />
                    <TextBox DockPanel.Dock="Top" Height="24" Margin="0,0,0,6" VerticalContentAlignment="Center"
                             Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search programs — every word must appear in the name" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Left" Content="Show hidden" Foreground="{StaticResource Text}"
                                  FontSize="11" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowHiddenPrograms}"
                                  ToolTip="Off: only visible programs. On: every program, hidden ones dimmed." />
                        <TextBlock Text="{Binding ProgramListSummary}" Foreground="{StaticResource Subtle}" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ListBox x:Name="ProgramListBox" ItemsSource="{Binding ProgramList}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnProgramItemClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="22" Height="20" Padding="0" Margin="4,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding ToggleHiddenCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="👁" />
                                                <Setter Property="ToolTip" Value="Hide this program from the list" />
                                                <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Content" Value="⊘" />
                                                        <Setter Property="ToolTip" Value="Hidden — click to show it again" />
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- LEFT: command palette -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,4,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Commands" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" Margin="2,2,0,8" />
                    <TextBox DockPanel.Dock="Top" Height="24" Margin="0,0,0,8" VerticalContentAlignment="Center"
                             Text="{Binding CommandFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search commands by name, op key or category (e.g. psu, snapshot, move)" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Subtle}"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PaletteItem}"
                                                            ToolTip="Drag onto the canvas (or into a parallel group), or double-click to add after the selected block"
                                                            PreviewMouseLeftButtonDown="OnPaletteMouseDown"
                                                            PreviewMouseMove="OnPaletteMouseMove">
                                                        <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MIDDLE: the free canvas. Numbered stage rows (dashed lines) are a layout grid —
                 a row grows to fit what sits in it; there are no lane columns. Execution order
                 is the chain of arrows from START. Layers, back to front: rows, arrows, the
                 arrow being dragged, nodes. -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,4,0">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource Bg}" PreviewMouseWheel="OnCanvasWheel">
                    <Grid x:Name="CanvasRoot" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Bg}"
                          AllowDrop="True" DragOver="OnCanvasDragOver" DragLeave="OnCanvasDragLeave" Drop="OnCanvasDrop"
                          MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove"
                          MouseLeftButtonUp="OnCanvasMouseUp" LostMouseCapture="OnCanvasLostCapture">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        </Grid.LayoutTransform>

                        <!-- Stage rows -->
                        <ItemsControl ItemsSource="{Binding Rows}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{Binding Height}"
                                          Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" FontSize="13"
                                                   FontWeight="SemiBold" Margin="10,8,0,0" Opacity="0.8" />
                                        <Line X1="0" Y1="0" Y2="0" VerticalAlignment="Bottom"
                                              X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                              Stroke="{StaticResource Subtle}" StrokeThickness="1" StrokeDashArray="5 4" Opacity="0.55" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Arrows -->
                        <ItemsControl ItemsSource="{Binding Links}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Path Data="{Binding Data}" Stroke="Transparent" StrokeThickness="12" Cursor="Hand"
                                              MouseLeftButtonDown="OnLinkMouseDown"
                                              ToolTip="Click to select, then Delete to remove this arrow" />
                                        <Path Data="{Binding Data}" Style="{StaticResource LinkStroke}" />
                                        <Path Data="{Binding Head}" Style="{StaticResource LinkHead}" />
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The arrow being dragged out of a port -->
                        <Canvas IsHitTestVisible="False">
                            <Path x:Name="RubberBand" Stroke="{StaticResource OutPort}" StrokeThickness="2"
                                  StrokeDashArray="4 3" Visibility="Collapsed" />
                        </Canvas>

                        <!-- Nodes -->
                        <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplateSelector="{StaticResource NodeSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: parameter panel for the selected block -->
            <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,0,0">
                <Grid>
                    <!-- Empty state — nothing selected. -->
                    <TextBlock Text="Select a block to edit, or click a command for help"
                               Foreground="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"
                               Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}" />

                    <!-- Command help — shown when a palette command is clicked (no block selected). -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowPaletteHelp, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12" DataContext="{Binding SelectedHelp}">
                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Category, StringFormat='{}{0} command'}"
                                       Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,1,0,10" />

                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Text}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="HOW TO USE" Foreground="{StaticResource Subtle}" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,0,0,3"
                                       Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Usage}" Foreground="{StaticResource Text}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="PARAMETERS" Foreground="{StaticResource Subtle}" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                       Visibility="{Binding HasParams, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding ParamLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,7">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}"
                                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Subtle}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                <TextBlock Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                                           Text="Double-click this command to add it after the selected block, or drag it onto the canvas." />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Parameter editor — shown when a placed block is selected. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedBlock, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12" DataContext="{Binding SelectedBlock}">
                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding HelpSummary}" Foreground="{StaticResource Subtle}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasHelp, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Id, StringFormat='UID  {0}'}" Foreground="{StaticResource Subtle}"
                                           FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                           ToolTip="{Binding Id}" VerticalAlignment="Center" />
                                <Button Content="Copy" Width="40" Height="20" Padding="0" FontSize="9" Margin="6,0,0,0"
                                        Click="OnCopyUid" ToolTip="Copy this block's UID" />
                                <Button Content="Query" Width="46" Height="20" Padding="0" FontSize="9" Margin="4,0,0,0"
                                        Click="OnQueryUid" ToolTip="Open History → Query, filtered to this UID" />
                            </StackPanel>

                            <TextBlock Text="Name (optional)" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Visibility="{Binding ShowDevice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Device" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                                <ComboBox Margin="0,0,0,8" ItemsSource="{Binding DeviceOptions}"
                                          SelectedItem="{Binding SelectedDevice}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Params}"
                                          ItemTemplateSelector="{StaticResource ParamSelector}" />

                            <TextBlock Text="{Binding VelocityHint}" Foreground="{StaticResource Subtle}"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,-2,0,10"
                                       Visibility="{Binding ShowVelocityHint, Converter={StaticResource BoolToVis}}" />

                            <Border Visibility="{Binding HasPositionPreview, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,2,0,10">
                                <StackPanel>
                                    <TextBlock Text="Position stored default (used when an override above is 0 / blank)"
                                               Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PositionPreview}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <Button Content="Edit position…" Width="110" Height="26" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Command="{Binding EditPositionCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Register Gripped Object: the optional outline snapshot's filters. -->
                            <Border Visibility="{Binding IsRegisterObject, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,2,0,10">
                                <StackPanel>
                                    <TextBlock Text="Outline filters (stored in this block)" Foreground="{StaticResource Subtle}"
                                               FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OutlineFiltersText}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <Button Content="Outline helper…" Width="120" Height="26" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Command="{Binding OutlineHelperCommand}"
                                            ToolTip="Set the box around the crosshair and the filters, preview the yellow overlay on the live view, then save it to this block" />
                                </StackPanel>
                            </Border>

                            <!-- Detect Object: the block's own camera position + vision recipe. -->
                            <Border Visibility="{Binding IsDetectObject, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,2,0,10">
                                <StackPanel>
                                    <TextBlock Text="Camera position (stored in this block, not in the product's positions)"
                                               Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetectPositionText}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Go" MinWidth="44" Height="26" Padding="8,0"
                                                Command="{Binding DetectGoCommand}"
                                                ToolTip="Move the camera to this block's stored position" />
                                        <Button Content="Teach here" Height="26" Padding="8,0" Margin="4,0,0,0"
                                                Command="{Binding DetectTeachCommand}"
                                                ToolTip="Store the camera's current X / Y / Z in this block (asks first)" />
                                        <Button Content="Clear" Height="26" Padding="8,0" Margin="4,0,0,0"
                                                Command="{Binding DetectClearCommand}"
                                                ToolTip="Forget the stored position — the block then detects where the camera is" />
                                    </StackPanel>

                                    <TextBlock Text="Vision recipe (stored in this block)" Foreground="{StaticResource Subtle}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding DetectRecipeText}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <Button Content="Vision helper…" Width="120" Height="26" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Command="{Binding VisionHelperCommand}"
                                            ToolTip="Set up camera, filters, method and template, test the detection, then save it to this block" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Inbound delay (ms)" Foreground="{StaticResource Subtle}" Margin="0,4,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding DelayBeforeMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Debounce delay (ms)" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Enabled" Foreground="{StaticResource Text}" IsChecked="{Binding Enabled}" />

                            <Button Content="Delete block" Width="110" Height="28" HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== LOG ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Height="140">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,4">
                    <TextBlock Text="Log" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="CopyLogButton" Content="Copy" FontSize="10.5" Padding="6,0" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="OnCopyLog"
                            ToolTip="Copy the whole log to the clipboard" />
                </StackPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource Text}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
