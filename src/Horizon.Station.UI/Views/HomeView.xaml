<UserControl x:Class="Horizon.Station.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Big launcher tile — the shared raised 3D button, scaled up. -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Bevel3D}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Product bar — pick/create the active product. Programs and positions are
             product-scoped and switch together. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="10,10,10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Product" Foreground="{StaticResource Subtle}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="ProductCombo" Width="240" Height="30" FontSize="14"
                          IsEditable="True" VerticalContentAlignment="Center" />
                <Button x:Name="OpenButton" Content="Open / Create" Width="130" Height="30"
                        Margin="10,0,0,0" Click="OnOpenProduct" />
                <Button x:Name="SaveAsButton" Content="Save As…" Width="100" Height="30"
                        Margin="6,0,0,0" Click="OnSaveAsProduct"
                        ToolTip="Clone the active product (positions, vision, programs/decks) as a new variation" />
                <TextBlock x:Name="ActiveProductText" Foreground="{StaticResource Text}" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Launcher: a fixed 4 × 4 grid. Only the screens the signed-in level may open are
             shown (ApplyAccess collapses the rest, see AccessPolicy) — UniformGrid skips
             collapsed tiles, so the available ones pack from the top-left and every tile
             keeps a quarter of the width and height. Add a new screen as another Button here. -->
        <Grid Grid.Row="1">
            <UniformGrid x:Name="TileGrid" Rows="4" Columns="4">
                <Button x:Name="RunTile" Content="RUN"
                        Style="{StaticResource Tile}" Click="OnRunClick" />
                <Button x:Name="EngineerTile" Content="Engineer"
                        Style="{StaticResource Tile}" Click="OnEngineerClick" />
                <Button x:Name="MachineTile" Content="Machine"
                        Style="{StaticResource Tile}" Click="OnMachineClick" />
                <Button x:Name="VisionAlignmentTile" Content="Vision Alignment"
                        Style="{StaticResource Tile}" Click="OnVisionAlignmentClick"
                        ToolTip="Vision profiles (per-position recipes) and the gripped FAU teach, in one page" />
                <Button x:Name="ScriptTile" Content="Script"
                        Style="{StaticResource Tile}" Click="OnScriptClick" />
                <Button x:Name="CalibrationTile" Content="Calibration"
                        Style="{StaticResource Tile}" Click="OnCalibrationClick" />
                <Button x:Name="RepositoryTile" Content="Repository"
                        Style="{StaticResource Tile}" Click="OnRepositoryClick"
                        ToolTip="Browse program / deck versions and checkout an earlier one" />
                <Button x:Name="DutDataTile" Content="DUT Data"
                        Style="{StaticResource Tile}" Click="OnDutDataClick"
                        ToolTip="Per-serial DUT data: UV signal snapshots and labelled SiPhOG snapshots, with charts and CSV export" />
                <Button x:Name="OeeTile" Content="OEE"
                        Style="{StaticResource Tile}" Click="OnOeeClick"
                        ToolTip="Station uptime, utilization and downtime per 24 h day — running / standby / idle / down / offline" />
                <Button x:Name="VersionTile" Style="{StaticResource Tile}" Click="OnVersionClick"
                        ToolTip="This build's version and git id, and the release history">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Version" HorizontalAlignment="Center" />
                        <TextBlock x:Name="VersionTileText" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource Subtle}" FontFamily="Consolas" />
                    </StackPanel>
                </Button>
            </UniformGrid>
            <!-- Shown when no screen is available (signed out). -->
            <TextBlock x:Name="NoTilesText" Text="Sign in to use this station."
                       Foreground="{StaticResource Subtle}" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
