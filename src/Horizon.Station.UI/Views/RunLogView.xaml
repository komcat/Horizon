<!-- The Run page's log box: the engine log, newest last, following live while the page is shown. -->
<UserControl x:Class="Horizon.Station.UI.Views.RunLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log" Foreground="{StaticResource Subtle}" FontSize="11"
                       FontWeight="SemiBold" Margin="8,5,0,2" />
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True"
                     Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11.5"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Margin="6,0,2,4" />
        </Grid>
    </Border>
</UserControl>
