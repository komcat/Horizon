<UserControl x:Class="Horizon.Station.UI.Views.JogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sec="clr-namespace:Horizon.Station.UI.Views.Sections">
    <UserControl.Resources>
        <!-- Jog direction button — press-and-hold to jog, release to stop. -->
        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="Click" Handler="OnJog" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step-size preset — small selectable chip; accent when active. -->
        <Style x:Key="StepBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- θ step-size preset — like StepBtn but larger font (U/V/W rotational steps). -->
        <Style x:Key="ThetaStepBtn" TargetType="ToggleButton" BasedOn="{StaticResource StepBtn}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Velocity preset — selectable; accent when active. -->
        <Style x:Key="VelBtn" TargetType="ToggleButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4">
        <!-- RootStack's direct children are what SetLocked disables when nobody is signed
             in — all except StopButton, which stays live at every level. -->
        <StackPanel x:Name="RootStack" Margin="8">
            <!-- Header: title + keyboard-jog enable toggle (hotkey: ` grave accent). -->
            <Grid Margin="2,0,0,6">
                <TextBlock Text="JOG" Foreground="{StaticResource Subtle}" FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="KeysToggle" Content="⌨ Keys (`)" Click="OnToggleKeys"
                              HorizontalAlignment="Right" FontSize="11" Padding="6,2" Cursor="Hand"
                              ToolTip="Toggle keyboard jog (hotkey: ` ).&#x0a;A/D = X-/X+   W/S = Y-/Y+   R/F = Z+/Z- (R above F = Z+ above Z-)&#x0a;Q/E = step finer/coarser   Tab = next device" />
            </Grid>

            <!-- STOP — halts all motion. -->
            <Button x:Name="StopButton" Click="OnStop" Height="36" Margin="0,0,0,8" ToolTip="STOP — halt all motion"
                    Background="{StaticResource Danger}" BorderThickness="0" Cursor="Hand">
                <Image Source="/assets/stop.png" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>

            <!-- Connected motion devices (single-select) — two across. -->
            <UniformGrid x:Name="DeviceList" Columns="2" />

            <!-- Live position readout for the selected device. -->
            <Border Margin="0,8,0,0" Background="Black" CornerRadius="3" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="12.5" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#2E9E2E" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Foreground="#2E9E2E" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" Foreground="#2E9E2E" />
                    <TextBlock x:Name="PosX" Grid.Row="0" Grid.Column="1" Text="—" Foreground="#33FF33" TextAlignment="Right" />
                    <TextBlock x:Name="PosY" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#33FF33" TextAlignment="Right" />
                    <TextBlock x:Name="PosZ" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#33FF33" TextAlignment="Right" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="U" Foreground="#2E9E2E" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="V" Foreground="#2E9E2E" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="W" Foreground="#2E9E2E" />
                    <TextBlock x:Name="PosU" Grid.Row="0" Grid.Column="4" Text="—" Foreground="#33FF33" TextAlignment="Right" />
                    <TextBlock x:Name="PosV" Grid.Row="1" Grid.Column="4" Text="—" Foreground="#33FF33" TextAlignment="Right" />
                    <TextBlock x:Name="PosW" Grid.Row="2" Grid.Column="4" Text="—" Foreground="#33FF33" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- ===================== JOG / MOVE MAP tabs ===================== -->
            <TabControl x:Name="JogTabs" Margin="0,8,0,0" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource Edge}" SelectionChanged="OnJogTabChanged">
            <TabItem Header="Jog">
            <StackPanel Margin="2">
            <!-- Step-size quick presets — set the linear X/Y/Z jog step (highlight tracks the current step).
                 Rows auto-size to the per-family step count (5 across). -->
            <TextBlock Text="Step presets" Foreground="{StaticResource Subtle}" FontSize="11" Margin="2,4,0,2" />
            <UniformGrid x:Name="StepPresetList" Columns="5" />

            <!-- Step size — large readout; changed with Q (finer) / E (coarser) or the mouse wheel. -->
            <TextBlock Text="Step  (Q finer · E coarser · scroll)" Foreground="{StaticResource Subtle}" FontSize="11" Margin="2,8,0,2" />
            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Cursor="Hand" MouseWheel="OnStepWheel"
                    MouseLeftButtonDown="OnStepCoarser" MouseRightButtonDown="OnStepFiner"
                    ToolTip="Left-click / scroll up = coarser · right-click / scroll down = finer · keys Q / E">
                <TextBlock x:Name="StepDisplay" Text="10µm" Foreground="{StaticResource Text}"
                           FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="0,4" />
            </Border>

            <!-- X / Y / Z jog pad. -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Content="Y- (W)" Tag="Y-" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="0" Grid.Column="4" Content="Z+ (R)" Tag="Z+" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="0" Content="X- (A)" Tag="X-" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="1" Content="Y+ (S)" Tag="Y+" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="2" Content="X+ (D)" Tag="X+" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="4" Content="Z- (F)" Tag="Z-" Style="{StaticResource JogBtn}" />
            </Grid>

            <!-- θ (U/V/W) step presets (left) + U / V / W jog (right). -->
            <TextBlock Text="θ Step  (U / V / W)" Foreground="{StaticResource Subtle}" FontSize="11" Margin="2,10,0,2" />
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <!-- Trailing spacer: shrinks the U/V/W jog buttons to ~75% of the row. -->
                    <ColumnDefinition Width="0.66*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- θ step-size presets (degrees), used only for U/V/W jogs. -->
                <StackPanel x:Name="ThetaStepList" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                            VerticalAlignment="Center" />

                <Button Grid.Row="0" Grid.Column="2" Content="U-" Tag="U-" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="0" Grid.Column="3" Content="U+" Tag="U+" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="2" Content="V-" Tag="V-" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="1" Grid.Column="3" Content="V+" Tag="V+" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="2" Grid.Column="2" Content="W-" Tag="W-" Style="{StaticResource JogBtn}" />
                <Button Grid.Row="2" Grid.Column="3" Content="W+" Tag="W+" Style="{StaticResource JogBtn}" />
            </Grid>
            </StackPanel>
            </TabItem>

            <!-- Move map: the selected device's Machine › Motion position map, view-only here
                 (click a node, then Move). Arranging / linking stays on the Machine page. -->
            <TabItem x:Name="MapTab" Header="Move map">
                <sec:PositionMapView x:Name="MapView" Compact="True" Height="440" Margin="2" />
            </TabItem>
            </TabControl>

            <!-- Velocity (speed) for the selected device — applied immediately on select; flash confirms. -->
            <TextBlock Text="Velocity (mm/s)" Foreground="{StaticResource Subtle}" FontSize="11" Margin="2,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="VelocityCombo" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                          FontSize="14" SelectionChanged="OnVelocityCombo"
                          ToolTip="Select a speed — applied to the selected device immediately." />
                <TextBlock x:Name="VelFlash" Grid.Column="1" Text="" Foreground="#2E9E2E" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,2,0" Opacity="0" />
            </Grid>

            <TextBlock x:Name="JogStatus" Foreground="{StaticResource Subtle}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,8,0,0" />

            <!-- ===================== CAMERA / LIGHTING tabs ===================== -->
            <TabControl x:Name="CamLightTabs" Margin="0,12,0,0" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource Edge}" SelectionChanged="OnCamLightTabChanged">
            <TabItem Header="Camera">
                <StackPanel Margin="4">
                    <!-- Camera selector: exposure controls drive the chosen camera
                         (the Lighting tab shows this camera's lights). -->
                    <ComboBox x:Name="CameraSelect" Height="26" VerticalContentAlignment="Center"
                              Margin="0,0,0,6" SelectionChanged="OnCameraChanged" />

                    <!-- Manual exposure entry + apply. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Exposure µs" Foreground="{StaticResource Subtle}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ExposureBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                 KeyDown="OnExposureKeyDown" />
                        <Button x:Name="ExposureApply" Grid.Column="2" Content="Apply" Width="56" Height="26"
                                Margin="6,0,0,0" Cursor="Hand" Click="OnApplyExposure" />
                    </Grid>

                    <!-- Auto-exposure on/off. -->
                    <ToggleButton x:Name="AutoExposureToggle" Style="{StaticResource VelBtn}"
                                  Margin="0,6,0,0" Content="Auto-exposure: —" Click="OnToggleAutoExposure" />

                    <!-- Presets: left-click to apply, right-click to set + save. -->
                    <TextBlock Text="Presets  (right-click to set)" Foreground="{StaticResource Subtle}"
                               FontSize="11" Margin="0,8,0,4" />
                    <UniformGrid x:Name="ExposurePresetList" Columns="2" />

                    <TextBlock x:Name="CamStatus" Foreground="{StaticResource Subtle}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Lighting: same view-model as Machine › Camera, laid out for the narrow rail.
                 DataContext (LightingPanelViewModel) is set in Attach. -->
            <TabItem x:Name="LightingTab" Header="Lighting">
                <Grid x:Name="LightingRoot" Margin="4">
                    <TextBlock x:Name="LightingNone" Text="No lighting controller configured."
                               Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel x:Name="LightingBody" Visibility="Collapsed">
                        <ListBox Style="{StaticResource DeviceSelector}" Margin="0,0,0,6"
                                 ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 Visibility="{Binding HasMultipleDevices, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Connected" Foreground="{StaticResource Subtle}" FontSize="11" />
                            <TextBlock Text="{Binding Connected}" Foreground="{StaticResource Text}" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <Button Content="Connect" Height="26" Margin="2" Command="{Binding ConnectCommand}" />
                            <Button Content="Disconnect" Height="26" Margin="2" Command="{Binding DisconnectCommand}" />
                            <Button Content="All off" Height="26" Margin="2" Command="{Binding AllOffCommand}" />
                        </UniformGrid>

                        <TextBlock Text="{Binding Camera, StringFormat='All lights · {0} first'}" Foreground="{StaticResource Subtle}"
                                   FontSize="11" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding NoLightsText}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding NoLightsForCamera, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Lights}" IsEnabled="{Binding Connected}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,4" Margin="0,2">
                                        <StackPanel>
                                            <!-- Name + live read-out -->
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <!-- The rail camera's own lights read in the accent colour. -->
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsForSelectedCamera}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CameraLabel}" Foreground="{StaticResource Subtle}" FontSize="10"
                                                               Visibility="{Binding HasCamera, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            </Grid>

                                            <!-- Level -->
                                            <Slider Margin="0,4,0,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                                    Value="{Binding Percent}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Width="44" Height="24" VerticalContentAlignment="Center"
                                                         Text="{Binding Percent, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                                                <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource Subtle}"
                                                           VerticalAlignment="Center" Margin="2,0,0,0" />
                                                <Button Grid.Column="3" Content="Off" Width="44" Height="24" Margin="0,0,4,0"
                                                        Command="{Binding OffCommand}" />
                                                <Button Grid.Column="4" Content="100%" Width="48" Height="24"
                                                        Command="{Binding FullCommand}" />
                                            </Grid>

                                            <!-- Colour call-outs (only those the light has channels for) -->
                                            <UniformGrid Columns="4" Margin="0,4,0,0"
                                                         Visibility="{Binding HasRgb, Converter={StaticResource BoolToVis}}">
                                                <Button Content="Red" Height="24" Margin="1" Command="{Binding RedCommand}" />
                                                <Button Content="Green" Height="24" Margin="1" Command="{Binding GreenCommand}" />
                                                <Button Content="Blue" Height="24" Margin="1" Command="{Binding BlueCommand}" />
                                                <Button Content="White" Height="24" Margin="1" Command="{Binding WhiteCommand}"
                                                        ToolTip="Red + green + blue mixed" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2" Margin="0,2,0,0"
                                                         Visibility="{Binding HasCollimate, Converter={StaticResource BoolToVis}}">
                                                <Button Content="Collimate" Height="24" Margin="1" Command="{Binding CollimateCommand}" />
                                                <Button Content="White + Collimate" Height="24" Margin="1"
                                                        Command="{Binding WhiteCollimateCommand}"
                                                        ToolTip="Collimate + red + green + blue together"
                                                        Visibility="{Binding HasRgbAndCollimate, Converter={StaticResource BoolToVis}}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
            </TabControl>
        </StackPanel>
    </Border>
</UserControl>
