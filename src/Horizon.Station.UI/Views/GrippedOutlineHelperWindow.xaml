<Window x:Class="Horizon.Station.UI.Views.GrippedOutlineHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Horizon.Station.UI.Views"
        Title="Outline helper" Height="820" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Live view: centre crosshair, the snapshot box, and the white pixels painted yellow. -->
        <Border Grid.Column="0" Background="{StaticResource VideoBg}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid>
                <Image x:Name="FeedImage" Stretch="Uniform" />
                <!-- The canvas has no background, so only the four corner handles (added in code) take the mouse. -->
                <Canvas x:Name="OverlayCanvas" SizeChanged="OnCanvasSizeChanged">
                    <Image x:Name="YellowImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           IsHitTestVisible="False" />
                    <Rectangle x:Name="BoxRect" Stroke="{StaticResource Roi}" StrokeThickness="1.5"
                               StrokeDashArray="6 3" Visibility="Collapsed" IsHitTestVisible="False" />
                </Canvas>
                <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                           Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                <TextBlock x:Name="NoVideo" Text="Waiting for the camera…" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="{StaticResource Overlay}"
                        CornerRadius="3" Margin="6" Padding="8,3">
                    <TextBlock x:Name="CameraText" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Settings + black / white result -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Outline snapshot" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource Subtle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="The block snapshots this box around the crosshair, filters it to black / white, and paints the white pixels yellow on the live view. They then move with the gripper. Drag a corner of the box to resize it — it stays centred on the crosshair." />

                    <TextBlock Text="BOX AROUND THE CROSSHAIR (image pixels)" Foreground="{StaticResource Subtle}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Width" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="WidthBox" Width="64" Height="24" VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Right" TextChanged="OnBoxSizeChanged" />
                        <TextBlock Text="Height" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox x:Name="HeightBox" Width="64" Height="24" VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Right" TextChanged="OnBoxSizeChanged" />
                        <Button Content="300 × 300" Height="24" Padding="8,0" Margin="12,0,0,0" Click="OnDefaultSize"
                                ToolTip="Back to the default square" />
                    </StackPanel>

                    <TextBlock Text="FILTERS (applied in order)" Foreground="{StaticResource Subtle}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <v:FilterRow x:Name="Filter1" Stage="1" />
                    <v:FilterRow x:Name="Filter2" Stage="2" />
                    <v:FilterRow x:Name="Filter3" Stage="3" />

                    <CheckBox x:Name="OverlayCheck" Content="Show the yellow overlay on the live view" IsChecked="True"
                              Foreground="{StaticResource Text}" Margin="0,8,0,6" Click="OnOverlayToggled" />
                    <TextBlock Text="RESULT (white is kept)" Foreground="{StaticResource Subtle}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,4,0,4" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save to block" Height="30" Padding="12,0" FontWeight="SemiBold" Click="OnSave"
                                ToolTip="Store the box size and filters in the Register Gripped Object block and switch its outline on" />
                        <Button Content="Close" Height="30" Padding="12,0" Margin="8,0,0,0" Click="OnClose" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{StaticResource VideoBg}" CornerRadius="3" ClipToBounds="True">
                    <Image x:Name="ResultImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
