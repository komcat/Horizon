<UserControl x:Class="Horizon.Station.UI.Views.DispenseEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Routine list -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Routines" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Width="58" Height="28" Command="{Binding NewCommand}" />
                <Button Content="Delete" Width="58" Height="28" Margin="6,0,0,0" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Routines}" SelectedItem="{Binding SelectedRoutine}"
                     Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                     Foreground="{StaticResource Text}" />
        </DockPanel>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Routine" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gantry" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="200" Text="{Binding GantryDevice}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dispenser slide" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="200" Text="{Binding DispenserSlide}" />
                </Grid>

                <TextBlock Text="Pattern" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Shape" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="130" Height="26" Margin="0,0,0,6"
                              ItemsSource="{Binding PatternKinds}" SelectedItem="{Binding PatternKind}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Angle°" Style="{StaticResource FieldLabel}" Margin="16,0,10,6" />
                    <TextBox Grid.Row="0" Grid.Column="3" Width="80" Text="{Binding AngleDeg, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Grid params -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Grid cols × rows" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                             Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Width="60" HorizontalAlignment="Left" Margin="6,0,0,6"
                             Text="{Binding Rows, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pitch X × Y (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                             Text="{Binding PitchXmm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="2" Grid.Column="2" Width="60" HorizontalAlignment="Left" Margin="6,0,0,6"
                             Text="{Binding PitchYmm, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Line params -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Line dots × length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                             Text="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="3" Grid.Column="2" Width="60" HorizontalAlignment="Left" Margin="6,0,0,6"
                             Text="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        Height="170" Margin="0,6,0,0">
                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True" />
                </Border>
                <TextBlock x:Name="PreviewLabel" Foreground="{StaticResource Subtle}" Margin="2,4,0,0" />

                <TextBlock Text="Shot" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Dwell (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Text="{Binding DwellMs}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Debounce (ms)" Style="{StaticResource FieldLabel}" Margin="16,0,10,6" />
                    <TextBox Grid.Row="0" Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding OutputDebounceMs}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lift-off (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Text="{Binding LiftoffMm}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Approach (mm)" Style="{StaticResource FieldLabel}" Margin="16,0,10,6" />
                    <TextBox Grid.Row="1" Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding ApproachMm}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Slow Z (mm/s)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Text="{Binding SlowZVelocity}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Touch Z adjust" Style="{StaticResource FieldLabel}" Margin="16,0,10,6" />
                    <TextBox Grid.Row="2" Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding TouchZAdjustMm}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Shot device / pin" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Text="{Binding ShotIoDevice}" />
                    <TextBox Grid.Row="3" Grid.Column="3" Width="120" HorizontalAlignment="Left" Text="{Binding ShotPin}" />
                </Grid>

                <CheckBox Content="Return camera over the dispensed location after the last dot"
                          Foreground="{StaticResource Text}" Margin="0,10,0,0"
                          IsChecked="{Binding ReturnToView}" />

                <TextBlock Text="Notes" Style="{StaticResource SectionHeader}" />
                <TextBox Width="Auto" HorizontalAlignment="Stretch" Height="48" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Notes}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save" Width="90" Height="30" Command="{Binding SaveCommand}" />
                    <Button Content="Reload" Width="90" Height="30" Margin="8,0,0,0" Command="{Binding ReloadCommand}" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
