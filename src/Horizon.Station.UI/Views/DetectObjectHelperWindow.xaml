<Window x:Class="Horizon.Station.UI.Views.DetectObjectHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision helper" Height="900" Width="1500" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Final result (X · Y · P) + the block actions. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <CheckBox x:Name="UseXCheck" Content="X (mm)" Foreground="{StaticResource Subtle}" FontSize="11"
                                  IsChecked="True" Click="OnUseChanged"
                                  ToolTip="Ticked: the block returns the detected X. Unticked: it returns the camera's own X (no correction in X)." />
                        <TextBlock x:Name="XText" Text="—" Foreground="{StaticResource Text}" FontFamily="Consolas"
                                   FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <CheckBox x:Name="UseYCheck" Content="Y (mm)" Foreground="{StaticResource Subtle}" FontSize="11"
                                  IsChecked="True" Click="OnUseChanged"
                                  ToolTip="Ticked: the block returns the detected Y. Unticked: it returns the camera's own Y (no correction in Y)." />
                        <TextBlock x:Name="YText" Text="—" Foreground="{StaticResource Text}" FontFamily="Consolas"
                                   FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <CheckBox x:Name="UsePCheck" Content="P (°)  0 = up, clockwise +" Foreground="{StaticResource Subtle}" FontSize="11"
                                  IsChecked="True" Click="OnUseChanged"
                                  ToolTip="Ticked: the block returns the detected angle. Unticked: it returns 0." />
                        <TextBlock x:Name="PText" Text="—" Foreground="{StaticResource Text}" FontFamily="Consolas"
                                   FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Score" Foreground="{StaticResource Subtle}" FontSize="11" />
                        <TextBlock x:Name="ScoreText" Text="—" Foreground="{StaticResource Text}" FontFamily="Consolas"
                                   FontSize="24" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Subtle}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="24,0,16,0"
                           Text="Set the camera, filters and method, then press Detect. X / Y are the camera device's axis values." />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TestMoveButton" Content="Test move to result" Height="30" Padding="12,0"
                            IsEnabled="False" Click="OnTestMove"
                            ToolTip="Centre the camera on the detected point. Refused when the move is over 5 mm." />
                    <Button x:Name="SaveButton" Content="Save to block" Height="30" Padding="12,0" Margin="8,0,0,0"
                            FontWeight="SemiBold" Click="OnSave"
                            ToolTip="Store this recipe in the Detect Object block (then save the program to keep it)" />
                    <Button Content="Close" Height="30" Padding="12,0" Margin="8,0,0,0" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The Vision Profile page, embedded (no profile toolbar). -->
        <ContentControl x:Name="ViewHost" Grid.Row="1" />
    </Grid>
</Window>
