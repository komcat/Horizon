<Window x:Class="Horizon.Station.UI.Views.MarkLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Horizon.Station.UI.Views"
        Title="Mark location" Height="820" Width="1040" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Bg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource Text}" FontSize="14"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Live feed + centre crosshair; a click drops the yellow marker (Confirm / Cancel beside it). -->
        <Border Grid.Row="1" Background="{StaticResource VideoBg}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid Background="Transparent" MouseLeftButtonDown="OnFeedClick" Cursor="Cross">
                <Image x:Name="FeedImage" Stretch="Uniform" />
                <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                           Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                <TextBlock x:Name="NoVideo" Text="Waiting for the camera…" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <v:MarkerPlacer x:Name="Placer" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Cancel — no location" Height="34" Padding="14,0"
                    Click="OnCancel" ToolTip="Close without marking; the block reports nothing found" />
            <TextBlock x:Name="CameraText" Foreground="{StaticResource Subtle}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
