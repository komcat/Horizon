<Window x:Class="Horizon.Station.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Horizon.Station.UI"
        xmlns:v="clr-namespace:Horizon.Station.UI.Views"
        Title="{Binding Source={x:Static ui:StationApp.Title}, StringFormat='{}{0} — Starting'}"
        Height="560" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title + the header mascot: hops and zaps while connecting, red on failure. -->
            <DockPanel Grid.Row="0" Grid.RowSpan="2" Margin="0,0,0,18" LastChildFill="False">
                <v:PikaAvatar x:Name="Mascot" DockPanel.Dock="Right" Width="110" Height="76"
                              VerticalAlignment="Center" Mood="Working" />
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Fiber Active Alignment Machine" TextWrapping="Wrap"
                               Foreground="{StaticResource Accent}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Operator UI — on the Horizon engine"
                               Foreground="{StaticResource Subtle}" FontSize="13" Margin="2,0,0,0" />
                    <TextBlock x:Name="VersionText"
                               Foreground="{StaticResource Subtle}" FontSize="13" Margin="2,2,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Starting…"
                           Foreground="{StaticResource Text}" FontSize="18" Margin="0,0,0,8" />
                <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" />
            </StackPanel>

            <Border Grid.Row="3" Margin="0,16,0,0"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="{StaticResource Subtle}"
                               FontFamily="Consolas" FontSize="15"
                               TextWrapping="Wrap" Margin="8" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#E74C3C" FontSize="14"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Visibility="Collapsed" />
                <StackPanel x:Name="ErrorButtons" Orientation="Horizontal"
                            HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Retry" Width="84" Height="28" Margin="0,0,8,0"
                            Click="OnRetryClick" />
                    <Button Content="Exit" Width="84" Height="28"
                            Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
