<Window x:Class="Horizon.Station.UI.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Horizon.Station.UI"
        Title="{x:Static ui:StationApp.Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource AlertBg}">
    <Border BorderBrush="{StaticResource AlertEdge}" BorderThickness="3">
        <StackPanel Margin="30,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <!-- Slow "breathing" dot — a calm cue that the buzzer is sounding. -->
                <Ellipse Width="18" Height="18" Fill="{StaticResource AlertEdge}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.5">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="AlertTitle" Foreground="{StaticResource AlertTitle}" FontSize="26" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460" />
            </StackPanel>
            <TextBlock x:Name="AlertMessage" Foreground="{StaticResource AlertText}" FontSize="19"
                       TextWrapping="Wrap" Margin="32,0,0,18" />
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ElapsedText" DockPanel.Dock="Left" Foreground="{StaticResource AlertText}" FontSize="14"
                           VerticalAlignment="Center" Margin="32,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Acknowledge" Width="170" Height="48" FontSize="18"
                        FontWeight="SemiBold" Click="OnAcknowledge" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
