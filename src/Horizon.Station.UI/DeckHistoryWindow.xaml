<Window x:Class="Horizon.Station.UI.DeckHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck History"
        Height="600" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <Style x:Key="KindChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Warn}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Background" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Foreground="{StaticResource Accent}"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TabControl x:Name="HistoryTabs" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Edge}">
            <!-- ===== Revisions of this deck ===== -->
            <TabItem Header="Revisions">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Revisions" Foreground="{StaticResource Subtle}"
                                       FontSize="12" Margin="10,8,10,4" />
                            <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" Margin="4" SelectionChanged="OnVersionSelected"
                                     DisplayMemberPath="Header" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3">
                        <DockPanel Margin="8">
                            <TextBlock x:Name="DiffHeader" DockPanel.Dock="Top" Foreground="{StaticResource Text}"
                                       FontSize="13" FontWeight="SemiBold" Margin="2,2,2,8" Text="Select a revision." />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DiffList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource KindChip}">
                                                            <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}"
                                                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Uid}" Foreground="{StaticResource Subtle}"
                                                                   FontFamily="Consolas" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Subtle}"
                                                               FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Cross-deck query ===== -->
            <TabItem Header="Query">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Filter saved deck entries (any field, AND-combined)"
                                       Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,6" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="Deck UID" Foreground="{StaticResource Subtle}" FontSize="10" />
                                    <TextBox x:Name="DeckUidBox" Width="220" Height="26" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="Entry UID" Foreground="{StaticResource Subtle}" FontSize="10" />
                                    <TextBox x:Name="EntryUidBox" Width="200" Height="26" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="Program" Foreground="{StaticResource Subtle}" FontSize="10" />
                                    <TextBox x:Name="ProgramBox" Width="140" Height="26" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="Operator id" Foreground="{StaticResource Subtle}" FontSize="10" />
                                    <TextBox x:Name="OperatorBox" Width="110" Height="26" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <Button Content="Search" Width="78" Height="26" Margin="0,0,6,0"
                                            IsDefault="True" Click="OnSearch" />
                                    <Button Content="Clear" Width="60" Height="26" Click="OnClearQuery" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="QueryStatus" DockPanel.Dock="Top" Foreground="{StaticResource Subtle}"
                               FontSize="12" Margin="2,0,0,6" Text="Enter a filter and Search." />

                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" Foreground="{StaticResource Text}"
                              BorderThickness="1" BorderBrush="{StaticResource Edge}" CanUserAddRows="False"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="140" />
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="90" />
                            <DataGridTextColumn Header="Deck" Binding="{Binding Deck}" Width="120" />
                            <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="44" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="100" />
                            <DataGridTextColumn Header="Entry UID" Binding="{Binding Uid}" Width="120" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="44" />
                            <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="140" />
                            <DataGridTextColumn Header="Auto" Binding="{Binding Auto}" Width="50" />
                            <DataGridTextColumn Header="Delay" Binding="{Binding Delay}" Width="56" />
                            <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
