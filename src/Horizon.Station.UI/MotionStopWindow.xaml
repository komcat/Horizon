<Window x:Class="Horizon.Station.UI.MotionStopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Horizon.Station.UI"
        Title="{x:Static ui:StationApp.Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Panel}">
    <Border BorderBrush="{StaticResource Danger}" BorderThickness="3">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="StopTitle" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="StopMessage" Foreground="{StaticResource Text}" FontSize="15"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- One big STOP — halts the device; the runner then restores its velocity. -->
            <Button x:Name="StopButton" Height="130" Cursor="Hand" Click="OnStop" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{StaticResource Danger}" CornerRadius="10"
                                BorderBrush="#7F1D16" BorderThickness="2">
                            <TextBlock Text="STOP" Foreground="White" FontSize="52" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#F05545" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#B03A2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="ElapsedText" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</Window>
