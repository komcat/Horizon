<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared Layer 3 WPF library: the station UI every operator head (FAAM.UI, DLAM.UI) is
       built from — theme, MVVM, telemetry, shell pieces, Machine page, Engineer editor, ...
       Extracted from FAAM.UI slice by slice (docs/station-ui-extraction.md). Same layer rule
       as a head: Horizon.Workflow + Horizon.Engine + Horizon.Common only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Same platform version as the heads, so WPF package resolution stays on net8.0-windows. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.Station.UI</RootNamespace>
    <AssemblyName>Horizon.Station.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code editor for the .moon script page (syntax highlight, completion, Lua folding). -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- SMU / Measurement live trend charts (SKElement). -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
    <!-- Diagnostics from the updater and shutdown path; the head configures the sinks. -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <!-- Internet software update (AppUpdater). Keep in step with the vpk tool version
         deploy/release.ps1 packs with, and with the head's own Velopack reference. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Toolbar / jog images, as WPF resources (/assets/... from library XAML;
         /Horizon.Station.UI;component/assets/... from a head). -->
    <Resource Include="assets\**\*.png" />
  </ItemGroup>

  <!-- Every library namespace in scope in every library file (types moved out of FAAM.UI
       keep resolving where they were used by their old enclosing-namespace names). -->
  <ItemGroup>
    <Using Include="Horizon.Station.UI" />
    <Using Include="Horizon.Station.UI.Mvvm" />
    <Using Include="Horizon.Station.UI.Telemetry" />
    <Using Include="Horizon.Station.UI.Process" />
    <Using Include="Horizon.Station.UI.ViewModels" />
    <Using Include="Horizon.Station.UI.ViewModels.Sections" />
    <Using Include="Horizon.Station.UI.ViewModels.Timeline" />
    <Using Include="Horizon.Station.UI.Views" />
    <Using Include="Horizon.Station.UI.Views.Sections" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>

</Project>
