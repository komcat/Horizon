<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared Layer 3 WPF library: the station UI every operator head (FAAM.UI, DLAM.UI) is
       built from — theme, MVVM, telemetry, shell pieces, Machine page, Engineer editor, ...
       Extracted from FAAM.UI slice by slice (docs/station-ui-extraction.md). Same layer rule
       as a head: Horizon.Workflow + Horizon.Engine + Horizon.Common only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Same platform version as the heads, so WPF package resolution stays on net8.0-windows. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.Station.UI</RootNamespace>
    <AssemblyName>Horizon.Station.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lua folding for the .moon script editor. -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>

</Project>
