<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.ConsoleHost</RootNamespace>
    <AssemblyName>Horizon.Console</AssemblyName>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="25110.0.0" />
  </ItemGroup>

  <!-- DLAM's XCAN script, run by Scripting › Run XCAN (pick a hexapod). -->
  <ItemGroup>
    <None Include="..\..\tools\dlam\scripts\XCAN.moon" Link="scripts\XCAN.moon" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
  </ItemGroup>

</Project>
