<Window x:Class="Horizon.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="340" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Startup Section -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Startup" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource Theme.AccentBrush}"/>
            <CheckBox x:Name="AutoOpenTopViewCheck" Content="Auto-open Top View on startup"
                      Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>
            <CheckBox x:Name="AutoStartMeasPollingCheck" Content="Auto-start measurement polling"
                      Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,8,0,8"
                   Background="{DynamicResource Theme.BorderBrush}"/>

        <!-- Top View Defaults Section -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Top View Defaults" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource Theme.AccentBrush}"/>
            <CheckBox x:Name="ShowCrosshairCheck" Content="Show crosshair"
                      Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>
            <CheckBox x:Name="ClickToMoveCheck" Content="Enable click-to-move"
                      Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>
            <CheckBox x:Name="ShowChartCheck" Content="Show chart overlay"
                      Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Padding="4,6" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Close" Width="80" Padding="4,6" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
