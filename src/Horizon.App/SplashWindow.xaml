<Window x:Class="Horizon.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon"
        Width="420" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#FF1E1E1E" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="6">
        <Grid Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="HORIZON"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#FF007ACC"
                       HorizontalAlignment="Center"/>

            <!-- Subtitle -->
            <TextBlock Grid.Row="2"
                       Text="Connecting hardware..."
                       x:Name="SubtitleText"
                       FontSize="12"
                       Foreground="#FF999999"
                       HorizontalAlignment="Center"/>

            <!-- Hardware items list -->
            <ItemsControl Grid.Row="4"
                          x:Name="DeviceList"
                          Background="Transparent"
                          BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status dot -->
                            <Ellipse Grid.Column="0"
                                     Width="10" Height="10"
                                     Fill="{Binding DotBrush}"
                                     VerticalAlignment="Center"/>

                            <!-- Device name -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Name}"
                                       Foreground="#FFF1F1F1"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <!-- Status text -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom status -->
            <TextBlock Grid.Row="6"
                       x:Name="BottomStatus"
                       Text=""
                       FontSize="11"
                       Foreground="#FF656565"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
