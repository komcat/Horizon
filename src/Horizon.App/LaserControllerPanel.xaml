<UserControl x:Class="Horizon.App.LaserControllerPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HeaderText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect" Padding="10,3" Margin="0,0,6,0" Click="Connect_Click"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Padding="10,3" Click="Disconnect_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="1" Margin="0,4,0,8">
            <TextBlock x:Name="StatusText" FontSize="11" FontFamily="Consolas"
                       Foreground="{DynamicResource Theme.ForegroundDisabledBrush}"/>
        </StackPanel>

        <!-- TEC Section -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2" Margin="0,0,0,8">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TEC Control" FontFamily="Consolas" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Setpoint (C):" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,8,0"/>
                    <TextBox x:Name="TempSetpointInput" Grid.Column="1" Text="25.0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource Theme.BackgroundBrush}"
                             Foreground="{DynamicResource Theme.ForegroundBrush}"
                             BorderBrush="{DynamicResource Theme.BorderBrush}"
                             Padding="4,2" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Set" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="SetTemp_Click"/>
                    <Button Grid.Column="3" Content="TEC ON" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="TECOn_Click"/>
                    <Button Grid.Column="4" Content="TEC OFF" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="TECOff_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Live Temp:" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LiveTempText" Grid.Column="1" Text="--" FontFamily="Consolas" FontSize="14"
                               FontWeight="Bold" Foreground="#00FF00"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Laser Section -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2" Margin="0,0,0,8">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Laser Control" FontFamily="Consolas" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Current (mA):" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,8,0"/>
                    <TextBox x:Name="LaserCurrentInput" Grid.Column="1" Text="50.0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource Theme.BackgroundBrush}"
                             Foreground="{DynamicResource Theme.ForegroundBrush}"
                             BorderBrush="{DynamicResource Theme.BorderBrush}"
                             Padding="4,2" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Set" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="SetLaserCurrent_Click"/>
                    <Button Grid.Column="3" Content="Laser ON" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="LaserOn_Click"/>
                    <Button Grid.Column="4" Content="Laser OFF" Padding="10,3" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="LaserOff_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Live Current:" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LiveCurrentText" Grid.Column="1" Text="--" FontFamily="Consolas" FontSize="14"
                               FontWeight="Bold" Foreground="#00FF00"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Summary -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}" Padding="6,4">
                    <TextBlock Text="Device Status" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                </Border>
                <TextBlock x:Name="DeviceStatusText" Grid.Row="1" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="8,4"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
