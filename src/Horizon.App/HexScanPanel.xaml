<UserControl x:Class="Horizon.App.HexScanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.BackgroundBrush}"
             Foreground="{DynamicResource Theme.ForegroundBrush}">

    <UserControl.Resources>
        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="#FF3A3A3A"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D8387"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF14FFEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#FF3A3A3A"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF28A745"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5CB85C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Device + Channel + Preset + Controls -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.BackgroundAltBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                CornerRadius="2" Padding="8" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Device selector -->
                <TextBlock Grid.Column="0" Text="Device:" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="0,0,6,0"/>
                <WrapPanel x:Name="DevicePanel" Grid.Column="1" VerticalAlignment="Center"/>

                <!-- Channel selector -->
                <TextBlock Grid.Column="2" Text="Channel:" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="12,0,6,0"/>
                <ComboBox x:Name="ChannelCombo" Grid.Column="3" Width="150"
                          FontFamily="Consolas" FontSize="11"
                          SelectionChanged="ChannelCombo_SelectionChanged"
                          DropDownOpened="ChannelCombo_DropDownOpened"/>

                <!-- Preset toggle -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                    <ToggleButton x:Name="CoarseToggle" Content="Coarse"
                                  Style="{StaticResource ToggleBtn}" IsChecked="True"
                                  Checked="CoarseToggle_Checked"/>
                    <ToggleButton x:Name="FineToggle" Content="Fine"
                                  Style="{StaticResource ToggleBtn}"
                                  Checked="FineToggle_Checked"/>
                </StackPanel>

                <!-- Start / Stop -->
                <Button x:Name="StartButton" Grid.Column="5" Content="Start Scan"
                        Style="{StaticResource ActionBtn}" Margin="12,0,2,0"
                        Click="StartScan_Click"/>
                <Button x:Name="StopButton" Grid.Column="6" Content="Stop" IsEnabled="False"
                        Margin="2,0,0,0" Height="28" MinWidth="60"
                        FontFamily="Consolas" FontSize="11" Cursor="Hand" Click="StopScan_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFCC3333"
                                    BorderBrush="#FFFF4444" BorderThickness="1" CornerRadius="2" Padding="8,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFEE4444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF991111"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Row 1: Status + Progress -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                CornerRadius="2" Padding="8,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Status:" FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Idle"
                           FontFamily="Consolas" FontSize="11" Foreground="#FF14FFEC"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="2" Text="Progress:" FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ProgressBar x:Name="ScanProgress" Grid.Column="3" Height="14"
                             Minimum="0" Maximum="100" Value="0"
                             Background="#FF2A2A2A" Foreground="#FF14FFEC"
                             BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"/>
                <TextBlock x:Name="ProgressText" Grid.Column="4" Text="0%"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- Row 2: Live Position + Measurement Summary -->
        <Border Grid.Row="2"
                Background="{DynamicResource Theme.BackgroundAltBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                CornerRadius="2" Padding="8,4" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Live position -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Live:" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PosX" Text="X=---" FontFamily="Consolas" FontSize="11"
                               Foreground="#FF14FFEC" Margin="0,0,12,0"/>
                    <TextBlock x:Name="PosY" Text="Y=---" FontFamily="Consolas" FontSize="11"
                               Foreground="#FF14FFEC" Margin="0,0,12,0"/>
                    <TextBlock x:Name="PosZ" Text="Z=---" FontFamily="Consolas" FontSize="11"
                               Foreground="#FF14FFEC"/>
                </StackPanel>

                <!-- Baseline / Peak summary -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Baseline:" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="BaselineText" Text="---" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="Peak:" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="PeakText" Text="---" FontFamily="Consolas" FontSize="11"
                               Foreground="#FF28A745"/>
                    <TextBlock x:Name="ImprovementText" Text="" FontFamily="Consolas" FontSize="11"
                               Foreground="#FFFFB900" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Column headers label -->
        <TextBlock Grid.Row="3" Text="SCAN DATA" Style="{StaticResource SectionHeader}"/>

        <!-- Row 4: Results DataGrid -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="4"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{DynamicResource Theme.BackgroundAltBrush}"
                  Foreground="{DynamicResource Theme.ForegroundBrush}"
                  RowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                  AlternatingRowBackground="{DynamicResource Theme.BackgroundBrush}"
                  BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                  FontFamily="Consolas" FontSize="11"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Theme.MenuBarBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="FontSize" Value="11"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Step" Binding="{Binding StepIndex}" Width="50"/>
                <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" Width="45"/>
                <DataGridTextColumn Header="Dir" Binding="{Binding DirectionLabel}" Width="35"/>
                <DataGridTextColumn Header="Step mm" Binding="{Binding StepSizeLabel}" Width="65"/>
                <DataGridTextColumn Header="Position" Binding="{Binding PositionLabel}" Width="90"/>
                <DataGridTextColumn Header="Value" Binding="{Binding ValueLabel}" Width="90"/>
                <DataGridTextColumn Header="Peak" Binding="{Binding PeakLabel}" Width="45"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
