<UserControl x:Class="Horizon.App.Controls.PropertyTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
        <StackPanel x:Name="PropertiesPanel"/>
    </ScrollViewer>
</UserControl>
