<UserControl x:Class="Horizon.App.TrainerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Theme.BackgroundBrush}"
    Foreground="{DynamicResource Theme.ForegroundBrush}">

    <UserControl.Resources>
        <!-- Nav button style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Step button style -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.BackgroundAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Wizard action button -->
        <Style x:Key="WizardAction" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- DataGrid shared styles -->
        <Style x:Key="DgColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Theme.MenuBarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="DgCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left nav -->
            <ColumnDefinition Width="130"/>
            <!-- Right content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAV SIDEBAR -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,1,0"
                Background="#FF1E1E1E">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="TRAINERS" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                           Foreground="#FF808080" Margin="8,0,0,8"/>
                <Button x:Name="NavBondingAccuracy" Content="Pos. Bonding Accuracy"
                        Style="{StaticResource NavButton}" Click="NavButton_Click" Tag="bonding"
                        Background="#FF3E3E42"/>
                <Button Content="(Coming Soon)" Style="{StaticResource NavButton}" IsEnabled="False"
                        Foreground="#FF606060"/>
                <Button Content="(Coming Soon)" Style="{StaticResource NavButton}" IsEnabled="False"
                        Foreground="#FF606060"/>
            </StackPanel>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Margin="6,4,4,4">
            <Grid.RowDefinitions>
                <!-- Header bar -->
                <RowDefinition Height="Auto"/>
                <!-- Main content -->
                <RowDefinition Height="*"/>
                <!-- Log -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER: Device, Dataset, buttons, live XYZ -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2"
                    Padding="6,4" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: controls -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Device:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DeviceCombo" Grid.Row="0" Grid.Column="1" FontFamily="Consolas" FontSize="11"
                              Padding="3,2" SelectionChanged="DeviceCombo_SelectionChanged"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Load" FontSize="10" Padding="8,3" Margin="8,0,0,0"
                            Click="LoadSet_Click"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="+ New" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                            Click="NewSet_Click"/>
                    <Button Grid.Row="0" Grid.Column="4" Content="Save" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                            Click="SaveSet_Click"/>
                    <Button Grid.Row="0" Grid.Column="5" Content="Delete" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                            Click="DeleteSet_Click" Foreground="White" Background="#C62828"/>
                    <TextBlock Grid.Row="0" Grid.Column="7" x:Name="LivePositionText" FontSize="11" FontFamily="Consolas"
                               Foreground="#FFFFD54F" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Text="-- not connected --"/>

                    <!-- Row 1: dataset file info -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal"
                                Margin="0,3,0,0">
                        <TextBlock x:Name="DatasetNameText" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Text="(no dataset loaded)"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DatasetPathText" FontSize="10" FontFamily="Consolas"
                                   Foreground="#FF808080" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN: 25/75 split -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Col1: Step buttons (25%) -->
                    <ColumnDefinition Width="1*"/>
                    <!-- Col2: Wizard content (75%) -->
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- STEP BUTTONS (Col1) -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                        Background="#FF252528" CornerRadius="2" Padding="4" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="STEPS" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                   Foreground="#FF808080" Margin="4,2,0,6"/>
                        <Button x:Name="StepBtn1" Style="{StaticResource StepButton}"
                                Click="StepButton_Click" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepIndicator1" Width="10" Height="10" Fill="#FF555555"
                                         Stroke="#FF777777" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="1. Bonding Positions" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StepBtn2" Style="{StaticResource StepButton}"
                                Click="StepButton_Click" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepIndicator2" Width="10" Height="10" Fill="#FF555555"
                                         Stroke="#FF777777" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="2. Reference Points" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StepBtn3" Style="{StaticResource StepButton}"
                                Click="StepButton_Click" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="3. Retrace Bonding" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,8" Background="{DynamicResource Theme.BorderBrush}"/>
                        <TextBlock x:Name="FrameStatusText" FontSize="10" FontFamily="Consolas"
                                   Foreground="#FF4EC9B0" TextWrapping="Wrap" Margin="4,0"/>
                    </StackPanel>
                </Border>

                <!-- WIZARD CONTENT (Col2) -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2" Padding="8">

                    <Grid>
                        <!-- ============ STEP 1: BONDING POSITIONS WIZARD ============ -->
                        <Grid x:Name="WizardStep1" Visibility="Visible">
                            <!-- Sub-step panels stacked, only one visible at a time -->
                            <Grid>
                                <!-- 1a: Start -->
                                <Grid x:Name="Step1_Start" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Bonding Positions" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Enter a bonding point name and choose corner count to begin capture."
                                                   FontSize="11" Foreground="#FFB0B0B0" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Name:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                                            <TextBox x:Name="BondNameBox" Width="150" FontFamily="Consolas" FontSize="11"
                                                     Padding="3,2"
                                                     Background="{DynamicResource Theme.BackgroundBrush}"
                                                     Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                     BorderBrush="{DynamicResource Theme.BorderBrush}"/>
                                            <TextBlock Text="  Corners:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CornerCountCombo" Width="50" FontFamily="Consolas" FontSize="11"
                                                      Padding="3,2" SelectedIndex="0">
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                            </ComboBox>
                                            <Button Content="Begin Capture" Style="{StaticResource WizardAction}" Margin="12,0,0,0"
                                                    Click="BeginCapture_Click"/>
                                        </StackPanel>

                                        <TextBlock Text="Captured Bonding Points:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,8,0,4"/>
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" x:Name="BondingGrid"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              HeadersVisibility="Column" GridLinesVisibility="None"
                                              Background="{DynamicResource Theme.BackgroundBrush}"
                                              Foreground="{DynamicResource Theme.ForegroundBrush}"
                                              RowBackground="{DynamicResource Theme.BackgroundBrush}"
                                              AlternatingRowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                                              BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                              FontFamily="Consolas" FontSize="11"
                                              RowHeight="38">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgColumnHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DgCell}"/>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Actions" Width="160" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Go" FontSize="9" Padding="6,1" Margin="0,0,2,0"
                                                                    Click="GoToBondCenter_Click" Tag="{Binding}"
                                                                    ToolTip="Move to center XYZ"/>
                                                            <Button Content="Reteach" FontSize="9" Padding="6,1" Margin="0,0,2,0"
                                                                    Click="ReteachBond_Click" Tag="{Binding}"/>
                                                            <Button Content="Del" FontSize="9" Padding="6,1"
                                                                    Click="DeleteBond_Click" Tag="{Binding}"
                                                                    Foreground="White" Background="#C62828"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Image" Width="42" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding CenterImagePath}" Width="36" Height="32"
                                                               Stretch="UniformToFill" Margin="1"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               ToolTip="{Binding CenterImagePath}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                                            <DataGridTextColumn Header="Corners" Binding="{Binding Corners.Count}" Width="55"/>
                                            <DataGridTextColumn Header="Center X" Binding="{Binding GlobalX, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Center Y" Binding="{Binding GlobalY, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Center Z" Binding="{Binding GlobalZ, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Local X" Binding="{Binding LocalX, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Local Y" Binding="{Binding LocalY, StringFormat=F4}" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <!-- 1b-1d: Capture Corner -->
                                <Grid x:Name="Step1_Capture" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="CaptureTitle" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" x:Name="CaptureInstruction" FontSize="11"
                                               Foreground="#FFB0B0B0" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Camera:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CameraCombo" Width="200" FontFamily="Consolas" FontSize="11"
                                                      Padding="3,2"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CaptureLivePos" FontSize="12" FontFamily="Consolas"
                                                   Foreground="#FFFFD54F" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Capture" Style="{StaticResource WizardAction}"
                                                    Click="CaptureCorner_Click" Background="#FF0078D4" Foreground="White"/>
                                            <Button Content="Cancel" Style="{StaticResource WizardAction}"
                                                    Click="CancelCapture_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Captured corners so far -->
                                    <StackPanel Grid.Row="3" x:Name="CapturedCornersPanel" Margin="0,16,0,0">
                                        <TextBlock Text="Captured so far:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="CapturedCornersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource Theme.BackgroundBrush}" CornerRadius="2"
                                                            Padding="6,4" Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding ImagePath}" Width="48" Height="36"
                                                                   Stretch="UniformToFill" Margin="0,0,8,0"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Theme.ForegroundBrush}">
                                                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding Coords, Mode=OneWay}" Foreground="#FF4EC9B0"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- 1e: Review -->
                                <Grid x:Name="Step1_Review" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Review Bonding Point" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" x:Name="ReviewCenterText" FontSize="12" FontFamily="Consolas"
                                               Foreground="#FF4EC9B0" Margin="0,0,0,8"/>

                                    <ItemsControl Grid.Row="2" x:Name="ReviewCornersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                        Background="{DynamicResource Theme.BackgroundBrush}" CornerRadius="2"
                                                        Padding="6,4" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding ImagePath}" Width="64" Height="48"
                                                               Stretch="UniformToFill" Margin="0,0,8,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Theme.ForegroundBrush}">
                                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Coords, Mode=OneWay}" Foreground="#FF4EC9B0"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Complete" Style="{StaticResource WizardAction}"
                                                Click="CompleteCapture_Click" Background="#FF388E3C" Foreground="White"/>
                                        <Button Content="Discard" Style="{StaticResource WizardAction}"
                                                Click="DiscardCapture_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ============ STEP 2: REFERENCE POINTS WIZARD ============ -->
                        <Grid x:Name="WizardStep2" Visibility="Collapsed">
                            <Grid>
                                <!-- 2a: Start/list -->
                                <Grid x:Name="Step2_Start" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Reference Points" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Teach 2-3 reference landmarks for coordinate frame computation. Each ref uses 2-3 corner points to compute center."
                                                   FontSize="11" Foreground="#FFB0B0B0" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Corners:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="RefCornerCountCombo" Width="50" FontFamily="Consolas" FontSize="11"
                                                      Padding="3,2" SelectedIndex="0">
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" x:Name="RefGrid"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              HeadersVisibility="Column" GridLinesVisibility="None"
                                              Background="{DynamicResource Theme.BackgroundBrush}"
                                              Foreground="{DynamicResource Theme.ForegroundBrush}"
                                              RowBackground="{DynamicResource Theme.BackgroundBrush}"
                                              AlternatingRowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                                              BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                              FontFamily="Consolas" FontSize="11"
                                              RowHeight="38">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgColumnHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DgCell}"/>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Actions" Width="140" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Go" FontSize="9" Padding="6,1" Margin="0,0,2,0"
                                                                    Click="GoToRefCenter_Click" Tag="{Binding}"
                                                                    ToolTip="Move to center XYZ"/>
                                                            <Button Content="Reteach" FontSize="9" Padding="6,1" Margin="0,0,2,0"
                                                                    Click="ReteachRef_Click" Tag="{Binding}"/>
                                                            <Button Content="Del" FontSize="9" Padding="6,1"
                                                                    Click="DeleteRef_Click" Tag="{Binding}"
                                                                    Foreground="White" Background="#C62828"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Image" Width="42" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding CenterImagePath}" Width="36" Height="32"
                                                               Stretch="UniformToFill" Margin="1"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               ToolTip="{Binding CenterImagePath}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="80"/>
                                            <DataGridTextColumn Header="Corners" Binding="{Binding Corners.Count}" Width="55"/>
                                            <DataGridTextColumn Header="Center X" Binding="{Binding GlobalX, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Center Y" Binding="{Binding GlobalY, StringFormat=F4}" Width="85"/>
                                            <DataGridTextColumn Header="Center Z" Binding="{Binding GlobalZ, StringFormat=F4}" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="TeachRefBtn" Content="Teach Next Ref" Style="{StaticResource WizardAction}"
                                                Click="TeachRefWizard_Click"/>
                                        <Button Content="Compute Frame" Style="{StaticResource WizardAction}"
                                                Click="ComputeFrame_Click" Background="#FF0078D4" Foreground="White"/>
                                        <Button Content="Complete" Style="{StaticResource WizardAction}"
                                                Click="CompleteRefs_Click" Background="#FF388E3C" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2b: Capture ref corner -->
                                <Grid x:Name="Step2_Capture" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="RefCaptureTitle" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" x:Name="RefCaptureInstruction" FontSize="11"
                                               Foreground="#FFB0B0B0" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Camera:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="RefCameraCombo" Width="200" FontFamily="Consolas" FontSize="11"
                                                      Padding="3,2"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RefCaptureLivePos" FontSize="12" FontFamily="Consolas"
                                                   Foreground="#FFFFD54F" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Capture" Style="{StaticResource WizardAction}"
                                                    Click="CaptureRef_Click" Background="#FF0078D4" Foreground="White"/>
                                            <Button Content="Cancel" Style="{StaticResource WizardAction}"
                                                    Click="CancelRefCapture_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Captured ref corners so far -->
                                    <StackPanel Grid.Row="3" x:Name="RefCapturedCornersPanel" Margin="0,16,0,0">
                                        <TextBlock Text="Captured so far:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="RefCapturedCornersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource Theme.BackgroundBrush}" CornerRadius="2"
                                                            Padding="6,4" Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding ImagePath}" Width="48" Height="36"
                                                                   Stretch="UniformToFill" Margin="0,0,8,0"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Theme.ForegroundBrush}">
                                                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding Coords, Mode=OneWay}" Foreground="#FF4EC9B0"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- 2c: Review ref -->
                                <Grid x:Name="Step2_Review" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Review Reference Point" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" x:Name="RefReviewCenterText" FontSize="12" FontFamily="Consolas"
                                               Foreground="#FF4EC9B0" Margin="0,0,0,8"/>

                                    <ItemsControl Grid.Row="2" x:Name="RefReviewCornersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                        Background="{DynamicResource Theme.BackgroundBrush}" CornerRadius="2"
                                                        Padding="6,4" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding ImagePath}" Width="64" Height="48"
                                                               Stretch="UniformToFill" Margin="0,0,8,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Theme.ForegroundBrush}">
                                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Coords, Mode=OneWay}" Foreground="#FF4EC9B0"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Complete" Style="{StaticResource WizardAction}"
                                                Click="CompleteRefCapture_Click" Background="#FF388E3C" Foreground="White"/>
                                        <Button Content="Discard" Style="{StaticResource WizardAction}"
                                                Click="DiscardRefCapture_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ============ STEP 3: RETRACE BONDING (RUN) ============ -->
                        <Grid x:Name="WizardStep3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Retrace Bonding" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Re-visit reference landmarks to compute corrected bonding positions."
                                           FontSize="11" Foreground="#FFB0B0B0" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Alignment controls -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                    Background="#FF252528" CornerRadius="2" Padding="6,4" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button x:Name="StartAlignBtn" Content="Start Alignment" Style="{StaticResource WizardAction}"
                                                Click="StartAlignment_Click"/>
                                        <Button x:Name="AcceptRefBtn" Content="Accept Ref" Style="{StaticResource WizardAction}"
                                                Click="AcceptRef_Click" IsEnabled="False"/>
                                        <TextBlock x:Name="AlignStatusText" FontSize="11" FontFamily="Consolas"
                                                   Foreground="#FFFFD54F" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <!-- Reference thumbnail for visual matching -->
                                    <StackPanel x:Name="RefThumbnailPanel" Orientation="Horizontal" Margin="0,4,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="Reference:" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="#FFB0B0B0" Margin="0,0,6,0"/>
                                        <Image x:Name="RefThumbnailImage" Width="80" Height="60"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="RefThumbnailCoords" FontSize="10" FontFamily="Consolas"
                                                   Foreground="#FF4EC9B0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Corrected positions grid -->
                            <DataGrid Grid.Row="2" x:Name="CorrectedGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="{DynamicResource Theme.BackgroundBrush}"
                                      Foreground="{DynamicResource Theme.ForegroundBrush}"
                                      RowBackground="{DynamicResource Theme.BackgroundBrush}"
                                      AlternatingRowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                                      BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                      FontFamily="Consolas" FontSize="11">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgColumnHeader}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DgCell}"/>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Go" Width="50" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Go" FontSize="9" Padding="6,1"
                                                        Click="GoToCorrected_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="Corrected X" Binding="{Binding CorrectedX, StringFormat=F4}" Width="100"/>
                                    <DataGridTextColumn Header="Corrected Y" Binding="{Binding CorrectedY, StringFormat=F4}" Width="100"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding CorrectedZ, StringFormat=F4}" Width="80"/>
                                    <DataGridTextColumn Header="Delta X" Binding="{Binding DeltaX, StringFormat=F4}" Width="90"/>
                                    <DataGridTextColumn Header="Delta Y" Binding="{Binding DeltaY, StringFormat=F4}" Width="90"/>
                                    <DataGridTextColumn Header="Scale" Binding="{Binding Scale, StringFormat=F6}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- LOG -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    Background="#FF1E1E1E" CornerRadius="2" Padding="4" Margin="0,4,0,0"
                    MaxHeight="100">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="10"
                               Foreground="#FFB0B0B0" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
