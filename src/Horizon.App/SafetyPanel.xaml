<UserControl x:Class="Horizon.App.SafetyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}">
            <ToolBar Background="{DynamicResource Theme.MenuBarBrush}" Band="1" BandIndex="1">
                <Button x:Name="AcknowledgeBtn" Content="Acknowledge" Click="Acknowledge_Click" Padding="8,2"
                        FontFamily="Consolas" FontSize="11" Foreground="#90EE90" Background="Transparent"
                        BorderThickness="0" FontWeight="Bold" IsEnabled="False"/>
                <Separator/>
                <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click" Padding="6,2"
                        FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}"
                        Background="Transparent" BorderThickness="0"/>
                <Separator/>
                <TextBlock x:Name="StatusText" Text="Safety OK" FontFamily="Consolas" FontSize="11"
                           Foreground="#4EC9B0" VerticalAlignment="Center" Margin="8,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Safety status banner -->
        <Border x:Name="StatusBanner" Grid.Row="1" Padding="12,8"
                Background="#1B3A1B" BorderBrush="#2D5A2D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusIndicator" Grid.Column="0" Width="16" Height="16"
                         Fill="#4EC9B0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerTitle" Text="System Safe" FontFamily="Consolas" FontSize="14"
                               FontWeight="Bold" Foreground="#4EC9B0"/>
                    <TextBlock x:Name="BannerMessage" Text="All safety inputs normal" FontFamily="Consolas"
                               FontSize="11" Foreground="#808080" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Enforcement:" FontFamily="Consolas" FontSize="11"
                               Foreground="#808080" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="EnforcementModeText" Text="Passive" FontFamily="Consolas" FontSize="11"
                               Foreground="#DCDCAA" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs: Safety Watch + Interlocks -->
        <TabControl Grid.Row="2" Background="{DynamicResource Theme.BackgroundBrush}"
                    FontFamily="Consolas" FontSize="11"
                    Foreground="{DynamicResource Theme.ForegroundBrush}">

            <!-- ═══ Tab 1: Safety Watch ═══ -->
            <TabItem Header="Safety Watch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <!-- Add/Remove buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4">
                        <Button x:Name="AddInputBtn" Content="+ Add Input" Click="AddInput_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#87CEEB" Background="Transparent"
                                BorderThickness="0"/>
                        <Button x:Name="RemoveInputBtn" Content="- Remove" Click="RemoveInput_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#FF6347" Background="Transparent"
                                BorderThickness="0"/>
                        <Button x:Name="SaveConfigBtn" Content="Save Config" Click="SaveConfig_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#DCDCAA" Background="Transparent"
                                BorderThickness="0"/>
                    </StackPanel>

                    <!-- Add Input Form (collapsible) -->
                    <Border x:Name="AddInputForm" Grid.Row="1" Visibility="Collapsed"
                            Background="#252526" BorderBrush="#333348" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Device:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"
                                           ToolTip="IO device that has the safety input pin"/>
                                <ComboBox x:Name="AddDeviceCombo" Width="140" FontFamily="Consolas" FontSize="11"
                                          SelectionChanged="AddDeviceCombo_Changed" Margin="0,0,12,0"/>
                                <TextBlock Text="Input Pin:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="AddPinCombo" Width="160" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="Trigger:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="AddEdgeCombo" Width="90" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,12,0"
                                          ToolTip="Rising = LOW→HIGH&#x0a;Falling = HIGH→LOW&#x0a;Both = any change"/>
                                <TextBlock Text="Severity:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="AddSeverityCombo" Width="120" FontFamily="Consolas" FontSize="11"
                                          ToolTip="Critical = blocking popup + RED&#x0a;Warning = ORANGE, no popup"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Title:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AddTitleBox" Width="180" FontFamily="Consolas" FontSize="11"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#333333" Padding="4,2"
                                         Margin="0,0,12,0"/>
                                <TextBlock Text="Message:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AddMessageBox" Width="300" FontFamily="Consolas" FontSize="11"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#333333" Padding="4,2"
                                         Margin="0,0,12,0"/>
                                <Button Content="Add" Click="ConfirmAddInput_Click" Padding="12,2"
                                        FontFamily="Consolas" FontSize="11" Foreground="#90EE90" Background="Transparent"
                                        BorderThickness="0" FontWeight="Bold"/>
                                <Button Content="Cancel" Click="CancelAddInput_Click" Padding="8,2"
                                        FontFamily="Consolas" FontSize="11" Foreground="#808080" Background="Transparent"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Watched Inputs Grid -->
                    <DataGrid x:Name="WatchedInputsGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource Theme.BackgroundBrush}"
                              Foreground="{DynamicResource Theme.ForegroundBrush}"
                              RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333"
                              BorderThickness="0" HeadersVisibility="Column"
                              FontFamily="Consolas" FontSize="11" SelectionMode="Single" CanUserSortColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StateColor}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="120"/>
                            <DataGridTextColumn Header="Pin" Binding="{Binding PinName}" Width="120"/>
                            <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="70"/>
                            <DataGridTextColumn Header="State" Binding="{Binding CurrentState}" Width="60"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="70"/>
                            <DataGridTextColumn Header="Alert Title" Binding="{Binding AlertTitle}" Width="140"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding AlertMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Theme.BorderBrush}" ResizeBehavior="PreviousAndNext"/>

                    <!-- Event Log -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontFamily="Consolas" FontSize="11" Foreground="#808080" Margin="8,4">
                            <Run Text="Event Log "/>
                            <Run x:Name="EventCountText" Text=""/>
                        </TextBlock>
                        <DataGrid x:Name="EventLogGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="{DynamicResource Theme.BackgroundBrush}"
                                  Foreground="{DynamicResource Theme.ForegroundBrush}"
                                  RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333"
                                  BorderThickness="0" HeadersVisibility="Column"
                                  FontFamily="Consolas" FontSize="11" SelectionMode="Single" CanUserSortColumns="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="140"/>
                                <DataGridTemplateColumn Header="Sev" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityColor}"
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="120"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 2: Interlocks ═══ -->
            <TabItem Header="Interlocks">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Override toggle + info -->
                    <Border Grid.Row="0" Background="#252526" BorderBrush="#333348" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="OverrideCheck" Content="Override Interlocks" Click="Override_Click"
                                      FontFamily="Consolas" FontSize="11"
                                      Foreground="{DynamicResource Theme.ForegroundBrush}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="When checked, motion is allowed despite interlocks (logged as warning). Resets on app restart."/>
                            <TextBlock x:Name="OverrideStatusText" Text="" FontFamily="Consolas" FontSize="11"
                                       Foreground="#808080" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="|" FontFamily="Consolas" FontSize="11"
                                       Foreground="#404040" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="InterlockSummaryText" Text="No rules configured" FontFamily="Consolas"
                                       FontSize="11" Foreground="#808080" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Add/Remove/Save buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4">
                        <Button Content="+ Add Rule" Click="AddInterlockRule_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#87CEEB" Background="Transparent" BorderThickness="0"/>
                        <Button Content="- Remove" Click="RemoveInterlockRule_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#FF6347" Background="Transparent" BorderThickness="0"/>
                        <Button Content="Save Config" Click="SaveInterlockConfig_Click" Padding="6,2"
                                FontFamily="Consolas" FontSize="11" Foreground="#DCDCAA" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Add Rule Form (collapsible) -->
                    <Border x:Name="AddRuleForm" Grid.Row="2" Visibility="Collapsed"
                            Background="#252526" BorderBrush="#333348" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel>
                            <!-- Row 1: Name + Device -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Name:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="RuleNameBox" Width="180" FontFamily="Consolas" FontSize="11"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#333333" Padding="4,2"
                                         Margin="0,0,12,0"/>
                                <TextBlock Text="Motion Device:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#808080" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RuleDeviceCombo" Width="140" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,0,0"/>
                            </StackPanel>
                            <!-- Row 2: Three clear steps -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="1. Slides:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#87CEEB" VerticalAlignment="Top" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RuleSlidesCombo" Width="200" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,12,0"
                                          ToolTip="Which pneumatic slides must be retracted"/>
                                <TextBlock Text="2. Block:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#87CEEB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RuleAxisBlockCombo" Width="140" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="3. Apply to:" FontFamily="Consolas" FontSize="11"
                                           Foreground="#87CEEB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RuleLayerCombo" Width="160" FontFamily="Consolas" FontSize="11"
                                          Margin="0,0,12,0"/>
                                <Button Content="Add" Click="ConfirmAddRule_Click" Padding="12,2"
                                        FontFamily="Consolas" FontSize="11" Foreground="#90EE90" Background="Transparent"
                                        BorderThickness="0" FontWeight="Bold"/>
                                <Button Content="Cancel" Click="CancelAddRule_Click" Padding="8,2"
                                        FontFamily="Consolas" FontSize="11" Foreground="#808080" Background="Transparent"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Interlock Rules Grid -->
                    <DataGrid x:Name="InterlockRulesGrid" Grid.Row="3"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource Theme.BackgroundBrush}"
                              Foreground="{DynamicResource Theme.ForegroundBrush}"
                              RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333"
                              BorderThickness="0" HeadersVisibility="Column"
                              FontFamily="Consolas" FontSize="11" SelectionMode="Single" CanUserSortColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="200"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="Block Reason" Binding="{Binding BlockReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
