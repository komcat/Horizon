<UserControl x:Class="Horizon.App.ProcessPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">

    <UserControl.Resources>
        <!-- Dark selection for TreeView -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3E3E40"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF1F1F1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF333337"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF1F1F1"/>
        <!-- Dark selection for ListBox -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E3E40"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF333337"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}" Band="0" BandIndex="0">
            <Button Click="New_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    ToolTip="New program">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/new_file_program.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" New" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="Open_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    ToolTip="Open program">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/load_file_generic.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Open" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="Save_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    ToolTip="Save program">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/save_file_generic.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Save" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Delete_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    Foreground="#FF6B68" ToolTip="Delete selected step">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Delete.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Del" FontFamily="Consolas" FontSize="11" Foreground="#FF6B68" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="MoveUp_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    ToolTip="Move step up">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/UpArrow.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Up" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="MoveDown_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    ToolTip="Move step down">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/DownArrow.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Dn" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="RunBtn" Click="Run_Click" Padding="10,3" FontFamily="Consolas" FontSize="11"
                    FontWeight="Bold" ToolTip="Run sequence">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Run.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Run" Foreground="#00CC00" FontWeight="Bold" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="StopBtn" Click="Stop_Click" Padding="10,3" FontFamily="Consolas" FontSize="11"
                    IsEnabled="False" ToolTip="Stop execution">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Stop.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Stop" Foreground="#FF4444" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <Image Source="pack://application:,,,/Assets/StepMode.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,4,0"/>
                <CheckBox x:Name="StepModeCheck" Content="Step Mode" VerticalAlignment="Center"
                          FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}"/>
            </StackPanel>
            <Button x:Name="ContinueBtn" Click="Continue_Click" Padding="8,3" FontFamily="Consolas" FontSize="11"
                    IsEnabled="False" ToolTip="Continue to next step">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/NextStep.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" Next" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- 3-column body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Col 0: Plugin Catalog -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Plugin Catalog" FontFamily="Consolas" FontSize="11"
                               FontWeight="SemiBold" Padding="6,4"
                               Background="{DynamicResource Theme.MenuBarBrush}"
                               Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                    <Grid DockPanel.Dock="Top">
                        <TextBox x:Name="CatalogSearchBox"
                                 FontFamily="Consolas" FontSize="11"
                                 Padding="4,3" Margin="0"
                                 Background="#FF2D2D30" Foreground="#FFFFD700"
                                 BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1"
                                 TextChanged="CatalogSearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721; Search plugins..."
                                   FontFamily="Segoe MDL2 Assets, Consolas" FontSize="11"
                                   Foreground="#FF808080" Padding="6,4"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CatalogSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TreeView x:Name="CatalogTree" Background="{DynamicResource Theme.BackgroundBrush}"
                              Foreground="{DynamicResource Theme.ForegroundBrush}"
                              FontFamily="Consolas" FontSize="11"
                              BorderThickness="0"
                              MouseDoubleClick="CatalogTree_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderBrush}"/>

            <!-- Col 2: Builder List + Context Watch -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="150" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Build Steps -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="4,4,4,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Build Steps" FontFamily="Consolas" FontSize="11"
                                   FontWeight="SemiBold" Padding="6,4"
                                   Background="{DynamicResource Theme.MenuBarBrush}"
                                   Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                        <ListBox x:Name="BuilderList" Background="{DynamicResource Theme.BackgroundBrush}"
                                 Foreground="{DynamicResource Theme.ForegroundBrush}"
                                 FontFamily="Consolas" FontSize="11"
                                 BorderThickness="0"
                                 SelectionMode="Extended"
                                 SelectionChanged="BuilderList_SelectionChanged"
                                 PreviewKeyDown="BuilderList_KeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ToggleEnableMenuItem" Click="ToggleEnable_Click"
                                              Header="Enable/Disable" FontFamily="Consolas" FontSize="11"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Theme.BorderBrush}"/>

                <!-- Context Watch -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="4,0,4,4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{DynamicResource Theme.MenuBarBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Context Watch" FontFamily="Consolas" FontSize="11"
                                       FontWeight="SemiBold" Padding="6,4"
                                       Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                            <TextBlock x:Name="WatchCountText" Grid.Column="1" Text="" FontFamily="Consolas" FontSize="11"
                                       Padding="6,4" Foreground="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                        </Grid>
                        <DataGrid x:Name="WatchGrid"
                                  Background="{DynamicResource Theme.BackgroundBrush}"
                                  Foreground="{DynamicResource Theme.ForegroundBrush}"
                                  FontFamily="Consolas" FontSize="11"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionUnit="FullRow"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource Theme.MenuBarBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="True">
                                            <Setter Property="Background" Value="#4A4A20"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5B9BD5"/>
                                            <Setter Property="Padding" Value="4,1"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="4,1"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="4,1"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderBrush}"/>

            <!-- Col 4: Property Editor -->
            <Border Grid.Column="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Properties" FontFamily="Consolas" FontSize="11"
                               FontWeight="SemiBold" Padding="6,4"
                               Background="{DynamicResource Theme.MenuBarBrush}"
                               Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                    <ContentPresenter x:Name="PropertyHost"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.MenuBarBrush}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                <TextBlock x:Name="StepCountText" Grid.Column="1" Text="0 steps" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource Theme.ForegroundDisabledBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
