<UserControl x:Class="Horizon.App.JogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.BackgroundBrush}"
             Foreground="{DynamicResource Theme.ForegroundBrush}"
             Focusable="True"
             KeyDown="OnKeyDown">

    <UserControl.Resources>
        <!-- Checkable device/step toggle button -->
        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="#FF3A3A3A"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D8387"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF14FFEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Jog direction button -->
        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#FF3A3A3A"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF28A745"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5CB85C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT COLUMN: Device + Step Size ═══ -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">

            <!-- Device selector -->
            <TextBlock Text="DEVICE" Style="{StaticResource SectionHeader}"/>
            <Border Background="{DynamicResource Theme.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="4" Margin="0,0,0,10">
                <WrapPanel x:Name="DevicePanel"/>
            </Border>

            <!-- Step size selector -->
            <TextBlock Text="STEP SIZE" Style="{StaticResource SectionHeader}"/>
            <TextBlock x:Name="StepLabel" Text="⚙ 10 µm"
                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                       Foreground="#FF14FFEC" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource Theme.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="2">
                <UniformGrid x:Name="StepPanel" Columns="2"/>
            </Border>

            <!-- Keyboard hint -->
            <Border Margin="0,10,0,0" Background="{DynamicResource Theme.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="6,4">
                <StackPanel>
                    <TextBlock x:Name="KeyboardIndicator"
                               Text="⌨ Keyboard: INACTIVE"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FF555555" Margin="0,0,0,4"/>
                    <TextBlock FontFamily="Consolas" FontSize="9"
                               Foreground="{DynamicResource Theme.ForegroundDisabledBrush}"
                               TextWrapping="Wrap">
                        <Run Text="W/S = Y  A/D = X"/>
                        <LineBreak/>
                        <Run Text="R/F = Z  Q/E = Step"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ RIGHT COLUMN: Jog Controls + Quick Access ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">

            <!-- XYZ Section -->
            <TextBlock Text="XYZ MOVEMENT" Style="{StaticResource SectionHeader}"/>
            <Border Background="{DynamicResource Theme.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <!-- Crosshair: Y-, X-/X+, Y+ -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Y- (top center) -->
                        <Button x:Name="BtnYMinus" Grid.Row="0" Grid.Column="1" Style="{StaticResource JogBtn}"
                                Content="Y-" Tag="Y,-1" Click="Jog_Click" Margin="2"/>

                        <!-- X- (middle left) -->
                        <Button x:Name="BtnXMinus" Grid.Row="1" Grid.Column="0" Style="{StaticResource JogBtn}"
                                Content="X-" Tag="X,-1" Click="Jog_Click" Margin="2"/>

                        <!-- Center indicator -->
                        <Border Grid.Row="1" Grid.Column="1" Width="48" Height="40" Margin="2"
                                Background="#FF2A2A2A" BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="14" Foreground="#FF14FFEC"/>
                        </Border>

                        <!-- X+ (middle right) -->
                        <Button x:Name="BtnXPlus" Grid.Row="1" Grid.Column="2" Style="{StaticResource JogBtn}"
                                Content="X+" Tag="X,1" Click="Jog_Click" Margin="2"/>

                        <!-- Y+ (bottom center) -->
                        <Button x:Name="BtnYPlus" Grid.Row="2" Grid.Column="1" Style="{StaticResource JogBtn}"
                                Content="Y+" Tag="Y,1" Click="Jog_Click" Margin="2"/>
                    </Grid>

                    <!-- Z row (below crosshair) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="BtnZMinus" Style="{StaticResource JogBtn}" Content="Z-" Tag="Z,-1" Click="Jog_Click" Margin="2"/>
                        <Button x:Name="BtnZPlus"  Style="{StaticResource JogBtn}" Content="Z+" Tag="Z,1"  Click="Jog_Click" Margin="2"/>
                    </StackPanel>

                    <!-- XYZ Position readout -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="PosX" Text="X: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC" Margin="0,0,12,0"/>
                        <TextBlock x:Name="PosY" Text="Y: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC" Margin="0,0,12,0"/>
                        <TextBlock x:Name="PosZ" Text="Z: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- UVW Section -->
            <TextBlock x:Name="UvwHeader" Text="UVW ROTATION" Style="{StaticResource SectionHeader}"
                       Visibility="Collapsed"/>
            <Border x:Name="UvwSection" Visibility="Collapsed"
                    Background="{DynamicResource Theme.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <!-- U row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnUMinus" Style="{StaticResource JogBtn}" Content="U-" Tag="U,-1" Click="Jog_Click" Margin="2"/>
                        <Button x:Name="BtnUPlus"  Style="{StaticResource JogBtn}" Content="U+" Tag="U,1"  Click="Jog_Click" Margin="2"/>
                        <TextBlock x:Name="PosU" Text="U: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- V row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnVMinus" Style="{StaticResource JogBtn}" Content="V-" Tag="V,-1" Click="Jog_Click" Margin="2"/>
                        <Button x:Name="BtnVPlus"  Style="{StaticResource JogBtn}" Content="V+" Tag="V,1"  Click="Jog_Click" Margin="2"/>
                        <TextBlock x:Name="PosV" Text="V: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- W row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnWMinus" Style="{StaticResource JogBtn}" Content="W-" Tag="W,-1" Click="Jog_Click" Margin="2"/>
                        <Button x:Name="BtnWPlus"  Style="{StaticResource JogBtn}" Content="W+" Tag="W,1"  Click="Jog_Click" Margin="2"/>
                        <TextBlock x:Name="PosW" Text="W: ---" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF14FFEC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Interlock override -->
            <CheckBox x:Name="InterlockOverrideCheck" Content="Interlock Override (teach mode)"
                      FontFamily="Consolas" FontSize="11" Foreground="#DCDCAA"
                      Margin="0,6,0,2" Click="InterlockOverride_Click"
                      ToolTip="Allow jog motion even when interlocks are active (e.g. slides extended during teaching)"/>

            <!-- STOP button -->
            <Button x:Name="StopButton" Content="STOP ALL" Height="32" Margin="0,4,0,0"
                    FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                    Foreground="White" Cursor="Hand" Click="StopAll_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFCC3333"
                                BorderBrush="#FFFF4444" BorderThickness="1" CornerRadius="3" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEE4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF991111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ═══ Quick Access Tabs ═══ -->
        <TabControl Grid.Row="1" Margin="0,8,0,0"
                    Background="{DynamicResource Theme.BackgroundBrush}"
                    FontFamily="Consolas" FontSize="11"
                    Foreground="{DynamicResource Theme.ForegroundBrush}">

            <!-- Pneumatic tab -->
            <TabItem Header="Pneumatic">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PneumaticButtonPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>

            <!-- IO Output tab -->
            <TabItem Header="IO Output">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IOOutputButtonPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>

            <!-- Camera tab -->
            <TabItem Header="Camera">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CameraSettingsPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</UserControl>
