<Window x:Class="Horizon.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
    Title="Top View &amp; Chart" Width="960" Height="720"
    WindowStartupLocation="CenterScreen"
    Background="#FF1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Camera:" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="0,0,6,0"/>
                <ComboBox x:Name="CameraCombo" Width="200" FontFamily="Consolas" FontSize="11"
                          SelectionChanged="CameraCombo_SelectionChanged"/>
                <Button x:Name="StartStopButton" Content="Start" Padding="10,3" Margin="8,0,0,0"
                        Click="StartStop_Click"/>
                <CheckBox x:Name="ChartCheckBox" Content="Show Chart" Foreground="#FFCCCCCC"
                          VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"
                          Checked="ChartCheckBox_Changed" Unchecked="ChartCheckBox_Changed"/>
                <CheckBox x:Name="CrosshairCheckBox" Content="Crosshair" Foreground="#FFCCCCCC"
                          VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="False"
                          Checked="CrosshairCheckBox_Changed" Unchecked="CrosshairCheckBox_Changed"/>
                <CheckBox x:Name="ClickToMoveCheckBox" Content="Click to Move" Foreground="#FFCCCCCC"
                          VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="False"
                          Checked="ClickToMoveCheckBox_Checked" Unchecked="ClickToMoveCheckBox_Unchecked"/>
                <TextBlock Text="Measurement:" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="16,0,6,0"/>
                <ComboBox x:Name="MeasCombo" Width="180" FontFamily="Consolas" FontSize="11"
                          SelectionChanged="MeasCombo_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Z Jog toolbar -->
        <Border Grid.Row="1" Background="#FF252528" Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Z Jog:" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="0,0,6,0"/>
                <Button x:Name="ZMinusButton" Content="Z-" FontFamily="Consolas" FontSize="11"
                        FontWeight="Bold" Padding="8,2" Margin="0,0,4,0" Click="ZMinus_Click"/>
                <Button x:Name="ZPlusButton" Content="Z+" FontFamily="Consolas" FontSize="11"
                        FontWeight="Bold" Padding="8,2" Margin="0,0,8,0" Click="ZPlus_Click"/>
                <TextBlock Text="Step:" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="0,0,6,0"/>
                <ComboBox x:Name="JogStepCombo" Width="90" FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="ZPositionText" Text="" Foreground="#FF80FF80" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- SkiaSharp render surface -->
        <skia:SKElement x:Name="SkiaCanvas" Grid.Row="2" PaintSurface="SkiaCanvas_PaintSurface"
                        MouseMove="SKElement_MouseMove"
                        MouseLeftButtonDown="SKElement_MouseLeftButtonDown"
                        MouseLeave="SKElement_MouseLeave"/>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#FF2D2D30" Padding="6,3">
            <TextBlock x:Name="StatusText" Text="Idle" Foreground="#FF999999"
                       FontFamily="Consolas" FontSize="10"/>
        </Border>
    </Grid>
</Window>
