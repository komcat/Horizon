<UserControl x:Class="Horizon.App.MotionPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HeaderText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect" Padding="10,3" Margin="0,0,6,0" Click="Connect_Click"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Padding="10,3" Margin="0,0,6,0" Click="Disconnect_Click"/>
                <Button x:Name="StopAllButton" Content="Stop All" Padding="10,3" Click="StopAll_Click"
                        Foreground="White" Background="#C62828"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Status line -->
        <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="11" FontFamily="Consolas"
                   Foreground="{DynamicResource Theme.ForegroundDisabledBrush}" Margin="0,4,0,8"/>

        <!-- Row 2: Axis table -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Column header -->
                <Border Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Axis" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                        <TextBlock Grid.Column="1" Text="Position" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                        <TextBlock Grid.Column="2" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                        <TextBlock Grid.Column="3" Text="Abs Move" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}"/>
                        <TextBlock Grid.Column="4" Text="Jog" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AxisStack" Margin="4,4,4,4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 3: Jog step size -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="Jog Step:" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,6,0"/>
            <ComboBox x:Name="JogStepCombo" Width="80" FontFamily="Consolas" FontSize="11"
                      Padding="3,2" SelectedIndex="6"/>
        </StackPanel>

        <!-- Row 4: Named positions list -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                Background="{DynamicResource Theme.BackgroundAltBrush}" CornerRadius="2"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with Move button -->
                <Border Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}" Padding="6,4">
                    <Grid>
                        <TextBlock Text="Named Positions" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.ForegroundBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="PresetMoveButton" Content="Move" Padding="10,3" HorizontalAlignment="Right"
                                Click="PresetMove_Click"/>
                    </Grid>
                </Border>

                <!-- Position list -->
                <DataGrid x:Name="PresetGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="{DynamicResource Theme.BackgroundAltBrush}"
                          Foreground="{DynamicResource Theme.ForegroundBrush}"
                          RowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                          AlternatingRowBackground="{DynamicResource Theme.BackgroundBrush}"
                          BorderThickness="0"
                          FontFamily="Consolas" FontSize="11"
                          MouseDoubleClick="PresetGrid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource Theme.MenuBarBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="70"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="70"/>
                        <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="70"/>
                        <DataGridTextColumn Header="Dist" Binding="{Binding Distance}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
