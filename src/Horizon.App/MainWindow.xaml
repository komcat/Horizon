<Window x:Class="Horizon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonDockTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        mc:Ignorable="d"
        Title="Horizon" Height="700" Width="1100"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">
    <Window.Resources>
        <!-- Top-level header menu item template -->
        <ControlTemplate x:Key="TopLevelHeaderMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="Transparent" Padding="6,3">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Theme.MenuPopupBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1"
                                Padding="0,2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.MenuPopupBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Submenu item template -->
        <ControlTemplate x:Key="SubMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="Transparent" Padding="24,4,24,4" MinWidth="140">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Submenu header template (for menu items that have children, e.g. Hardware) -->
        <ControlTemplate x:Key="SubMenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="Transparent" Padding="24,4,24,4" MinWidth="140">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"/>
                    <Path Grid.Column="1" Data="M0,0 L4,3.5 L0,7 Z"
                          Fill="{DynamicResource Theme.ForegroundBrush}"
                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Right"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade"
                           HorizontalOffset="-2">
                        <Border Background="{DynamicResource Theme.MenuPopupBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1"
                                Padding="0,2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Separator style -->
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="24,2,4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{DynamicResource Theme.BorderBrush}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0"
              Background="{DynamicResource Theme.MenuBarBrush}"
              Foreground="{DynamicResource Theme.ForegroundBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="E_xit" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Camera" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Config" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraConfig_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_Discover" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraDiscover_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="Connect _All" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraConnectAll_Click"/>
                <MenuItem Header="Disconnect A_ll" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraDisconnectAll_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Hardware Panel" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="ViewHardware_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_Output" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="ViewOutput_Click"/>
            </MenuItem>
            <MenuItem Header="_Production" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Top View &amp; Chart" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="TopViewChart_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_Process Editor" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="ProcessEditor_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_Teach Points" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="TeachPointPanel_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Expression Syntax" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="HelpExpressionSyntax_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_About" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}"/>
            </MenuItem>
        </Menu>

        <!-- Quick-Access Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.MenuBarBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel x:Name="QuickAccessBar" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="QuickBtn" TargetType="Button">
                        <Setter Property="Width" Value="70"/>
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource Theme.BackgroundAltBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="2"
                                            Padding="4,2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button Style="{StaticResource QuickBtn}" Content="Run" Click="QuickButton_Click" Tag="0"/>
                <Button Style="{StaticResource QuickBtn}" Click="QuickButton_Click" Tag="1"/>
                <Button Style="{StaticResource QuickBtn}" Content="Process" Click="ProcessEditor_Click"/>
                <Button Style="{StaticResource QuickBtn}" Content="Jog" Click="JogPanel_Click"/>
                <Button Style="{StaticResource QuickBtn}" Content="Teach" Click="TeachPointPanel_Click"/>
                <Button Style="{StaticResource QuickBtn}" Click="QuickButton_Click" Tag="5"/>
                <Button Style="{StaticResource QuickBtn}" Click="QuickButton_Click" Tag="6"/>
                <Button Style="{StaticResource QuickBtn}" Content="Hardware" Click="ViewHardware_Click"/>
            </StackPanel>
        </Border>

        <!-- AvalonDock DockingManager -->
        <avalonDock:DockingManager Grid.Row="2" x:Name="DockManager">
            <avalonDock:DockingManager.Theme>
                <avalonDockTheme:Vs2013DarkTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- Center: Document area -->
                    <avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocument Title="Welcome" ContentId="welcome">
                            <TextBlock Text="Welcome to Horizon"
                                       FontSize="18"
                                       Foreground="{DynamicResource Theme.ForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>

                    <!-- Right: Hardware tree + Camera Config -->
                    <avalonDock:LayoutAnchorablePaneGroup DockWidth="300" Orientation="Vertical">
                        <avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorable Title="Hardware" ContentId="hardware" CanClose="False">
                            <Border Background="{DynamicResource Theme.BackgroundAltBrush}">
                                <TreeView x:Name="HardwareTree"
                                          Background="{DynamicResource Theme.BackgroundAltBrush}"
                                          Foreground="{DynamicResource Theme.ForegroundBrush}"
                                          BorderThickness="0">
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                                        </Style>
                                    </TreeView.Resources>
                                    <TreeViewItem x:Name="CamerasTreeItem" Header="Cameras" IsExpanded="True"/>
                                    <TreeViewItem x:Name="MotionTreeItem" Header="Motion" IsExpanded="True"/>
                                    <TreeViewItem x:Name="IOTreeItem" Header="IO" IsExpanded="True"/>
                                    <TreeViewItem x:Name="PneumaticTreeItem" Header="Pneumatic" IsExpanded="True"/>
                                    <TreeViewItem x:Name="CurrentMeasTreeItem" Header="Current Measurement" IsExpanded="True"/>
                                    <TreeViewItem x:Name="LaserControllerTreeItem" Header="Laser Controller" IsExpanded="True"/>
                                </TreeView>
                            </Border>
                        </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorable Title="Camera Config" ContentId="cameraConfig" CanClose="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Theme.BackgroundBrush}">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <TextBlock Grid.Row="0" Text="Registered Cameras" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>

                                        <!-- DataGrid -->
                                        <DataGrid x:Name="ConfigDataGrid" Grid.Row="1"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                                  SelectionMode="Single" SelectionUnit="FullRow"
                                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                                  Background="{DynamicResource Theme.BackgroundAltBrush}"
                                                  Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                  RowBackground="{DynamicResource Theme.BackgroundAltBrush}"
                                                  AlternatingRowBackground="{DynamicResource Theme.BackgroundBrush}"
                                                  BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                  FontFamily="Consolas" FontSize="11"
                                                  MaxHeight="200" Margin="0,0,0,8">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.MenuBarBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                                                    <Setter Property="Padding" Value="4,3"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Padding" Value="4,2"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="70"/>
                                                <DataGridTextColumn Header="SDK" Binding="{Binding SdkType}" Width="45"/>
                                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="90"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="50"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Mount Camera Form -->
                                        <Border Grid.Row="2"
                                                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                                Background="{DynamicResource Theme.BackgroundAltBrush}"
                                                Padding="8" Margin="0,0,0,8" CornerRadius="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Mount Camera" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,6"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,4,3"/>
                                                <TextBox x:Name="MountNameBox" Grid.Row="1" Grid.Column="1"
                                                         Background="{DynamicResource Theme.BackgroundBrush}"
                                                         Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                         BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                         Padding="3,2" Margin="0,0,0,3" FontFamily="Consolas" FontSize="11"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial:" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,4,3"/>
                                                <TextBox x:Name="MountSerialBox" Grid.Row="2" Grid.Column="1"
                                                         Background="{DynamicResource Theme.BackgroundBrush}"
                                                         Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                         BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                         Padding="3,2" Margin="0,0,0,3" FontFamily="Consolas" FontSize="11"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="SDK:" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,4,3"/>
                                                <ComboBox x:Name="MountSdkCombo" Grid.Row="3" Grid.Column="1"
                                                          Margin="0,0,0,3" Padding="3,2" FontFamily="Consolas" FontSize="11"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Conn:" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,4,3"/>
                                                <ComboBox x:Name="MountConnCombo" Grid.Row="4" Grid.Column="1"
                                                          Margin="0,0,0,3" Padding="3,2" FontFamily="Consolas" FontSize="11"/>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="IP:" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,4,3"/>
                                                <TextBox x:Name="MountIpBox" Grid.Row="5" Grid.Column="1"
                                                         Background="{DynamicResource Theme.BackgroundBrush}"
                                                         Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                         BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                         Padding="3,2" Margin="0,0,0,3" FontFamily="Consolas" FontSize="11"/>

                                                <Button x:Name="MountButton" Grid.Row="6" Grid.Column="1"
                                                        Content="Mount" HorizontalAlignment="Right"
                                                        Padding="12,3" Margin="0,3,0,0"
                                                        Click="MountCamera_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Bottom buttons -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Content="Unmount" Padding="8,3" Margin="0,0,6,0"
                                                    Click="UnmountCamera_Click"/>
                                            <Button Content="Rediscover" Padding="8,3"
                                                    Click="RediscoverCameras_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>
                </avalonDock:LayoutPanel>

                <!-- Bottom: Output panel -->
                <avalonDock:LayoutRoot.BottomSide>
                    <avalonDock:LayoutAnchorSide>
                        <avalonDock:LayoutAnchorGroup>
                            <avalonDock:LayoutAnchorable Title="Output" ContentId="output" AutoHideWidth="300" AutoHideHeight="200">
                                <Grid Background="{DynamicResource Theme.BackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Filter toolbar -->
                                    <ToolBar Grid.Row="0" Background="{DynamicResource Theme.MenuBarBrush}" Band="0" BandIndex="0">
                                        <ToggleButton x:Name="FilterInfoToggle" IsChecked="True" Click="FilterInfo_Click"
                                                      Padding="6,2" FontFamily="Consolas" FontSize="11" ToolTip="Show Info messages">
                                            <TextBlock Text="Info" Foreground="#F1F1F1"/>
                                        </ToggleButton>
                                        <ToggleButton x:Name="FilterWarnToggle" IsChecked="True" Click="FilterWarn_Click"
                                                      Padding="6,2" FontFamily="Consolas" FontSize="11" ToolTip="Show Warning messages">
                                            <TextBlock Text="Warn" Foreground="#FFB900"/>
                                        </ToggleButton>
                                        <ToggleButton x:Name="FilterErrorToggle" IsChecked="True" Click="FilterError_Click"
                                                      Padding="6,2" FontFamily="Consolas" FontSize="11" ToolTip="Show Error messages">
                                            <TextBlock Text="Error" Foreground="#FF4444"/>
                                        </ToggleButton>
                                        <Separator/>
                                        <Button Click="ClearLog_Click" Padding="6,2" FontFamily="Consolas" FontSize="11"
                                                ToolTip="Clear log">
                                            <TextBlock><Run FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#FF6B68"/> Clear</TextBlock>
                                        </Button>
                                    </ToolBar>

                                    <!-- Virtualized log list -->
                                    <ListBox x:Name="OutputListBox" Grid.Row="1"
                                             Background="{DynamicResource Theme.BackgroundBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas" FontSize="12"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.Resources>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="Transparent" Padding="2,1"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#FF3E3E40"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#FF333337"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.Resources>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Timestamp, Mode=OneTime}"
                                                         Foreground="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Message, Mode=OneTime}"
                                                         Foreground="{Binding Foreground, Mode=OneTime}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorGroup>
                    </avalonDock:LayoutAnchorSide>
                </avalonDock:LayoutRoot.BottomSide>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
