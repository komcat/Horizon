<Window x:Class="Horizon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonDockTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        mc:Ignorable="d"
        Title="Horizon" Height="700" Width="1100"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Theme.BackgroundBrush}"
        Foreground="{DynamicResource Theme.ForegroundBrush}">
    <Window.Resources>
        <!-- Top-level header menu item template -->
        <ControlTemplate x:Key="TopLevelHeaderMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="Transparent" Padding="6,3">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Theme.MenuPopupBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1"
                                Padding="0,2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.MenuPopupBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Submenu item template -->
        <ControlTemplate x:Key="SubMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Border" Background="Transparent" Padding="24,4,24,4" MinWidth="140">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundDisabledBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Separator style -->
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="24,2,4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{DynamicResource Theme.BorderBrush}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0"
              Background="{DynamicResource Theme.MenuBarBrush}"
              Foreground="{DynamicResource Theme.ForegroundBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="E_xit" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Camera" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Discover" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraDiscover_Click"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="Connect _All" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraConnectAll_Click"/>
                <MenuItem Header="Disconnect A_ll" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="CameraDisconnectAll_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_Hardware" Foreground="{DynamicResource Theme.ForegroundBrush}">
                    <MenuItem Header="_Cameras" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="ViewCameras_Click"/>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="_Output" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}" Click="ViewOutput_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource TopLevelHeaderMenuItemTemplate}">
                <MenuItem Header="_About" Foreground="{DynamicResource Theme.ForegroundBrush}" Template="{StaticResource SubMenuItemTemplate}"/>
            </MenuItem>
        </Menu>

        <!-- AvalonDock DockingManager -->
        <avalonDock:DockingManager Grid.Row="1" x:Name="DockManager">
            <avalonDock:DockingManager.Theme>
                <avalonDockTheme:Vs2013DarkTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- Left: Live Feed panel -->
                    <avalonDock:LayoutAnchorablePane DockWidth="400">
                        <avalonDock:LayoutAnchorable Title="Live Feed" ContentId="liveFeed" CanClose="False">
                            <Grid Background="{DynamicResource Theme.BackgroundAltBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image x:Name="LiveFeedImage" Grid.Row="0" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="LiveFeedStatus" Grid.Row="1"
                                           Text="No feed active"
                                           Foreground="{DynamicResource Theme.ForegroundBrush}"
                                           Padding="4,2" FontSize="11" FontFamily="Consolas"/>
                            </Grid>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <!-- Center: Document area -->
                    <avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocument Title="Welcome" ContentId="welcome">
                            <TextBlock Text="Welcome to Horizon"
                                       FontSize="18"
                                       Foreground="{DynamicResource Theme.ForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>

                    <!-- Right: Camera tree -->
                    <avalonDock:LayoutAnchorablePane DockWidth="250">
                        <avalonDock:LayoutAnchorable Title="Cameras" ContentId="cameras" CanClose="False">
                            <Border Background="{DynamicResource Theme.BackgroundAltBrush}">
                                <TreeView x:Name="CamerasTree"
                                          Background="{DynamicResource Theme.BackgroundAltBrush}"
                                          Foreground="{DynamicResource Theme.ForegroundBrush}"
                                          BorderThickness="0">
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}"/>
                                        </Style>
                                    </TreeView.Resources>
                                    <TreeViewItem x:Name="CamerasTreeItem" Header="Cameras" IsExpanded="True"/>
                                </TreeView>
                            </Border>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel>

                <!-- Bottom: Output panel -->
                <avalonDock:LayoutRoot.BottomSide>
                    <avalonDock:LayoutAnchorSide>
                        <avalonDock:LayoutAnchorGroup>
                            <avalonDock:LayoutAnchorable Title="Output" ContentId="output" AutoHideWidth="300" AutoHideHeight="200">
                                <TextBox x:Name="OutputTextBox"
                                         Background="{DynamicResource Theme.BackgroundBrush}"
                                         Foreground="{DynamicResource Theme.ForegroundBrush}"
                                         FontFamily="Consolas" FontSize="12"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Text="Horizon ready."/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorGroup>
                    </avalonDock:LayoutAnchorSide>
                </avalonDock:LayoutRoot.BottomSide>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
