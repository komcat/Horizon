<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\*.png" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="24050.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Core\Horizon.Core.csproj" />
    <ProjectReference Include="..\Horizon.Process\Horizon.Process.csproj" />
    <ProjectReference Include="..\Horizon.IO\Horizon.IO.csproj" />
    <ProjectReference Include="..\Horizon.Motion\Horizon.Motion.csproj" />
    <ProjectReference Include="..\Horizon.Pneumatic\Horizon.Pneumatic.csproj" />
    <ProjectReference Include="..\Horizon.CurrentMeasurement\Horizon.CurrentMeasurement.csproj" />
    <ProjectReference Include="..\Horizon.LaserController\Horizon.LaserController.csproj" />
  </ItemGroup>

</Project>
