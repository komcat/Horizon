<Window x:Class="Horizon.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" SizeToContent="Height" MinHeight="160" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFF1F1F1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Enter value:" FontSize="12"
                   Foreground="#FFF1F1F1" Margin="0,0,0,8"/>

        <TextBox x:Name="InputBox" Grid.Row="1" FontFamily="Consolas" FontSize="12"
                 Padding="4,3" Margin="0,0,0,12"
                 Background="#FF2D2D30" Foreground="#FFF1F1F1"
                 BorderBrush="#FF3F3F46" BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Padding="4,4" Margin="0,0,8,0"
                    Click="OK_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Padding="4,4"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
