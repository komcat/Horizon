<UserControl x:Class="Horizon.App.PneumaticPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#CCCCCC">

    <StackPanel Margin="8">
        <!-- Header + buttons -->
        <DockPanel Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExtendButton" Content="Extend" Padding="10,3" Margin="0,0,6,0" Click="Extend_Click"/>
                <Button x:Name="RetractButton" Content="Retract" Padding="10,3" Margin="0,0,6,0" Click="Retract_Click"/>
                <Button x:Name="RetractAllButton" Content="Retract All" Padding="10,3" Click="RetractAll_Click"
                        Foreground="White" Background="#C62828"/>
            </StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Status -->
        <TextBlock x:Name="StatusText" FontSize="11" FontFamily="Consolas" Foreground="#888888" Margin="0,0,0,6"/>

        <!-- Position + sensors as simple text lines -->
        <TextBlock x:Name="PositionText" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,4"/>
        <TextBlock x:Name="SensorText" FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" Margin="0,0,0,4"/>
        <TextBlock x:Name="LastMoveText" FontSize="10" FontFamily="Consolas" Foreground="#666666"/>
    </StackPanel>
</UserControl>
