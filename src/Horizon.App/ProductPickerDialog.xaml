<Window x:Class="Horizon.App.ProductPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Product" SizeToContent="Height" MinHeight="200" Width="340"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFF1F1F1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a product:" FontSize="12"
                   Foreground="#FFF1F1F1" Margin="0,0,0,8"/>

        <ListBox x:Name="ProductList" Grid.Row="1" MinHeight="80" MaxHeight="300"
                 FontFamily="Consolas" FontSize="12"
                 Background="#FF2D2D30" Foreground="#FFF1F1F1"
                 BorderBrush="#FF3F3F46" BorderThickness="1"
                 Margin="0,0,0,12"
                 MouseDoubleClick="ProductList_MouseDoubleClick">
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="Foreground" Value="#FFF1F1F1"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF0078D4"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Load" Width="70" Padding="4,4" Margin="0,0,8,0"
                    Click="OK_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Padding="4,4"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
