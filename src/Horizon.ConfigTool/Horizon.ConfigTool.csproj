<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.ConfigTool</RootNamespace>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <!-- Preset catalogs (<domain>_presets.json) ship next to the exe so they can
       be edited to add/change presets without recompiling. -->
  <ItemGroup>
    <None Include="presets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reuses the real config models + symmetric loaders (Phase 0).
       Camera is NOT referenced (it pulls in the Basler/IDS native SDKs); instead
       CameraConfig.cs holds a local mirror of RegisteredCamera and reads/writes
       camera-config.json directly. -->
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
    <ProjectReference Include="..\Horizon.IO\Horizon.IO.csproj" />
    <ProjectReference Include="..\Horizon.Motion\Horizon.Motion.csproj" />
    <ProjectReference Include="..\Horizon.Pneumatic\Horizon.Pneumatic.csproj" />
    <ProjectReference Include="..\Horizon.LaserController\Horizon.LaserController.csproj" />
    <ProjectReference Include="..\Horizon.CurrentMeasurement\Horizon.CurrentMeasurement.csproj" />
    <ProjectReference Include="..\Horizon.Safety\Horizon.Safety.csproj" />
    <ProjectReference Include="..\Horizon.Interlock\Horizon.Interlock.csproj" />
    <ProjectReference Include="..\Horizon.Config\Horizon.Config.csproj" />
  </ItemGroup>

</Project>
