<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>
  <!-- ACS SPiiPlus .NET managed wrapper — check Runtime Kit (NET8) then ADK Suite (NET6) -->
  <PropertyGroup>
    <ACS_DLL_PATH Condition="Exists('C:\Program Files (x86)\ACS Motion Control\SPiiPlus Runtime Kit\Redist\x64\ACS.SPiiPlusNET8.dll')">C:\Program Files (x86)\ACS Motion Control\SPiiPlus Runtime Kit\Redist\x64\ACS.SPiiPlusNET8.dll</ACS_DLL_PATH>
    <ACS_DLL_PATH Condition="'$(ACS_DLL_PATH)' == '' AND Exists('C:\Program Files (x86)\ACS Motion Control\SPiiPlus ADK Suite v3.13.01\SPiiPlus .NET Library\ACS.SPiiPlusNET6.dll')">C:\Program Files (x86)\ACS Motion Control\SPiiPlus ADK Suite v3.13.01\SPiiPlus .NET Library\ACS.SPiiPlusNET6.dll</ACS_DLL_PATH>
    <HAS_ACS Condition="'$(ACS_DLL_PATH)' != ''">true</HAS_ACS>
  </PropertyGroup>
  <ItemGroup Condition="'$(HAS_ACS)' == 'true'">
    <Reference Include="ACS.SPiiPlusNET">
      <HintPath>$(ACS_DLL_PATH)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(HAS_ACS)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_ACS_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HAS_ACS)' != 'true'">
    <Compile Remove="Adapters\ACSMotionController.cs" />
    <Compile Remove="Adapters\ACSControllerManager.cs" />
  </ItemGroup>
  <!-- PI GCS2 native DLL copied to output -->
  <ItemGroup>
    <None Include="C:\Program Files (x86)\Physik Instrumente (PI)\Software Suite\Development\C#\API\PI_GCS2_DLL_x64.dll" CopyToOutputDirectory="PreserveNewest" Link="PI_GCS2_DLL_x64.dll" Condition="Exists('C:\Program Files (x86)\Physik Instrumente (PI)\Software Suite\Development\C#\API\PI_GCS2_DLL_x64.dll')" />
  </ItemGroup>
</Project>
