<Window x:Class="FAAM.UI.JogPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FAAM.UI.Views"
        Title="FAAM"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <StackPanel Margin="16,14">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource Text}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- The reusable jog pad — configured from the step's request. -->
            <v:JogPad x:Name="Pad" />

            <TextBlock x:Name="ElapsedText" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ContinueButton" Grid.Column="0" Content="Continue" Height="32"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="OnContinue" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Height="32"
                        Cursor="Hand" Click="OnCancel" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
