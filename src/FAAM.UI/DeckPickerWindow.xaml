<Window x:Class="FAAM.UI.DeckPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Deck"
        Height="440" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a deck to load into the editor."
                   Foreground="{StaticResource Subtle}" FontSize="12" Margin="2,0,0,8" />

        <DataGrid x:Name="DeckGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="Transparent" RowBackground="Transparent" Foreground="{StaticResource Text}"
                  BorderThickness="1" BorderBrush="{StaticResource Edge}" CanUserAddRows="False"
                  SelectionMode="Single" FontSize="13" MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Deck" Binding="{Binding Deck}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                <DataGridTextColumn Header="Last commit" Binding="{Binding LastCommit}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Load" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="OnLoad" />
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
