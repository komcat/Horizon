<Window x:Class="FAAM.UI.StationStateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource PromptBg}">
    <Border x:Name="FrameBorder" BorderBrush="{StaticResource PromptEdge}" BorderThickness="3">
        <StackPanel Margin="30,26">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource PromptTitle}" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource PromptText}" FontSize="16"
                       TextWrapping="Wrap" Margin="0,0,0,18" />

            <TextBlock Text="Engineer / technician name" Foreground="{StaticResource PromptText}" FontSize="15" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Height="42" FontSize="20" VerticalContentAlignment="Center" Margin="0,0,0,14"
                     KeyDown="OnNameKeyDown" />

            <TextBlock x:Name="NoteLabel" Foreground="{StaticResource PromptText}" FontSize="15" Margin="0,0,0,4" />
            <TextBox x:Name="NoteBox" Height="64" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorText" Foreground="#FFCDD2" FontSize="14" Margin="0,0,0,8" Visibility="Collapsed"
                       Text="Enter your name to confirm." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Width="138" Height="45" FontSize="18" Margin="0,0,12,0" IsCancel="True" />
                <Button x:Name="OkButton" Width="180" Height="45" FontSize="18" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
