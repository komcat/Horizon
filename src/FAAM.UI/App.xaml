<Application x:Class="FAAM.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="urn:horizon-station-ui"
             xmlns:vms="clr-namespace:FAAM.UI.ViewModels.Sections"
             xmlns:vsec="clr-namespace:FAAM.UI.Views.Sections"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Horizon.Station.UI;component/Themes/StationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Section view resolution: the Machine page binds a section view
                 model; WPF picks the matching view. -->
            <DataTemplate DataType="{x:Type st:StatusSectionViewModel}">
                <st:StatusSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type st:PlaceholderSectionViewModel}">
                <st:PlaceholderSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SmuSectionViewModel}">
                <vsec:SmuSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MeasurementSectionViewModel}">
                <vsec:MeasurementSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:IoSectionViewModel}">
                <vsec:IoSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:IoWatchSectionViewModel}">
                <vsec:IoWatchSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PneumaticSectionViewModel}">
                <vsec:PneumaticSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MotionSectionViewModel}">
                <vsec:MotionSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:LaserSectionViewModel}">
                <vsec:LaserSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:TecSectionViewModel}">
                <vsec:TecSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PowerSupplySectionViewModel}">
                <vsec:PowerSupplySectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:CameraSectionViewModel}">
                <vsec:CameraSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SettingsSectionViewModel}">
                <vsec:SettingsSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:DeviceRegistrationSectionViewModel}">
                <vsec:DeviceRegistrationSectionView />
            </DataTemplate>

            <!-- FAAM's Machine › Settings panels (IStationHead.CreateSettingsPanels). -->
            <DataTemplate DataType="{x:Type vms:StartCorrectionSettingsViewModel}">
                <vsec:StartCorrectionSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:ScanPanelSettingsViewModel}">
                <vsec:ScanPanelSettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
