<Application x:Class="FAAM.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:FAAM.UI.Mvvm"
             xmlns:vms="clr-namespace:FAAM.UI.ViewModels.Sections"
             xmlns:vsec="clr-namespace:FAAM.UI.Views.Sections"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <mvvm:BoolToBrushConverter x:Key="BoolToBrush" />
            <mvvm:BoolToStatusTextConverter x:Key="BoolToStatusText" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Theme palette — bound to Windows SystemColors so FAAM follows the
                 user's system colours/accent. Colours track via DynamicResource,
                 so a system colour change updates the running app. -->
            <SolidColorBrush x:Key="Bg"       Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
            <SolidColorBrush x:Key="Panel"    Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
            <SolidColorBrush x:Key="Text"     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
            <SolidColorBrush x:Key="Subtle"   Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
            <SolidColorBrush x:Key="Edge"     Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}" />
            <SolidColorBrush x:Key="Accent"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
            <SolidColorBrush x:Key="OnAccent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

            <!-- Fixed status colours — semantic, intentionally theme-independent. -->
            <SolidColorBrush x:Key="Danger" Color="#E74C3C" />
            <SolidColorBrush x:Key="Warn"   Color="#FFB74D" />
            <SolidColorBrush x:Key="Ok"     Color="#81C784" />
            <SolidColorBrush x:Key="Running" Color="#FFF176" />

            <!-- Fixed video-surface colours — theme-independent so overlays stay
                 high-contrast on arbitrary camera images. -->
            <SolidColorBrush x:Key="VideoBg"   Color="Black" />
            <SolidColorBrush x:Key="Overlay"   Color="#AA000000" />
            <SolidColorBrush x:Key="Crosshair" Color="#CCFFD500" />
            <SolidColorBrush x:Key="Roi"       Color="#FFD500" />

            <!-- Fixed operator-prompt colours (SerialEntryWindow / OperatorPromptWindow) —
                 a solid blue popup so a run prompt stands out from the page behind it. -->
            <SolidColorBrush x:Key="PromptBg"    Color="#0D47A1" />
            <SolidColorBrush x:Key="PromptEdge"  Color="#90CAF9" />
            <SolidColorBrush x:Key="PromptTitle" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PromptText"  Color="#E3F2FD" />

            <!-- Fixed alert colours (AlertWindow, io.alertBuzzer) — a warm yellow notice
                 with dark text, distinct from the blue question prompts. -->
            <SolidColorBrush x:Key="AlertBg"    Color="#FFE873" />
            <SolidColorBrush x:Key="AlertEdge"  Color="#F9A825" />
            <SolidColorBrush x:Key="AlertTitle" Color="#3E2A00" />
            <SolidColorBrush x:Key="AlertText"  Color="#4E3B0A" />

            <!-- Raised "3D" button: a top-lit gradient face (system ControlLightLight → Control
                 bevel shades) with a soft drop shadow, a 1px ControlDark edge, an accent-lit hover
                 that lifts the shadow, and a pressed state that inverts the gradient, sinks the
                 shadow and nudges the label down 1px. All bevel colours come from the Windows
                 SystemColors palette (DynamicResource), so it tracks the system theme. -->
            <Style x:Key="Bevel3D" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Margin="3">
                                <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="{DynamicResource {x:Static SystemColors.ControlLightLightColorKey}}" />
                                            <GradientStop Offset="1" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.4" Color="#000000" />
                                    </Border.Effect>
                                    <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
                                                <GradientStop Offset="1" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" />
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="CP" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel}" />
                                    <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Horizontal device picker — a persistent button per device,
                 single-select with the active one highlighted. Used by every
                 Machine-page section in place of a device drop-down. -->
            <Style x:Key="DeviceSelector" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{StaticResource Panel}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="Padding" Value="14,5" />
                            <Setter Property="Margin" Value="0,2,6,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section view resolution: the Machine page binds a section view
                 model; WPF picks the matching view. -->
            <DataTemplate DataType="{x:Type vms:StatusSectionViewModel}">
                <vsec:StatusSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PlaceholderSectionViewModel}">
                <vsec:PlaceholderSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SmuSectionViewModel}">
                <vsec:SmuSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MeasurementSectionViewModel}">
                <vsec:MeasurementSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:IoSectionViewModel}">
                <vsec:IoSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PneumaticSectionViewModel}">
                <vsec:PneumaticSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MotionSectionViewModel}">
                <vsec:MotionSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:LaserSectionViewModel}">
                <vsec:LaserSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:TecSectionViewModel}">
                <vsec:TecSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PowerSupplySectionViewModel}">
                <vsec:PowerSupplySectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:CameraSectionViewModel}">
                <vsec:CameraSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:SettingsSectionViewModel}">
                <vsec:SettingsSectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:DeviceRegistrationSectionViewModel}">
                <vsec:DeviceRegistrationSectionView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
