<Window x:Class="FAAM.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM — Sign In"
        Width="440" SizeToContent="Height" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">
    <Border Margin="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
            BorderThickness="1" CornerRadius="4" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Sign In" Foreground="{StaticResource Accent}"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="Nothing on this station is available until you sign in."
                       Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Level" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,3" />
                <ComboBox x:Name="LevelCombo" Height="32" FontSize="14"
                          SelectionChanged="OnLevelChanged" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Employee number" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,3" />
                <TextBox x:Name="EmployeeBox" Height="32" FontSize="14" VerticalContentAlignment="Center"
                         TextChanged="OnFieldChanged" KeyDown="OnFieldKeyDown" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock x:Name="PasswordLabel" Text="Level password" Foreground="{StaticResource Subtle}"
                           FontSize="12" Margin="0,0,0,3" />
                <PasswordBox x:Name="PasswordBox" Height="32" FontSize="14"
                             PasswordChanged="OnPasswordChanged" KeyDown="OnFieldKeyDown" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{StaticResource Danger}"
                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExitButton" Content="Exit" Width="96" Height="34" Margin="0,0,8,0"
                        Click="OnExit" />
                <Button x:Name="LoginButton" Content="Sign In" Width="120" Height="34"
                        IsDefault="True" Click="OnLogin" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
