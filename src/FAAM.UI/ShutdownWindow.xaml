<Window x:Class="FAAM.UI.ShutdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM — Closing"
        Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="FAAM"
                       Foreground="{StaticResource Accent}" FontSize="34" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Text="Disconnecting hardware"
                       Foreground="{StaticResource Subtle}" FontSize="13" Margin="2,0,0,18" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Shutting down…"
                           Foreground="{StaticResource Text}" FontSize="14" Margin="0,0,0,8" />
                <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" />
            </StackPanel>

            <Border Grid.Row="3" Margin="0,16,0,0"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="{StaticResource Subtle}"
                               FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" Margin="8" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
