<Window x:Class="FAAM.UI.MaintenanceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maintenance history"
        Width="1300" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <Style x:Key="Wrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- Query: date range + free text. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Subtle}" />
                <DatePicker x:Name="FromPicker" Width="130" VerticalContentAlignment="Center" />
                <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource Subtle}" />
                <DatePicker x:Name="ToPicker" Width="130" VerticalContentAlignment="Center" />
                <Button Content="7 days" Width="64" Height="26" Margin="12,0,0,0" Tag="7" Click="OnQuickRange" />
                <Button Content="30 days" Width="64" Height="26" Margin="4,0,0,0" Tag="30" Click="OnQuickRange" />
                <Button Content="1 year" Width="64" Height="26" Margin="4,0,0,0" Tag="365" Click="OnQuickRange" />
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Subtle}" />
                <TextBox x:Name="SearchBox" Width="240" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Matches category, reason, root cause, action taken and names" KeyDown="OnSearchKeyDown" />
                <Button Content="Search" Width="80" Height="26" Margin="6,0,0,0" Click="OnSearch" />
                <Button Content="Export CSV…" Width="100" Height="26" Margin="16,0,0,0" Click="OnExport" />
            </WrapPanel>
        </Border>

        <!-- Summary: count, total, MTTR, longest, by category. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="CategoryText" FontSize="12" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource Subtle}" FontSize="12" Margin="2,6,0,0" />

        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="Transparent" RowBackground="Transparent" Foreground="{StaticResource Text}"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1" CanUserAddRows="False"
                  CanUserResizeRows="False" SelectionMode="Single" FontSize="12.5"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Down" Binding="{Binding Down}" Width="115" />
                <DataGridTextColumn Header="Up" Binding="{Binding Up}" Width="115" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="75" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" ElementStyle="{StaticResource Wrap}" />
                <DataGridTextColumn Header="Reason (at down)" Binding="{Binding Reason}" Width="2*" ElementStyle="{StaticResource Wrap}" />
                <DataGridTextColumn Header="Down by" Binding="{Binding DownBy}" Width="90" ElementStyle="{StaticResource Wrap}" />
                <DataGridTextColumn Header="Root cause" Binding="{Binding RootCause}" Width="2*" ElementStyle="{StaticResource Wrap}" />
                <DataGridTextColumn Header="Action taken" Binding="{Binding ActionTaken}" Width="2*" ElementStyle="{StaticResource Wrap}" />
                <DataGridTextColumn Header="Up by" Binding="{Binding UpBy}" Width="90" ElementStyle="{StaticResource Wrap}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
