<Window x:Class="FAAM.UI.ExposureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <StackPanel Margin="20,18">
            <TextBlock x:Name="HeaderText" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="Exposure (µs) applied before moving to each point. 0 = leave unchanged."
                       Foreground="{StaticResource Subtle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- One label + µs field per point, built in code-behind. -->
            <StackPanel x:Name="Rows" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Width="92" Height="30" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Apply" Width="92" Height="30" FontWeight="SemiBold"
                        IsDefault="True" Click="OnApply" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
