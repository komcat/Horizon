<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 platform version to match the Horizon Layer 3 head — keeps
         WPF package resolution (SkiaSharp etc.) on net8.0-windows, not net462. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FAAM.UI</RootNamespace>
    <AssemblyName>FAAM.UI</AssemblyName>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
    <!-- Release identity. Bump together with the git tag (see deploy/release.ps1,
         which refuses to tag a version that doesn't match this). -->
    <Version>0.6.2</Version>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <FileVersion>0.6.2.0</FileVersion>
    <Product>FAAM.UI</Product>
    <Company>Fabrinet</Company>
    <Description>FAU-attach operator application for the Horizon engine stack.</Description>
    <!-- Program.Main runs the Velopack hook before the generated App.Main (software update). -->
    <StartupObject>FAAM.UI.Program</StartupObject>
  </PropertyGroup>

  <!-- HALCON native bundle — Horizon.Engine references the managed
       MVTec.HalconDotNet (Vision facet), so the executable head must carry the
       native-bundling package or the HALCON DLLs won't be in the output. -->
  <ItemGroup>
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="25110.0.0" />
    <!-- The DUT Data trend chart and the SiPhOG chart (SKElement). -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
    <!-- File logging: persist the UI log + engine/adapter Serilog diagnostics to
         %APPDATA%\Horizon\logs\faam-.log (mirrors Horizon.App's versions). -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Internet software update from GitHub Releases (Home › Version › Update).
         Keep in step with the vpk tool version deploy/release.ps1 packs with. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- A second Layer 3 head: references the Layer 1 engine + Layer 2 workflow
       interfaces only, exactly like Horizon.UI. Never the hardware adapters or
       the legacy Core/Process stack. -->
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
    <!-- The shared station UI this head is built from (docs/station-ui-extraction.md). -->
    <ProjectReference Include="..\Horizon.Station.UI\Horizon.Station.UI.csproj" />
  </ItemGroup>

  <!-- Station-UI namespaces in scope everywhere: the types that moved out of FAAM.UI keep
       resolving where FAAM code used them by their old (enclosing-namespace) names. -->
  <ItemGroup>
    <Using Include="Horizon.Station.UI" />
    <Using Include="Horizon.Station.UI.Mvvm" />
    <Using Include="Horizon.Station.UI.Telemetry" />
    <Using Include="Horizon.Station.UI.Process" />
    <Using Include="Horizon.Station.UI.ViewModels" />
    <Using Include="Horizon.Station.UI.ViewModels.Sections" />
    <Using Include="Horizon.Station.UI.ViewModels.Timeline" />
    <Using Include="Horizon.Station.UI.Views" />
    <Using Include="Horizon.Station.UI.Views.Sections" />
  </ItemGroup>

  <!-- Version history (Home › Version): build\version-info.ps1 captures the current commit
       and the v* release tags into obj\…\version_info.json, embedded as a resource —
       stations run a published zip with no git, so it must be baked in at build time.
       Rewritten only when it changes (incremental build), and never fails the build:
       without git the resource is simply absent and the window falls back to the
       assembly version. -->
  <Target Name="FaamVersionInfo" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <FaamVersionInfoFile>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'version_info.json'))</FaamVersionInfoFile>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\version-info.ps1&quot; -RepoDir &quot;$(MSBuildProjectDirectory)&quot; -OutFile &quot;$(FaamVersionInfoFile)&quot; -Version &quot;$(Version)&quot;"
          ContinueOnError="true" StandardOutputImportance="low" />
    <ItemGroup Condition="Exists('$(FaamVersionInfoFile)')">
      <EmbeddedResource Include="$(FaamVersionInfoFile)" LogicalName="FAAM.UI.version_info.json" />
    </ItemGroup>
  </Target>

</Project>
