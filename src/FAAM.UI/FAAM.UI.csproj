<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 platform version to match the Horizon Layer 3 head — keeps
         WPF package resolution (SkiaSharp etc.) on net8.0-windows, not net462. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FAAM.UI</RootNamespace>
    <AssemblyName>FAAM.UI</AssemblyName>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
    <!-- Release identity. Bump together with the git tag (see deploy/release.ps1,
         which refuses to tag a version that doesn't match this). -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>FAAM.UI</Product>
    <Company>Fabrinet</Company>
    <Description>FAU-attach operator application for the Horizon engine stack.</Description>
  </PropertyGroup>

  <!-- HALCON native bundle — Horizon.Engine references the managed
       MVTec.HalconDotNet (Vision facet), so the executable head must carry the
       native-bundling package or the HALCON DLLs won't be in the output. -->
  <ItemGroup>
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="24050.0.0" />
    <!-- Required by the ported SMU / Measurement chart views (SKElement). -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
    <!-- File logging: persist the UI log + engine/adapter Serilog diagnostics to
         %APPDATA%\Horizon\logs\faam-.log (mirrors Horizon.App's versions). -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Code editor for the .moon script page (syntax highlight + completion). -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <!-- A second Layer 3 head: references the Layer 1 engine + Layer 2 workflow
       interfaces only, exactly like Horizon.UI. Never the hardware adapters or
       the legacy Core/Process stack. -->
  <ItemGroup>
    <ProjectReference Include="..\Horizon.Engine\Horizon.Engine.csproj" />
    <ProjectReference Include="..\Horizon.Workflow\Horizon.Workflow.csproj" />
    <ProjectReference Include="..\Horizon.Common\Horizon.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="assets\" />
    <!-- Embed image assets (teach.png etc.) as WPF resources. -->
    <Resource Include="assets\**\*.png" />
  </ItemGroup>

</Project>
