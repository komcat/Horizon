<Window x:Class="FAAM.UI.OperatorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Bg}">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource Text}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="92" Height="30" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Confirm" Width="92" Height="30" FontWeight="SemiBold"
                        IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
