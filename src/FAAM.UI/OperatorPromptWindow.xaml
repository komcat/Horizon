<Window x:Class="FAAM.UI.OperatorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAAM"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource PromptBg}">
    <Border BorderBrush="{StaticResource PromptEdge}" BorderThickness="2">
        <StackPanel Margin="30,26">
            <TextBlock x:Name="PromptTitle" Foreground="{StaticResource PromptTitle}" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,14" />
            <TextBlock x:Name="PromptMessage" Foreground="{StaticResource PromptText}" FontSize="19.5"
                       TextWrapping="Wrap" Margin="0,0,0,26" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="138" Height="45" FontSize="18" Margin="0,0,12,0" IsCancel="True" />
                <Button Content="Confirm" Width="138" Height="45" FontSize="18" FontWeight="SemiBold"
                        IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
