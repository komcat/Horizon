<UserControl x:Class="FAAM.UI.Views.EngineerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl x:Name="Tabs"
                Background="{StaticResource Bg}"
                BorderBrush="{StaticResource Edge}"
                SelectionChanged="OnTabChanged">
        <TabItem Header="Program">
            <ContentControl x:Name="ProgramHost" />
        </TabItem>
        <TabItem Header="Process Deck">
            <ContentControl x:Name="DeckHost" />
        </TabItem>
        <TabItem Header="Find First Light">
            <ContentControl x:Name="FindFirstLightHost" />
        </TabItem>
        <TabItem Header="Dispensing">
            <ContentControl x:Name="DispenseHost" />
        </TabItem>
    </TabControl>
</UserControl>
