<UserControl x:Class="FAAM.UI.Views.MachinePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- Section rail + section content (engine header + Reconnect live in the
             shell top bar — see ShellWindow). -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding CurrentSection}"
                     Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Text}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1" Content="{Binding CurrentSection}" Margin="10,0,0,0" />
        </Grid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      Background="{StaticResource Panel}" Margin="0,4" />

        <!-- Global log -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,1" TextElement.Foreground="{Binding Color}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontFamily="Consolas" FontSize="11.5" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="Consolas"
                                       FontSize="11.5" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
