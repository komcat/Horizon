<UserControl x:Class="FAAM.UI.Views.DowntimeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Station state (OEE) + the DOWN / UP toggle. Each edge is signed by the engineer /
         technician who declared it (StationStateWindow). -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
            BorderThickness="1" CornerRadius="3" Padding="10,6">
        <DockPanel>
            <Button x:Name="ToggleButton" DockPanel.Dock="Right" Height="30" MinWidth="150" Padding="12,0"
                    FontWeight="Bold" Foreground="White" BorderThickness="0" Click="OnToggle" />
            <Border x:Name="StateChip" CornerRadius="3" Padding="10,3" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="StateText" FontWeight="Bold" FontSize="13" Foreground="Black" />
            </Border>
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                       FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
        </DockPanel>
    </Border>
</UserControl>
