<UserControl x:Class="FAAM.UI.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Bevel3D}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style x:Key="ReserveTile" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Calibration" Foreground="{StaticResource Text}" FontSize="18"
                   FontWeight="SemiBold" Margin="12,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="Camera → Needle"
                    Style="{StaticResource Tile}" Click="OnCameraNeedle" />
            <Button Grid.Row="0" Grid.Column="1" Content="—" Style="{StaticResource ReserveTile}" />
            <Button Grid.Row="1" Grid.Column="0" Content="—" Style="{StaticResource ReserveTile}" />
            <Button Grid.Row="1" Grid.Column="1" Content="—" Style="{StaticResource ReserveTile}" />
        </Grid>
    </Grid>
</UserControl>
