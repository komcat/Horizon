<UserControl x:Class="FAAM.UI.Views.FauPreAlignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PointButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource PointButton}">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Fill" Value="{StaticResource Edge}" />
            <Setter Property="Stroke" Value="{StaticResource Subtle}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2"
            CornerRadius="4" Width="280" VerticalAlignment="Top">
        <StackPanel Margin="10">
            <TextBlock Text="FAU PRE-ALIGN" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />

            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Target offset (master vector) editor. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Target offset" Foreground="{StaticResource Subtle}" FontSize="11" />
                            <TextBlock x:Name="TargetText" Text="100 µm @ 0°" Foreground="{StaticResource Text}"
                                       FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="TargetApplyButton" Grid.Column="1" Content="Apply" Width="64" Height="30"
                                Style="{StaticResource SaveButton}" Margin="0"
                                Click="OnEditDistance" MouseRightButtonUp="OnEditAngle"
                                ToolTip="Left-click: set distance (µm).  Right-click: set angle (deg)." />
                    </Grid>

                    <!-- Collapsible reference-point group (Move to / Save to). -->
                    <Button Click="OnToggleRefPoints" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
                            ToolTip="Show / hide the reference-point buttons">
                        <Grid>
                            <TextBlock Text="Reference points" Foreground="{StaticResource Subtle}" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="RefPointsChevron" Text="▾" Foreground="{StaticResource Subtle}"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <StackPanel x:Name="RefPointsBody">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Move to" Foreground="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ExposureButton" Content="⚙ Exposure" FontSize="10.5" Padding="6,1" Margin="0,0,10,0"
                                    Cursor="Hand" Click="OnEditExposures"
                                    ToolTip="Set the camera exposure (µs) applied before moving to each point (0 = leave unchanged)." />
                            <CheckBox x:Name="LockBox" Content="Lock" Foreground="{StaticResource Subtle}" FontSize="11"
                                      VerticalAlignment="Center" Checked="OnLockChanged" Unchecked="OnLockChanged"
                                      ToolTip="Lock the Move/Save buttons to prevent accidental clicks" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid Columns="2" Rows="2">
                        <Button x:Name="MoveOut1" Style="{StaticResource PointButton}" Content="Out1" Tag="Out1" Margin="0,0,2,4" Click="OnMove" />
                        <Button x:Name="MoveFiber1" Style="{StaticResource PointButton}" Content="Fiber1" Tag="Fiber1" Margin="2,0,0,4" Click="OnMove" />
                        <Button x:Name="MoveOut2" Style="{StaticResource PointButton}" Content="Out2" Tag="Out2" Margin="0,0,2,0" Click="OnMove" />
                        <Button x:Name="MoveFiber2" Style="{StaticResource PointButton}" Content="Fiber2" Tag="Fiber2" Margin="2,0,0,0" Click="OnMove" />
                    </UniformGrid>

                    <TextBlock Text="Save to (teach current pose)" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,4" />
                    <UniformGrid Columns="2" Rows="2">
                        <Button x:Name="SaveOut1" Style="{StaticResource SaveButton}" Content="Out1" Tag="Out1" Margin="0,0,2,4" Click="OnSave" />
                        <Button x:Name="SaveFiber1" Style="{StaticResource SaveButton}" Content="Fiber1" Tag="Fiber1" Margin="2,0,0,4" Click="OnSave" />
                        <Button x:Name="SaveOut2" Style="{StaticResource SaveButton}" Content="Out2" Tag="Out2" Margin="0,0,2,0" Click="OnSave" />
                        <Button x:Name="SaveFiber2" Style="{StaticResource SaveButton}" Content="Fiber2" Tag="Fiber2" Margin="2,0,0,0" Click="OnSave" />
                    </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="StartButton" Content="Start correction" Height="38" Margin="0,0,0,6"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                    FontSize="14" FontWeight="Bold" Cursor="Hand" Click="OnStart" />

            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Text="Idle" Foreground="{StaticResource Text}"
                           TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CaptureButton" Grid.Column="0" Content="Capture Point" Height="48"
                        Background="#E08A1E" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="Bold"
                        Cursor="Hand" IsEnabled="False" Click="OnCapture" />
                <UniformGrid Grid.Column="1" Columns="2" Rows="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="DotOut1" Style="{StaticResource Dot}" />
                    <Ellipse x:Name="DotOut2" Style="{StaticResource Dot}" />
                    <Ellipse x:Name="DotFiber1" Style="{StaticResource Dot}" />
                    <Ellipse x:Name="DotFiber2" Style="{StaticResource Dot}" />
                </UniformGrid>
            </Grid>

            <Button x:Name="ClearButton" Content="Clear" Height="32" Margin="0,0,0,6"
                    Style="{StaticResource PointButton}" Click="OnClear" />

            <Button x:Name="MoveFauButton" Content="Move FAU" Height="44"
                    Background="{StaticResource Ok}" Foreground="White" BorderThickness="0"
                    FontSize="15" FontWeight="Bold" Cursor="Hand" IsEnabled="False" Click="OnMoveFau" />
        </StackPanel>
    </Border>
</UserControl>
