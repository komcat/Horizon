<UserControl x:Class="FAAM.UI.Views.SiphogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vertical 280-wide panel matching its alignment-utility siblings (FAU / Hill
         Climber): accent border, centred title, everything stacked top-to-bottom. -->
    <Border BorderBrush="{StaticResource Accent}"
            BorderThickness="2" CornerRadius="4" Width="280" VerticalAlignment="Top">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Orange while disconnected, green once connected. -->
                <Setter Property="Background" Value="{StaticResource Warn}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Ok}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Margin="10">
            <TextBlock Text="SiPhOG" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />

            <!-- Connect / disconnect — full width. -->
            <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                    Height="32" Margin="0,0,0,8" />

            <!-- Live data rate + SAG/target percentage (traffic-light background). -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataRate}" Foreground="{StaticResource Text}"
                               FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="data rate" Foreground="{StaticResource Subtle}" FontSize="11" />
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="4" Padding="12,4" VerticalAlignment="Center" MinWidth="84">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Bg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SagLevel}" Value="ok">
                                    <Setter Property="Background" Value="{StaticResource Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SagLevel}" Value="warn">
                                    <Setter Property="Background" Value="{StaticResource Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SagLevel}" Value="danger">
                                    <Setter Property="Background" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding SagPercent}" Foreground="Black" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="SAG / target" Foreground="Black" FontSize="10"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SET_CURRENT presets. -->
            <TextBlock Text="Set SLED current" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding ApplyCommand}"
                                Height="30" Margin="0,0,4,4"
                                IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Field / value table — one row per reading, label left + large value right. -->
            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                    Background="{StaticResource Bg}" Padding="8,4" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Subtle}"
                                           FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource Text}"
                                           FontFamily="Consolas" FontSize="19" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Last reply / status -->
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
