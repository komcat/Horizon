<UserControl x:Class="FAAM.UI.Views.ProcessStepsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A process step button — full width, stacked. -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Teach-mode toggle — accent border when armed. -->
        <Style x:Key="TeachToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain icon button (Properties). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="4">
        <DockPanel Margin="8">
            <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Text="FAU ATTACH STEPS"
                       Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />

            <!-- DUT serial + run lifecycle — brackets a traceable, operator-stamped run. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="DUT Serial" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SerialBox" Grid.Column="0" Height="28" FontSize="13"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="StartDutButton" Grid.Column="1" Content="Start" Width="64" Height="28"
                                Margin="6,0,0,0" Click="OnStartDut" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PassButton" Grid.Column="0" Content="PASS" Height="30" Margin="0,0,4,0"
                                Click="OnPass" Background="{StaticResource Ok}" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" IsEnabled="False" />
                        <Button x:Name="FailButton" Grid.Column="1" Content="FAIL" Height="30" Margin="4,0,4,0"
                                Click="OnFail" Background="{StaticResource Danger}" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" IsEnabled="False" />
                        <Button x:Name="ResultsButton" Grid.Column="2" Content="Results" Height="30" Width="72"
                                Click="OnResults" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Process timer — fixed green-on-black device readout. -->
            <Border DockPanel.Dock="Top" Background="Black" CornerRadius="3" Padding="0,6" Margin="0,0,0,8">
                <TextBlock x:Name="TimerText" Text="Process: 00:00:00" Foreground="#33FF33"
                           FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- STOP — full width; halts all motion. -->
            <Button DockPanel.Dock="Top" Content="STOP" Click="OnStop" Height="44" Margin="0,0,0,8"
                    Background="{StaticResource Danger}" Foreground="White" BorderThickness="0"
                    FontSize="16" FontWeight="Bold" Cursor="Hand" />

            <!-- Teach toggle + Properties — a row beneath STOP. -->
            <Grid DockPanel.Dock="Top" Height="40" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0" x:Name="TeachButton" Style="{StaticResource TeachToggle}" Margin="0,0,4,0"
                              ToolTip="Teach mode — when ON, clicking a step teaches its current position; when OFF, clicking runs the step">
                    <Image x:Name="TeachIcon" Stretch="Uniform" Margin="6" />
                </ToggleButton>
                <Button Grid.Column="1" x:Name="PropertiesButton" Style="{StaticResource IconButton}" Click="OnProperties" Margin="4,0,0,0"
                        ToolTip="Step properties — IO pin names, debounce / wait delays, camera exposure, etc. (coming soon)">
                    <Image x:Name="PropertiesIcon" Stretch="Uniform" Margin="6" />
                </Button>
            </Grid>

            <!-- Deck selector — its "Run page" programs become the step buttons below. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Deck" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,3" />
                <ComboBox x:Name="DeckSelector" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="OnDeckSelected"
                          ToolTip="Pick a deck — its programs flagged 'Run page' appear as buttons below" />
            </StackPanel>

            <!-- Step buttons. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StepButton}" Content="{Binding Label}"
                                    Tag="{Binding}" Click="OnStepClick">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Inspect Motion" Click="OnInspectMotion" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
