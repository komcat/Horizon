<UserControl x:Class="FAAM.UI.Views.ProcessStepsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Run-status fills for the step buttons: running = yellow, success = green,
             interrupted/cancel/error = red (idle keeps the default Bg). -->
        <SolidColorBrush x:Key="StatusRunning" Color="#FFD54F" />
        <SolidColorBrush x:Key="StatusSuccess" Color="#66BB6A" />
        <SolidColorBrush x:Key="StatusFailed"  Color="#E74C3C" />

        <!-- A process step button — full width, stacked. Its fill tracks the step's
             run Status (bound from the ProcessStep item): idle = default, Running =
             yellow, Success = green, Failed = red. -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <!-- Bind to the ProcessStep.Status of the item (the button's DataContext). -->
                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusRunning}" />
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusSuccess}" />
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusFailed}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Teach-mode toggle — accent border when armed. -->
        <Style x:Key="TeachToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain icon button (Properties). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="4">
        <DockPanel Margin="8">
            <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Text="FAU ATTACH STEPS"
                       Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />

            <!-- Process timer — fixed green-on-black device readout. -->
            <Border DockPanel.Dock="Top" Background="Black" CornerRadius="3" Padding="0,6" Margin="0,0,0,8">
                <TextBlock x:Name="TimerText" Text="Process: 00:00:00" Foreground="#33FF33"
                           FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- STOP — halts all motion — with the Auto-chain toggle beside it. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <CheckBox x:Name="AutoChainCheck" DockPanel.Dock="Right" Content="Auto-chain"
                          VerticalAlignment="Center" Margin="10,0,2,0" Foreground="{StaticResource Text}"
                          ToolTip="When on, running a deck step auto-continues into the following deck entries whose transition is Auto (after each entry's delay). Stops at a manual entry (Auto off), an entry with a condition, a failed program, the end of the deck, or STOP. Default off." />
                <Button Click="OnStop" Height="44" ToolTip="STOP — halt all motion"
                        Background="{StaticResource Danger}" BorderThickness="0" Cursor="Hand">
                    <Image Source="/assets/stop.png" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
            </DockPanel>

            <!-- Deck selector — its "Run page" programs become the step buttons below. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Deck" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,3" />
                <ComboBox x:Name="DeckSelector" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="OnDeckSelected"
                          ToolTip="Pick a deck — its programs flagged 'Run page' appear as buttons below" />
            </StackPanel>

            <!-- No-deck guidance — shown when no deck drives the steps (built-in fallback in use). -->
            <Border DockPanel.Dock="Top" x:Name="NoDeckBanner" Visibility="Collapsed"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="11"
                           Text="No deck linked to this product — showing built-in fallback steps. Author or clone a deck in Engineer and flag its programs 'Run page' to drive this list." />
            </Border>

            <!-- Step buttons. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StepButton}" Content="{Binding Label}"
                                    Tag="{Binding}" Click="OnStepClick">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Inspect Motion" Click="OnInspectMotion" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
