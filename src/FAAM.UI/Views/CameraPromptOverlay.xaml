<UserControl x:Class="FAAM.UI.Views.CameraPromptOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Rounded, flat, coloured button (template ignores the system chrome so the
             green/red read regardless of theme). -->
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root has NO background, so the empty centre stays click-through: MoveClick / jog on
         the feed still works while the prompt is shown. Only the banner + the two buttons
         are hit-test islands. Collapsed by default. -->
    <Grid x:Name="Root" Visibility="Collapsed">
        <!-- ① / ④  Banner: white text on black, top-centre. -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,43,0,0"
                Background="#D8000000" CornerRadius="3" Padding="12,6" MaxWidth="560">
            <TextBlock x:Name="BannerText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <!-- ② / ⑤  Affirmative (green) — bottom-left. -->
        <Button x:Name="YesButton" Style="{StaticResource OverlayButton}" Content="Yes"
                Background="#2E7D32" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="10" Click="OnYes" />

        <!-- ③ / ⑥  Negative (red) — bottom-right. -->
        <Button x:Name="NoButton" Style="{StaticResource OverlayButton}" Content="No"
                Background="#C0392B" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="10" Click="OnNo" />
    </Grid>
</UserControl>
