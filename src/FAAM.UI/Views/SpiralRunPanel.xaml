<UserControl x:Class="FAAM.UI.Views.SpiralRunPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SpLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SpValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SpBox" TargetType="TextBox">
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2"
            CornerRadius="4" Width="300" VerticalAlignment="Top">
        <StackPanel Margin="10">
            <TextBlock Text="SPIRAL SEARCH (XY)" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,2" />
            <TextBlock Text="Outward square spiral from the current position"
                       Foreground="{StaticResource Subtle}" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" />

            <!-- Live readouts (driven by SpiralSearchEngine events). -->
            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="State" Style="{StaticResource SpLabel}" />
                        <TextBlock x:Name="StateText" Text="Idle" HorizontalAlignment="Right"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Subtle}" />
                    </Grid>

                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="V start" Style="{StaticResource SpLabel}" />
                            <TextBlock x:Name="VStartText" Text="&#8212;" Style="{StaticResource SpValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="V cur" Style="{StaticResource SpLabel}" />
                            <TextBlock x:Name="VCurText" Text="&#8212;" Style="{StaticResource SpValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="V best" Style="{StaticResource SpLabel}" />
                            <TextBlock x:Name="VBestText" Text="&#8212;" Style="{StaticResource SpValue}"
                                       Foreground="{StaticResource Ok}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,2">
                        <TextBlock Text="Points / Radius (µm)" Style="{StaticResource SpLabel}" />
                        <TextBlock x:Name="ProgressText" Text="&#8212;" Style="{StaticResource SpValue}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Best offset X / Y (µm)" Style="{StaticResource SpLabel}" />
                        <TextBlock x:Name="BestOffsetText" Text="&#8212;" Style="{StaticResource SpValue}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="Eff threshold" Style="{StaticResource SpLabel}" />
                        <TextBlock x:Name="ThresholdText" Text="&#8212;" Style="{StaticResource SpValue}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Parameters -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Device" Style="{StaticResource SpLabel}" />
                <TextBox x:Name="DeviceBox" Text="hex-right" Style="{StaticResource SpBox}" Width="120" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Pitch (µm)" Style="{StaticResource SpLabel}" />
                <TextBox x:Name="PitchBox" Text="5.0" Style="{StaticResource SpBox}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Max radius (µm)" Style="{StaticResource SpLabel}" />
                <TextBox x:Name="RadiusBox" Text="50.0" Style="{StaticResource SpBox}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Target V (≥90% exits)" Style="{StaticResource SpLabel}" />
                <TextBox x:Name="TargetBox" Text="0" Style="{StaticResource SpBox}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="Start Spiral" Height="40" Margin="0,0,3,0"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" Click="OnStart" />
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Height="40" Margin="3,0,0,0"
                        Background="#D9534F" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" IsEnabled="False" Click="OnStop" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
