<UserControl x:Class="FAAM.UI.Views.EngineerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FAAM.UI.ViewModels">
    <UserControl.Resources>
        <!-- Cyan selection highlight (mirrors the MoveOn cyan used in RunView). -->
        <SolidColorBrush x:Key="SelectedBlock" Color="#00C8FF" />

        <!-- Palette command button (the StepButton idiom from ProcessStepsPanel). -->
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-block run status text colour. -->
        <Style x:Key="RunStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatus}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Passed">
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Typed parameter field templates + selector. -->
        <DataTemplate x:Key="TextParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NumberParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalContentAlignment="Right" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BoolParam">
            <CheckBox Content="{Binding Label}" Foreground="{StaticResource Text}"
                      Margin="0,2,0,8" IsChecked="{Binding BoolValue}" />
        </DataTemplate>
        <DataTemplate x:Key="ComboParam">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                <ComboBox ItemsSource="{Binding Options}" IsEditable="True"
                          Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>
        <vm:ParamTemplateSelector x:Key="ParamSelector"
                                  Text="{StaticResource TextParam}"
                                  Number="{StaticResource NumberParam}"
                                  Bool="{StaticResource BoolParam}"
                                  Combo="{StaticResource ComboParam}" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Program" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBox Width="200" Margin="8,0,16,0" VerticalAlignment="Center"
                         Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="180" Margin="0,0,12,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" />
                <Button Content="New" Width="56" Height="28" Margin="0,0,6,0" Command="{Binding NewProgramCommand}" />
                <Button Content="Save" Width="56" Height="28" Margin="0,0,24,0" Command="{Binding SaveProgramCommand}" />
                <Button Content="Run" Width="74" Height="28" Margin="0,0,6,0" FontWeight="SemiBold" Command="{Binding RunCommand}" />
                <Button Content="Stop" Width="74" Height="28" Command="{Binding StopCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- ===== THREE COLUMNS ===== -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: command palette -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Commands" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" Margin="2,2,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Subtle}"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PaletteButton}"
                                                            Content="{Binding Display}" Command="{Binding AddCommand}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MIDDLE: flow chart -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,12">
                        <ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Center"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Center" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border x:Name="Box" MinWidth="240" Padding="12,10" CornerRadius="4"
                                                Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                           Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding RunStatus}"
                                                           Style="{StaticResource RunStatusText}" FontSize="11"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="&#x2193;" Foreground="{StaticResource Subtle}" FontSize="18"
                                                   HorizontalAlignment="Center" Margin="0,2" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                     Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectedBlock}" />
                                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Panel}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                        <Button Content="&#x25B2;" Width="34" Height="28" Margin="0,0,4,0" Command="{Binding MoveBlockUpCommand}" />
                        <Button Content="&#x25BC;" Width="34" Height="28" Margin="0,0,4,0" Command="{Binding MoveBlockDownCommand}" />
                        <Button Content="Delete" Width="70" Height="28" Command="{Binding RemoveBlockCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: parameter panel -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,0,0">
                <Grid>
                    <TextBlock Text="Select a block to edit" Foreground="{StaticResource Subtle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoSelectedBlock, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedBlock, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12" DataContext="{Binding SelectedBlock}">
                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <TextBlock Text="Name (optional)" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Visibility="{Binding ShowDevice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Device" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                                <ComboBox Margin="0,0,0,8" ItemsSource="{Binding DeviceOptions}"
                                          SelectedItem="{Binding SelectedDevice}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Params}"
                                          ItemTemplateSelector="{StaticResource ParamSelector}" />

                            <!-- Move-to-Position: recall settings stored on the position. -->
                            <Border Visibility="{Binding HasPositionPreview, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,2,0,10">
                                <StackPanel>
                                    <TextBlock Text="Position recall settings" Foreground="{StaticResource Subtle}" FontSize="11" />
                                    <TextBlock Text="{Binding PositionPreview}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <Button Content="Edit position…" Width="110" Height="26" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Command="{Binding EditPositionCommand}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Inbound delay (ms)" Foreground="{StaticResource Subtle}" Margin="0,4,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding DelayBeforeMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Debounce delay (ms)" Foreground="{StaticResource Subtle}" Margin="0,0,0,2" />
                            <TextBox Margin="0,0,0,8" Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Enabled" Foreground="{StaticResource Text}" IsChecked="{Binding Enabled}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== LOG ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Height="150">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Log" Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold" Margin="2,0,0,4" />
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource Text}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
