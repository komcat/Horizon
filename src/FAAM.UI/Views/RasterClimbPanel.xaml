<UserControl x:Class="FAAM.UI.Views.RasterClimbPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RcLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RcValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RcBox" TargetType="TextBox">
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2"
            CornerRadius="4" Width="300" VerticalAlignment="Top">
        <StackPanel Margin="10">
            <TextBlock Text="RASTER CLIMB (Z + XY)" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,2" />
            <TextBlock x:Name="SubtitleText"
                       Text="Step Z+, search the XY plane, move to its max. Repeat until the target fraction of SAG."
                       Foreground="{StaticResource Subtle}" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" />

            <!-- Live readouts (driven by RasterClimbEngine events). -->
            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="State" Style="{StaticResource RcLabel}" />
                        <TextBlock x:Name="StateText" Text="Idle" HorizontalAlignment="Right"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Subtle}" />
                    </Grid>

                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="V start" Style="{StaticResource RcLabel}" />
                            <TextBlock x:Name="VStartText" Text="&#8212;" Style="{StaticResource RcValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="V cur" Style="{StaticResource RcLabel}" />
                            <TextBlock x:Name="VCurText" Text="&#8212;" Style="{StaticResource RcValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="V best" Style="{StaticResource RcLabel}" />
                            <TextBlock x:Name="VBestText" Text="&#8212;" Style="{StaticResource RcValue}"
                                       Foreground="{StaticResource Ok}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,2">
                        <TextBlock Text="Target V  /  exit at" Style="{StaticResource RcLabel}" />
                        <TextBlock x:Name="TargetText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Reached (% of target)" Style="{StaticResource RcLabel}" />
                        <TextBlock x:Name="FractionText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Plane  /  Z (µm)" Style="{StaticResource RcLabel}" />
                        <TextBlock x:Name="PlaneText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel x:Name="DetailRows">
                        <Grid Margin="0,2,0,2">
                            <TextBlock Text="Raster points" Style="{StaticResource RcLabel}" />
                            <TextBlock x:Name="RasterText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Best XY offset (µm)" Style="{StaticResource RcLabel}" />
                            <TextBlock x:Name="BestOffsetText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Parameters. Hidden in compact mode (the Run page), where the panel runs on the
                 defaults below; the Engineer Testing Ground copy shows them for tuning. -->
            <StackPanel x:Name="ParamsPanel">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Device" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="DeviceBox" Text="hex-right" Style="{StaticResource RcBox}" Width="120" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Z step (µm)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="ZStepBox" Text="1.0" Style="{StaticResource RcBox}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="XY step (µm)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="XyStepBox" Text="0.5" Style="{StaticResource RcBox}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Raster ± steps" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="StepsBox" Text="6" Style="{StaticResource RcBox}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Plane scan" Style="{StaticResource RcLabel}" />
                <ComboBox x:Name="ScanModeBox" Width="120" HorizontalAlignment="Right" SelectedIndex="0"
                          ToolTip="Cross: line scan per axis, stops past the peak (few points).&#x0a;Spiral: full grid from the middle, stops expanding when rings stop improving.">
                    <ComboBoxItem Content="Cross (per axis)" />
                    <ComboBoxItem Content="Spiral (full grid)" />
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Past-peak drops" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="DropsBox" Text="2" Style="{StaticResource RcBox}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Max Z travel (µm)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="MaxZBox" Text="20" Style="{StaticResource RcBox}"
                         ToolTip="Total Z+ the climb may spend before giving up." />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Contact drop (%)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="ContactDropBox" Text="10" Style="{StaticResource RcBox}"
                         ToolTip="Stop if a plane's best falls this far below the peak — read as the FAU touching the part. 0 disables." />
            </Grid>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Target V (0 = live)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="TargetBox" Text="0" Style="{StaticResource RcBox}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Exit at (% of target)" Style="{StaticResource RcLabel}" />
                <TextBox x:Name="ExitPctBox" Text="85" Style="{StaticResource RcBox}" />
            </Grid>
            </StackPanel>

            <!-- SLED pre-alignment guard (SiPhOG server command channel). -->
            <Border x:Name="SledBorder" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="SledGuardCheck" IsChecked="True" Foreground="{StaticResource Text}"
                              FontSize="11.5" FontWeight="SemiBold" Content="SLED guard before start" />
                    <TextBlock x:Name="SledHelpText"
                               Text="While target SAG &gt; limit: drop the SLED current by the step, wait, re-check."
                               Foreground="{StaticResource Subtle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <StackPanel x:Name="SledParams">
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Target limit (V)" Style="{StaticResource RcLabel}" />
                        <TextBox x:Name="SledLimitBox" Text="2.1" Style="{StaticResource RcBox}" Width="70" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Current step (mA)" Style="{StaticResource RcLabel}" />
                        <TextBox x:Name="SledStepBox" Text="5" Style="{StaticResource RcBox}" Width="70" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Wait (s)" Style="{StaticResource RcLabel}" />
                        <TextBox x:Name="SledWaitBox" Text="5" Style="{StaticResource RcBox}" Width="70" />
                    </Grid>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="SLED / target now" Style="{StaticResource RcLabel}" />
                        <TextBlock x:Name="SledText" Text="&#8212;" Style="{StaticResource RcValue}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="Start Climb" Height="40" Margin="0,0,3,0"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" Click="OnStart" />
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Height="40" Margin="3,0,0,0"
                        Background="#D9534F" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" IsEnabled="False" Click="OnStop" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
