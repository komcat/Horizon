<UserControl x:Class="FAAM.UI.Views.ScanningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ScLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ScCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ScDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="ScSaveButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ScPosButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ScScriptButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="2"
            CornerRadius="4" VerticalAlignment="Top">
        <StackPanel Margin="10">
            <TextBlock Text="SCANNING" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- hex-right saved poses: top row = save the current pose into the slot, second row =
                     move there (right-click a Move button = rename / clear). -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="hex-right positions  (Save stores the current pose; right-click Move to rename / clear)"
                               Style="{StaticResource ScLabel}" TextTrimming="CharacterEllipsis" />
                    <UniformGrid Columns="2">
                        <Button x:Name="Save0Button" Tag="0" Style="{StaticResource ScSaveButton}" Margin="0,0,3,3"
                                Content="Save1" Click="OnSaveClick" />
                        <Button x:Name="Save1Button" Tag="1" Style="{StaticResource ScSaveButton}" Margin="3,0,0,3"
                                Content="Save2" Click="OnSaveClick" />
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button x:Name="Pos0Button" Tag="0" Style="{StaticResource ScPosButton}" Margin="0,3,3,0"
                                Click="OnPositionClick" MouseRightButtonUp="OnPositionRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Pos0Caption" Style="{StaticResource ScCaption}" FontSize="12" />
                                <TextBlock x:Name="Pos0Detail" Style="{StaticResource ScDetail}" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Pos1Button" Tag="1" Style="{StaticResource ScPosButton}" Margin="3,3,0,0"
                                Click="OnPositionClick" MouseRightButtonUp="OnPositionRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Pos1Caption" Style="{StaticResource ScCaption}" FontSize="12" />
                                <TextBlock x:Name="Pos1Detail" Style="{StaticResource ScDetail}" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Script presets / .moon scripts: click = run; right-click = choose preset or script / rename / clear. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Scan scripts  (right-click to choose preset / script / rename)" Style="{StaticResource ScLabel}" />
                    <UniformGrid Columns="2" Rows="2">
                        <Button x:Name="Script0Button" Tag="0" Style="{StaticResource ScScriptButton}" Margin="0,0,3,3"
                                Click="OnScriptClick" MouseRightButtonUp="OnScriptRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Script0Caption" Style="{StaticResource ScCaption}" />
                                <TextBlock x:Name="Script0Detail" Style="{StaticResource ScDetail}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Script1Button" Tag="1" Style="{StaticResource ScScriptButton}" Margin="3,0,0,3"
                                Click="OnScriptClick" MouseRightButtonUp="OnScriptRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Script1Caption" Style="{StaticResource ScCaption}" />
                                <TextBlock x:Name="Script1Detail" Style="{StaticResource ScDetail}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Script2Button" Tag="2" Style="{StaticResource ScScriptButton}" Margin="0,3,3,0"
                                Click="OnScriptClick" MouseRightButtonUp="OnScriptRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Script2Caption" Style="{StaticResource ScCaption}" />
                                <TextBlock x:Name="Script2Detail" Style="{StaticResource ScDetail}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Script3Button" Tag="3" Style="{StaticResource ScScriptButton}" Margin="3,3,0,0"
                                Click="OnScriptClick" MouseRightButtonUp="OnScriptRightClick">
                            <StackPanel>
                                <TextBlock x:Name="Script3Caption" Style="{StaticResource ScCaption}" />
                                <TextBlock x:Name="Script3Detail" Style="{StaticResource ScDetail}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Idle" Foreground="{StaticResource Subtle}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Width="90" Height="30"
                        Background="#D9534F" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" IsEnabled="False" Click="OnStop"
                        ToolTip="Cancel the running move or script" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
