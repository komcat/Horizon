<UserControl x:Class="FAAM.UI.Views.OeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="urn:horizon-station-ui"
             xmlns:v="clr-namespace:FAAM.UI.Views">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="KpiCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Grid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <!-- Live state + DOWN / UP toggle. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="LiveBadge" CornerRadius="4" Padding="18,8" MinWidth="220">
                    <StackPanel>
                        <TextBlock x:Name="LiveStateText" FontSize="26" FontWeight="Bold" Foreground="Black" />
                        <TextBlock x:Name="LiveSinceText" FontSize="12" Foreground="Black" />
                    </StackPanel>
                </Border>
                <v:DowntimeBar x:Name="Downtime" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Day picker. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="◀" Width="36" Height="30" Click="OnPrevDay" ToolTip="Previous day" />
                <DatePicker x:Name="DayPicker" Width="150" Height="30" Margin="6,0" FontSize="13"
                            VerticalContentAlignment="Center" SelectedDateChanged="OnDayPicked" />
                <Button Content="▶" Width="36" Height="30" Click="OnNextDay" ToolTip="Next day" />
                <Button Content="Today" Width="80" Height="30" Margin="6,0,0,0" Click="OnToday" />
                <TextBlock x:Name="WindowText" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Subtle}" FontSize="13" />
            </StackPanel>

            <!-- 24 h timeline. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Timeline (00:00 – 24:00)" Style="{StaticResource CardTitle}" />
                    <st:OeeTimelineBar x:Name="Timeline" />
                    <WrapPanel x:Name="Legend" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- KPIs. -->
            <UniformGrid Rows="1" Columns="5" Margin="0,0,-10,0">
                <Border Style="{StaticResource Kpi}">
                    <StackPanel>
                        <TextBlock x:Name="UptimeValue" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="Uptime — FAAM online and not down" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <StackPanel>
                        <TextBlock x:Name="AvailabilityValue" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="Availability — time not down" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <StackPanel>
                        <TextBlock x:Name="UtilizationValue" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="Utilization — production (running + standby)" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <StackPanel>
                        <TextBlock x:Name="QualityValue" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="QualityCaption" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <StackPanel>
                        <TextBlock x:Name="OeeValue" Style="{StaticResource KpiValue}" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="OEE — utilization × quality" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Breakdown + downtime log side by side. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Time breakdown" Style="{StaticResource CardTitle}" />
                        <DataGrid x:Name="BreakdownGrid" Style="{StaticResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="22">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="12" Height="12" Background="{Binding Swatch}" CornerRadius="2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                                <DataGridTextColumn Header="% elapsed" Binding="{Binding OfElapsed}" Width="80" />
                                <DataGridTextColumn Header="% of 24 h" Binding="{Binding OfDay}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Maintenance history…" Height="24" Padding="10,0"
                                    Click="OnMaintenanceHistory"
                                    ToolTip="Search every down / up entry — reason, root cause, action taken — over any date range, with CSV export" />
                            <TextBlock Text="Downtime log" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="DowntimeGrid" Style="{StaticResource Grid}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Down" Binding="{Binding Start}" Width="80" />
                                <DataGridTextColumn Header="Up" Binding="{Binding End}" Width="80" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                <DataGridTextColumn Header="Root cause" Binding="{Binding RootCause}" Width="*" />
                                <DataGridTextColumn Header="Action taken" Binding="{Binding ActionTaken}" Width="*" />
                                <DataGridTextColumn Header="Down / up by" Binding="{Binding People}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoDowntimeText" Text="No downtime on this day." Foreground="{StaticResource Subtle}"
                                   FontSize="12" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Last 7 days. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Last 7 days" Style="{StaticResource CardTitle}" />
                    <DataGrid x:Name="WeekGrid" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="110" />
                            <DataGridTextColumn Header="Running" Binding="{Binding Running}" Width="80" />
                            <DataGridTextColumn Header="Standby" Binding="{Binding Standby}" Width="80" />
                            <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" Width="80" />
                            <DataGridTextColumn Header="Down" Binding="{Binding Down}" Width="80" />
                            <DataGridTextColumn Header="Offline" Binding="{Binding Offline}" Width="80" />
                            <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="75" />
                            <DataGridTextColumn Header="Utilization" Binding="{Binding Utilization}" Width="85" />
                            <DataGridTextColumn Header="Units P/F" Binding="{Binding Units}" Width="80" />
                            <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="75" />
                            <DataGridTextColumn Header="OEE" Binding="{Binding Oee}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="DefinitionsText" Foreground="{StaticResource Subtle}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="2,0,2,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
