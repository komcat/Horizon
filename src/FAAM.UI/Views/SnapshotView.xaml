<UserControl x:Class="FAAM.UI.Views.SnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource VideoBg}" BorderBrush="{StaticResource Edge}"
            BorderThickness="1" CornerRadius="4">
        <Grid>
            <Image x:Name="Shot" Stretch="Uniform" Margin="2" />

            <!-- Empty state — replaced by the picture the moment a script pushes one. -->
            <TextBlock x:Name="Empty" Text="No snapshot" Foreground="{StaticResource Subtle}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Caption band: what the operator is looking at, and when it was taken. -->
            <Border x:Name="CaptionBand" VerticalAlignment="Top" HorizontalAlignment="Left"
                    Background="{StaticResource Overlay}" CornerRadius="2" Margin="4" Padding="5,1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CaptionText" Foreground="{StaticResource Accent}" FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StampText" Foreground="{StaticResource Subtle}" FontSize="11"
                               Margin="6,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
