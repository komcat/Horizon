<Window x:Class="FAAM.UI.Views.RoiSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select template ROI" Height="640" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="{StaticResource Subtle}" FontSize="13" Margin="0,0,0,8"
                   Text="Drag a rectangle over the feature to use as the NCC template." />

        <!-- Video surface + draggable ROI overlay. The image is uniform-stretched;
             the ROI rectangle is positioned in display px and mapped back to source px. -->
        <Border Grid.Row="1" Background="{StaticResource VideoBg}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid x:Name="Surface" Background="Transparent"
                  MouseLeftButtonDown="OnSurfaceDown" MouseMove="OnSurfaceMove" MouseLeftButtonUp="OnSurfaceUp"
                  Cursor="Cross">
                <Image x:Name="FrameImage" Stretch="Uniform" />
                <!-- Centered yellow crosshair guide lines (non-interactive). -->
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Fill="#99FFD500" IsHitTestVisible="False" />
                <Rectangle Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                           Fill="#99FFD500" IsHitTestVisible="False" />
                <Rectangle x:Name="RoiRect" Visibility="Collapsed"
                           Stroke="{StaticResource Roi}" StrokeThickness="2"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="#22FFD500" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="RoiReadout" DockPanel.Dock="Left" Foreground="{StaticResource Text}"
                       FontSize="13" VerticalAlignment="Center" Text="No selection" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="Use ROI" Width="110" Height="30"
                    Margin="8,0,0,0" IsEnabled="False" Click="OnOk" />
            <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Height="30" Click="OnCancel" />
        </DockPanel>
    </Grid>
</Window>
