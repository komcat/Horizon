<UserControl x:Class="FAAM.UI.Views.VisionProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="urn:horizon-station-ui"
             xmlns:v="clr-namespace:FAAM.UI.Views">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: profile load/save + position move-to. -->
        <Border Grid.Row="0" Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Position recall -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Position" Style="{StaticResource Lbl}" />
                    <ComboBox x:Name="PositionCombo" Width="160" Height="28" VerticalContentAlignment="Center" />
                    <Button x:Name="MoveButton" Content="Move to" Margin="6,0,0,0" Click="OnMoveTo" />
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Edge}" Margin="10,2" />

                <!-- Profile identity -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vision profile" Style="{StaticResource Lbl}" />
                    <ComboBox x:Name="ProfileCombo" Width="180" Height="28" IsEditable="True"
                              VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewButton" Content="New" Click="OnNew" />
                    <Button x:Name="LoadButton" Content="Load" Click="OnLoad" />
                    <Button x:Name="SaveButton" Content="Save" Click="OnSave" />
                    <Button x:Name="HistoryButton" Content="History" Click="OnHistory" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: image | filter+template | results -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: main image + camera + lighting -->
            <Border Grid.Column="0" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource VideoBg}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="MainImage" Stretch="Uniform" />
                            <!-- translucent filter-edges overlay (same Uniform stretch → aligned) -->
                            <Image x:Name="OverlayImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <!-- vector overlay: search ROI + detection geometry -->
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"
                                    SizeChanged="OnOverlayCanvasSizeChanged" />
                            <!-- centre crosshair -->
                            <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                       Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                            <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Fill="{StaticResource Crosshair}" IsHitTestVisible="False" />
                            <TextBlock x:Name="NoVideo" Text="No frame — turn Live on or capture a Single frame"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- camera controls -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Camera" Style="{StaticResource Lbl}" />
                        <ComboBox x:Name="CameraCombo" Width="150" Height="28" VerticalContentAlignment="Center"
                                  SelectionChanged="OnCameraChanged" />
                        <ToggleButton x:Name="LiveToggle" Content="Live" Width="64" Height="28" Margin="8,0,6,0"
                                      Checked="OnLiveToggled" Unchecked="OnLiveToggled" />
                        <Button x:Name="SingleFrameButton" Content="Single frame" Click="OnSingleFrame" />
                        <CheckBox x:Name="OverlayCheck" Content="Overlay" IsChecked="True" VerticalAlignment="Center"
                                  Foreground="{StaticResource Text}" Margin="12,0,0,0" Checked="OnOverlayToggled"
                                  Unchecked="OnOverlayToggled" />
                    </StackPanel>

                    <!-- exposure -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="AutoExposureCheck" Content="Auto exposure" VerticalAlignment="Center"
                                  Foreground="{StaticResource Text}" Margin="0,0,10,0" />
                        <TextBlock Text="Exposure µs" Style="{StaticResource Lbl}" />
                        <TextBox x:Name="ExposureBox" Width="80" Height="26" VerticalContentAlignment="Center" />
                        <Button x:Name="ApplyExposureButton" Content="Apply" Margin="6,0,0,0" Click="OnApplyExposure" />
                    </StackPanel>

                    <!-- lighting -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Lighting" Style="{StaticResource Lbl}" />
                        <ComboBox x:Name="LightingCombo" Width="130" Height="28" VerticalContentAlignment="Center" />
                        <TextBlock Text="Intensity" Style="{StaticResource Lbl}" Margin="10,0,6,0" />
                        <TextBox x:Name="LightingBox" Width="70" Height="26" VerticalContentAlignment="Center" />
                        <Button x:Name="ApplyLightingButton" Content="Apply" Margin="6,0,0,0" Click="OnApplyLighting" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: pre-process filter + template -->
            <Border Grid.Column="1" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- detection method -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Detection method" Style="{StaticResource Lbl}" />
                        <ComboBox x:Name="MethodCombo" Width="160" Height="28" VerticalContentAlignment="Center"
                                  SelectionChanged="OnMethodChanged">
                            <ComboBoxItem Content="Halcon NCC" />
                            <ComboBoxItem Content="Circle" />
                            <ComboBoxItem Content="Line" />
                            <ComboBoxItem Content="Corner" />
                            <ComboBoxItem Content="Edge (regression)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- filter chain: up to 3 stages, applied in order -->
                    <StackPanel Grid.Row="1">
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="Preview"
                                    Width="80" Click="OnPreviewFilter" />
                            <TextBlock Text="PRE-PROCESS FILTERS" Style="{StaticResource Head}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <st:FilterRow x:Name="Filter1" Stage="1" />
                        <st:FilterRow x:Name="Filter2" Stage="2" />
                        <st:FilterRow x:Name="Filter3" Stage="3" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource VideoBg}" CornerRadius="3" ClipToBounds="True"
                            MinHeight="90" Margin="0,0,0,6">
                        <Grid>
                            <Image x:Name="FilterPreviewImage" Stretch="Uniform" />
                            <TextBlock Text="filtered image" Foreground="{StaticResource Subtle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3" x:Name="MethodHeader" Text="TEMPLATE (NCC)"
                               Style="{StaticResource Head}" Margin="0,4,0,6" />

                    <!-- method-specific parameters (only one visible) -->
                    <Grid Grid.Row="4">
                        <!-- NCC: template + min score -->
                        <Grid x:Name="NccPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource VideoBg}" CornerRadius="3"
                                    ClipToBounds="True" MinHeight="90" Margin="0,0,0,6">
                                <Grid>
                                    <Image x:Name="TemplateImage" Stretch="Uniform"
                                           MouseLeftButtonDown="OnTemplateClick" />
                                    <!-- anchor coordinate frame (point + rotation axes) -->
                                    <Canvas x:Name="TemplateOverlay" IsHitTestVisible="False"
                                            SizeChanged="OnTemplateOverlaySizeChanged" />
                                    <TextBlock x:Name="NoTemplate" Text="no template" Foreground="{StaticResource Subtle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="CreateTemplateButton" Content="Create" Click="OnCreateTemplate" />
                                    <ToggleButton x:Name="AnchorToggle" Content="Set anchor" Height="28" Padding="10,0"
                                                  Margin="0,0,6,0" />
                                    <Button x:Name="ClearTemplateButton" Content="Clear" Click="OnClearTemplate" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Min score" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="MinScoreBox" Width="56" Height="26" Text="0.70"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="Angle ±°" Style="{StaticResource Lbl}" Margin="12,0,6,0" />
                                    <TextBox x:Name="NccAngleRangeBox" Width="48" Height="26" Text="180"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rotation°" Style="{StaticResource Lbl}" />
                                    <Slider x:Name="AnchorRotationSlider" Width="120" Minimum="-180" Maximum="180"
                                            Value="0" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" ValueChanged="OnAnchorRotationChanged" />
                                    <TextBlock Width="34" Foreground="{StaticResource Text}" FontSize="11"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding Value, ElementName=AnchorRotationSlider, StringFormat=0}" />
                                </StackPanel>
                                <TextBlock x:Name="TemplateInfoText" Foreground="{StaticResource Subtle}" FontSize="11"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Circle params -->
                        <StackPanel x:Name="CirclePanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Min radius" Style="{StaticResource Lbl}" Width="80" />
                                <TextBox x:Name="CircleMinRadiusBox" Width="64" Height="26" Text="5"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Max radius" Style="{StaticResource Lbl}" Width="80" />
                                <TextBox x:Name="CircleMaxRadiusBox" Width="64" Height="26" Text="200"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Min circularity" Style="{StaticResource Lbl}" Width="80" />
                                <TextBox x:Name="CircleMinCircBox" Width="64" Height="26" Text="0.70"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Line params -->
                        <StackPanel x:Name="LinePanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Min length" Style="{StaticResource Lbl}" Width="80" />
                                <TextBox x:Name="LineMinLengthBox" Width="64" Height="26" Text="20"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Direction" Style="{StaticResource Lbl}" Width="80" />
                                <ComboBox x:Name="LineDirectionCombo" Width="110" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Any" IsSelected="True" />
                                    <ComboBoxItem Content="Horizontal" />
                                    <ComboBoxItem Content="Vertical" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Polarity" Style="{StaticResource Lbl}" Width="80" />
                                <ComboBox x:Name="LinePolarityCombo" Width="130" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Any" IsSelected="True" />
                                    <ComboBoxItem Content="Black → White" />
                                    <ComboBoxItem Content="White → Black" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Scan" Style="{StaticResource Lbl}" Width="80" />
                                <ComboBox x:Name="LineScanCombo" Width="130" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Left → Right" IsSelected="True" />
                                    <ComboBoxItem Content="Right → Left" />
                                    <ComboBoxItem Content="Center out" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Corner params -->
                        <StackPanel x:Name="CornerPanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <TextBlock Text="Threshold the die, then fit its two edges and intersect them. Draw the Search ROI around the corner so only the two real edges are inside."
                                       Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Min edge len" Style="{StaticResource Lbl}" Width="90" />
                                <TextBox x:Name="CornerMinEdgeBox" Width="64" Height="26" Text="20"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Max angle dev°" Style="{StaticResource Lbl}" Width="90" />
                                <TextBox x:Name="CornerMaxDevBox" Width="64" Height="26" Text="25"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Expected" Style="{StaticResource Lbl}" Width="90" />
                                <ComboBox x:Name="CornerExpectedCombo" Width="130" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Any" IsSelected="True" />
                                    <ComboBoxItem Content="Top-left" />
                                    <ComboBoxItem Content="Top-right" />
                                    <ComboBoxItem Content="Bottom-left" />
                                    <ComboBoxItem Content="Bottom-right" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Edge-regression params -->
                        <StackPanel x:Name="EdgeRegPanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <TextBlock Text="Stacks caliper boxes along the edge, finds one sub-pixel point per box, and robustly fits a line (rejecting outliers). For ragged / low-contrast edges. Draw the Search ROI over the edge; use no filter or gaussian (not binary threshold)."
                                       Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Direction" Style="{StaticResource Lbl}" Width="100" />
                                <ComboBox x:Name="EdgeRegDirectionCombo" Width="120" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Auto" />
                                    <ComboBoxItem Content="Horizontal" />
                                    <ComboBoxItem Content="Vertical" IsSelected="True" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Caliper count" Style="{StaticResource Lbl}" Width="100" />
                                <TextBox x:Name="EdgeRegCountBox" Width="64" Height="26" Text="15"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Caliper length" Style="{StaticResource Lbl}" Width="100" />
                                <TextBox x:Name="EdgeRegLengthBox" Width="64" Height="26" Text="60"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="Width" Style="{StaticResource Lbl}" Margin="12,0,6,0" />
                                <TextBox x:Name="EdgeRegWidthBox" Width="56" Height="26" Text="20"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Polarity" Style="{StaticResource Lbl}" Width="100" />
                                <ComboBox x:Name="EdgeRegPolarityCombo" Width="130" Height="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Any" IsSelected="True" />
                                    <ComboBoxItem Content="Black → White" />
                                    <ComboBoxItem Content="White → Black" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Sigma" Style="{StaticResource Lbl}" Width="100" />
                                <TextBox x:Name="EdgeRegSigmaBox" Width="64" Height="26" Text="1.0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="Min ampl." Style="{StaticResource Lbl}" Margin="12,0,6,0" />
                                <TextBox x:Name="EdgeRegAmplBox" Width="56" Height="26" Text="20"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Max outlier px" Style="{StaticResource Lbl}" Width="100" />
                                <TextBox x:Name="EdgeRegOutlierBox" Width="64" Height="26" Text="3"
                                         VerticalContentAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- search ROI (limits detection to a region) -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Search ROI" Style="{StaticResource Head}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button x:Name="SetRoiButton" Content="Set" Click="OnSetSearchRoi" />
                        <Button x:Name="ClearRoiButton" Content="Clear" Click="OnClearSearchRoi" />
                        <TextBlock x:Name="SearchRoiText" Style="{StaticResource Lbl}" Text="(whole image)"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- detect -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="DetectButton" Content="Detect" Width="110" Height="30" Click="OnDetect" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 2: matched crops + results -->
            <Border Grid.Column="2" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MATCHED LOCATION CROP" Style="{StaticResource Head}" />
                    <UniformGrid Grid.Row="1" Columns="2" Height="150" Margin="0,0,0,8">
                        <Border Background="{StaticResource VideoBg}" CornerRadius="3" Margin="0,0,4,0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="MatchCrop1" Stretch="Uniform" />
                                <Canvas x:Name="MatchCropOverlay" IsHitTestVisible="False"
                                        SizeChanged="OnMatchCropSizeChanged" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource VideoBg}" CornerRadius="3" Margin="4,0,0,0" ClipToBounds="True">
                            <Image x:Name="MatchCrop2" Stretch="Uniform" />
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="2" Text="RESULTS" Style="{StaticResource Head}" />
                    <DataGrid Grid.Row="3" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              Background="{StaticResource Bg}" RowBackground="{StaticResource Panel}"
                              Foreground="{StaticResource Text}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                              FontFamily="Consolas" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="{StaticResource Subtle}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" Text="Ready." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
