<UserControl x:Class="FAAM.UI.Views.TestingGroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock Text="TESTING GROUND"
                       Foreground="{StaticResource Subtle}" FontSize="12" FontWeight="Bold"
                       Margin="0,0,0,2" />
            <TextBlock Text="Scratch area for experimental alignment routines. Add widgets here as they mature."
                       Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- Widgets flow left-to-right, wrapping. Drop new experimental panels in here. -->
            <WrapPanel x:Name="WidgetHost" Orientation="Horizontal">
                <ContentControl x:Name="SpiralHost" Margin="0,0,12,12" VerticalAlignment="Top" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
