<UserControl x:Class="FAAM.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Big launcher tile — the shared raised 3D button, scaled up. -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Bevel3D}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <!-- A dimmed tile for the not-yet-built slots. -->
        <Style x:Key="ReserveTile" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Product bar — pick/create the active product. Programs and positions are
             product-scoped and switch together. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="10,10,10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Product" Foreground="{StaticResource Subtle}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="ProductCombo" Width="240" Height="30" FontSize="14"
                          IsEditable="True" VerticalContentAlignment="Center" />
                <Button x:Name="OpenButton" Content="Open / Create" Width="130" Height="30"
                        Margin="10,0,0,0" Click="OnOpenProduct" />
                <Button x:Name="SaveAsButton" Content="Save As…" Width="100" Height="30"
                        Margin="6,0,0,0" Click="OnSaveAsProduct"
                        ToolTip="Clone the active product (positions, vision, programs/decks) as a new variation" />
                <TextBlock x:Name="ActiveProductText" Foreground="{StaticResource Text}" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tiles are enabled per signed-in level by ApplyAccess (see AccessPolicy);
                 a disabled tile carries a tooltip saying which level it needs. -->
            <Button x:Name="RunTile" Grid.Row="0" Grid.Column="0" Content="RUN"
                    Style="{StaticResource Tile}" Click="OnRunClick" />
            <Button x:Name="EngineerTile" Grid.Row="0" Grid.Column="1" Content="Engineer"
                    Style="{StaticResource Tile}" Click="OnEngineerClick" />
            <Button x:Name="MachineTile" Grid.Row="1" Grid.Column="0" Content="Machine"
                    Style="{StaticResource Tile}" Click="OnMachineClick" />
            <Button x:Name="VisionAlignmentTile" Grid.Row="1" Grid.Column="1" Content="Vision Alignment"
                    Style="{StaticResource Tile}" Click="OnVisionAlignmentClick"
                    ToolTip="Vision profiles (per-position recipes) and the gripped FAU teach, in one page" />
            <Button x:Name="ScriptTile" Grid.Row="2" Grid.Column="0" Content="Script"
                    Style="{StaticResource Tile}" Click="OnScriptClick" />
            <Button x:Name="CalibrationTile" Grid.Row="2" Grid.Column="1" Content="Calibration"
                    Style="{StaticResource Tile}" Click="OnCalibrationClick" />
            <Button x:Name="RepositoryTile" Grid.Row="3" Grid.Column="0" Content="Repository"
                    Style="{StaticResource Tile}" Click="OnRepositoryClick"
                    ToolTip="Browse program / deck versions and checkout an earlier one" />
        </Grid>
    </Grid>
</UserControl>
