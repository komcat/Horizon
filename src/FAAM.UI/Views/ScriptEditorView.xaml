<UserControl x:Class="FAAM.UI.Views.ScriptEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid Background="{StaticResource Bg}" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: pick / name / save a script; load an example; Run / Stop. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Script" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="ScriptCombo" Width="160" Height="28" VerticalContentAlignment="Center" />
                <Button Content="Load" Width="56" Height="28" Margin="6,0,0,0"
                        Style="{StaticResource Bevel3D}" Click="OnLoad" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <TextBlock Text="Name" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="NameBox" Width="130" Height="28" VerticalContentAlignment="Center" />
                <Button Content="Save" Width="56" Height="28" Margin="6,0,0,0"
                        Style="{StaticResource Bevel3D}" Click="OnSave" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <ComboBox x:Name="ExamplesCombo" Width="170" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="OnExampleSelected"
                          ToolTip="Load a ready-made snippet into the editor" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <!-- View-only folding: never changes the script text. -->
                <Button Content="Fold selection" Width="96" Height="28"
                        Style="{StaticResource Bevel3D}" Click="OnFoldSelection"
                        ToolTip="Collapse the selected lines (view only)" />
                <Button Content="Collapse all" Width="84" Height="28" Margin="6,0,0,0"
                        Style="{StaticResource Bevel3D}" Click="OnCollapseAll"
                        ToolTip="Collapse every block, group and comment header" />
                <Button Content="Expand all" Width="84" Height="28" Margin="6,0,0,0"
                        Style="{StaticResource Bevel3D}" Click="OnExpandAll"
                        ToolTip="Expand everything and remove selection folds" />

                <Border Width="1" Background="{StaticResource Edge}" Margin="12,2" />

                <TextBlock Text="Args" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="ArgsBox" Width="200" Height="28" VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         ToolTip="Optional arguments for Run — a Lua table the script reads as 'args', e.g. { z = false } (blank = none)" />
                <Button x:Name="RunButton" Content="► Run" Width="76" Height="28" Margin="6,0,0,0"
                        Style="{StaticResource Bevel3D}" Click="OnRun" />
                <Button x:Name="StopButton" Content="■ Stop" Width="76" Height="28" Margin="6,0,0,0"
                        IsEnabled="False" Style="{StaticResource Bevel3D}" Click="OnStop" />

                <TextBlock x:Name="StatusText" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                           Margin="14,0,0,0" Text="Ready" />
            </StackPanel>
        </Border>

        <!-- Body: editor + output on the left, command help on the right. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4">
                    <avalonedit:TextEditor x:Name="Editor"
                                           FontFamily="Consolas" FontSize="14"
                                           ShowLineNumbers="True"
                                           Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                           Padding="4"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto">
                        <avalonedit:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                                <Separator />
                                <MenuItem Header="Fold selection" Click="OnFoldSelection" />
                                <MenuItem Header="Collapse all" Click="OnCollapseAll" />
                                <MenuItem Header="Expand all" Click="OnExpandAll" />
                            </ContextMenu>
                        </avalonedit:TextEditor.ContextMenu>
                    </avalonedit:TextEditor>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="{StaticResource Edge}" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4"
                        Margin="0,2,0,0">
                    <TextBox x:Name="OutputBox" FontFamily="Consolas" FontSize="13"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Subtle}"
                             BorderThickness="0" Padding="6" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Edge}" Margin="2,0" />

            <!-- Command help: searchable list; double-click inserts the call. -->
            <Border Grid.Column="2" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="machine API" Foreground="{StaticResource Text}"
                               FontWeight="SemiBold" Margin="8,6" />
                    <TextBox Grid.Row="1" x:Name="HelpSearch" Margin="8,0,8,6" Height="26"
                             VerticalContentAlignment="Center" TextChanged="OnHelpSearch"
                             ToolTip="Filter commands" />

                    <ListBox Grid.Row="2" x:Name="CommandsList" Margin="4,0,4,4"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnCommandInsert">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" ToolTip="{Binding Summary}">
                                    <TextBlock Text="{Binding Signature}" Foreground="{StaticResource Text}"
                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Subtle}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
