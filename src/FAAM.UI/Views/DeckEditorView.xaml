<UserControl x:Class="FAAM.UI.Views.DeckEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A deck row card. -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunState}" Value="awaiting">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="running">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Run-state text marker. -->
        <Style x:Key="RunStateText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunState}" Value="running">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="awaiting">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="failed">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Deck" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Text}" />
            <TextBox Width="200" Height="28" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="180" Height="28" Margin="0,0,10,0"
                      ItemsSource="{Binding Decks}" SelectedItem="{Binding SelectedDeck}" />
            <Button Content="New" Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" />
            <Button Content="Save" Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" />
            <Button Content="Save As" Style="{StaticResource ToolButton}" MinWidth="64" Click="OnSaveAs"
                    ToolTip="Save the current deck as a new, independent deck to edit for a product variation" />
            <Button Content="Import" Style="{StaticResource ToolButton}" MinWidth="60" Click="OnImport"
                    ToolTip="Import a deck (and its programs) from another product, saved under a new name here" />
            <Button Content="Delete" Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" />
            <Button Content="History" Style="{StaticResource ToolButton}" MinWidth="62" Click="OnHistory" />
            <Border Width="1" Margin="6,2,12,2" Background="{StaticResource Edge}" />
            <Button Content="+ Program" Style="{StaticResource ToolButton}" Command="{Binding AddProgramCommand}" />
            <Border Width="1" Margin="6,2,12,2" Background="{StaticResource Edge}" />
            <Button Content="Run" Style="{StaticResource ToolButton}" Command="{Binding RunCommand}" />
            <Button Content="Activate Next" Style="{StaticResource ToolButton}" MinWidth="92" Command="{Binding ActivateNextCommand}" />
            <Button Content="Stop" Style="{StaticResource ToolButton}" Command="{Binding StopCommand}" />
            <TextBlock Text="●  unsaved changes" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
        </WrapPanel>

        <!-- Program rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Order}" Width="22" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtle}" />
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="Enabled — unchecked rows are skipped" />
                                <TextBlock Text="Program" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{StaticResource Text}" />
                                <ComboBox Width="180" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AvailablePrograms}" SelectedItem="{Binding Program}" />
                                <Button Content="▶ Run" Height="26" MinWidth="52" Margin="0,0,8,0" Padding="6,0"
                                        Command="{Binding RunProgramCommand}"
                                        ToolTip="Run only this program (not the whole deck)" />
                                <CheckBox Content="Run page" IsChecked="{Binding ShowInRun}" VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          ToolTip="Show a button for this program on the Run page" />

                                <!-- Transition into this program (hidden for the first row) -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding HasTransition, Converter={StaticResource BoolToVis}}">
                                    <Border Width="1" Margin="0,2,12,2" Background="{StaticResource Edge}" />
                                    <CheckBox Content="Auto" IsChecked="{Binding Auto}" VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              ToolTip="On = advance automatically (after delay/condition); Off = wait for operator" />
                                    <TextBlock Text="Delay(s)" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{StaticResource Text}" />
                                    <TextBox Width="48" Height="26" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                             Text="{Binding DelaySeconds}" IsEnabled="{Binding Auto}" />
                                    <TextBlock Text="When" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{StaticResource Text}" />
                                    <TextBox Width="150" Height="26" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                             Text="{Binding Condition}" IsEnabled="{Binding Auto}"
                                             ToolTip="Optional condition, e.g. sag_v &gt; 0.5  (empty = always)" />
                                </StackPanel>

                                <Button Content="↑" Width="26" Height="26" Margin="0,0,4,0" Command="{Binding MoveUpCommand}" />
                                <Button Content="↓" Width="26" Height="26" Margin="0,0,4,0" Command="{Binding MoveDownCommand}" />
                                <Button Content="✕" Width="26" Height="26" Margin="0,0,8,0" Command="{Binding RemoveCommand}" />
                                <TextBlock Text="{Binding RunState}" Style="{StaticResource RunStateText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Log -->
        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                Background="{StaticResource Panel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" Margin="6,4" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
