<UserControl x:Class="FAAM.UI.Views.UtilityAppHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Run-page alignment utilities, laid out directly and always ready to use:
         the combined U-correction → FAU pre-align panel + the SiPhOG connection panel on the
         top row, the Scanning panel below across both columns. The Raster Climb and Auto W
         panels were removed (DEPRECATED — do not use; the Scanning panel's script presets replace
         them). The old "phone" springboard (tiles + Back navigation) was dropped per operator
         feedback, and the Hexapod Scan app is not used. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="AlignHost"  Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Top" />
            <ContentControl x:Name="SiphogHost" Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top" />
            <!-- Scanning: hex-right saved-pose buttons + .moon script buttons, across both columns. -->
            <ContentControl x:Name="ScanHost"   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                            VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</UserControl>
