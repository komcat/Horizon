<UserControl x:Class="FAAM.UI.Views.Sections.SettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FAAM.UI.ViewModels.Sections">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Application settings" Foreground="{StaticResource Text}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- Machine identity - stamped onto every DUT run alongside the operator. -->
            <TextBlock Text="Machine identity" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine number" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="240" Text="{Binding MachineNumber}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="stamped on every DUT run (blank = this PC name)"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Credential" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="240" Text="{Binding MachineCredential}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="the machine signature on the record - calibration cert / asset tag"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="mm / pixel" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MmPerPixel}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="real-world mm per image pixel"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="MoveClick device" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MoveClickDevice}" Width="160" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="motion device the click-to-move jog commands (blank = off)"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Image X → axis" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MoveClickXAxis}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Image Y → axis" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MoveClickYAxis}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="X sign (+1/-1)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MoveClickXSign}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Y sign (+1/-1)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MoveClickYSign}" />
            </Grid>

            <TextBlock Text="Jog velocity presets (mm/s)" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hex family" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="Auto" Text="{Binding HexVelocityPresetsText}"
                         ToolTip="Comma-separated, e.g. 0.1, 0.5, 1, 2, 5, 10" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="ACS / gantry" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="Auto" Text="{Binding GantryVelocityPresetsText}"
                         ToolTip="Comma-separated, e.g. 1, 5, 10, 20, 40, 75" />
            </Grid>

            <TextBlock Text="Jog step presets" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hex family (µm)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="Auto" Text="{Binding HexStepPresetsText}"
                         ToolTip="Comma-separated µm, e.g. 0.5, 1, 2, 2.5, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="ACS / gantry (mm)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="Auto" Text="{Binding GantryStepPresetsText}"
                         ToolTip="Comma-separated mm, e.g. 0.1, 0.2, 0.25, 0.5, 1, 2, 5" />
            </Grid>

            <TextBlock Text="Camera → Needle offset (mm)" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X offset" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CameraNeedleOffsetX}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="needle = camera + offset (overwritten by a calibration run)"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y offset" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CameraNeedleOffsetY}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Approach" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CameraNeedleApproachMm}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="slow-crawl distance (mm) before touch on automated re-runs"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Touch Z adjust" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CameraNeedleTouchZAdjustMm}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="tweak touch height (mm): + deeper toward surface, − higher"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Dwell (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CameraNeedleDwellMs}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="epoxy window — shot output held ON (Dispenser_Shot)"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Debounce (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CameraNeedleDebounceMs}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="settle delay on the shot ON and OFF edges"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,8" />
            </Grid>

            <TextBlock Text="Camera" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
            <CheckBox Content="Pop up the main_camera window automatically on startup"
                      Foreground="{StaticResource Text}" Margin="0,0,0,4"
                      IsChecked="{Binding ShowMainCameraOnStartup}" />

            <TextBlock Text="Startup" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
            <CheckBox Content="Sign in automatically at startup as the first user whose level has no password"
                      Foreground="{StaticResource Text}" Margin="0,0,0,4"
                      IsChecked="{Binding AutoLoginOperator}"
                      ToolTip="Only ever skips the prompt for a level with no password set. Once every level has a password, startup always asks." />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Save" Width="90" Height="30" Command="{Binding SaveCommand}" />
                <Button Content="Reload" Width="90" Height="30" Margin="8,0,0,0" Command="{Binding ReloadCommand}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <!-- ==================== Users =====================================
                 Admin-only, like this whole section: the employee directory and the
                 per-level sign-in passwords. Directory edits save immediately (they
                 write users.json, not app_settings.json), so they do NOT wait for the
                 Save button above. -->
            <Separator Margin="0,20,0,10" />
            <TextBlock Text="Users" Foreground="{StaticResource Text}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Employees registered at this station. Sign-in needs the employee number AND the password of the level they are registered at. Changes here save straight to users.json."
                       Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="The first row is the built-in recovery Admin (employee 'admin', password 'admin'). It is fixed in the software, always signs in whatever this directory says, and cannot be removed — it is the way back in if the Admin level password is lost. It is a known credential, not a secret: anyone standing at this station can use it, and runs made under it are stamped 'admin' rather than a person."
                       Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" MaxHeight="220" Margin="0,0,0,8"
                      Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                      GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee #" Binding="{Binding Id}" Width="130" />
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Employee #" Style="{StaticResource FieldLabel}" />
                <TextBox Width="110" Margin="0,0,10,0" Text="{Binding NewUserId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox Width="180" Margin="0,0,10,0" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Level" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="130" Height="26" Margin="0,0,10,8" VerticalContentAlignment="Center"
                          ItemsSource="{x:Static vm:SettingsSectionViewModel.Levels}"
                          SelectedItem="{Binding NewUserLevel}" />
                <Button Content="Add" Width="80" Height="26" Margin="0,0,8,8" Command="{Binding AddUserCommand}" />
                <Button Content="Delete selected" Width="120" Height="26" Margin="0,0,0,8"
                        Command="{Binding DeleteUserCommand}"
                        ToolTip="Removes the highlighted employee. Past DUT runs keep the number they were stamped with." />
            </StackPanel>

            <TextBlock Text="Level passwords" Foreground="{StaticResource Text}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="One shared password per level. Leave the box empty and press Set to clear it - that level then signs in on the employee number alone."
                       Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Level" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="130" Height="26" Margin="0,0,10,8" VerticalContentAlignment="Center"
                          ItemsSource="{x:Static vm:SettingsSectionViewModel.Levels}"
                          SelectedItem="{Binding PasswordLevel}" />
                <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="LevelPasswordBox" Width="180" Height="26" Margin="0,0,10,8"
                             VerticalContentAlignment="Center" />
                <Button Content="Set" Width="80" Height="26" Margin="0,0,10,8" Click="OnSetLevelPassword" />
                <TextBlock Text="{Binding PasswordLevelState}" Foreground="{StaticResource Subtle}"
                           VerticalAlignment="Center" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock Text="{Binding DirectoryStatus}" Foreground="{StaticResource Subtle}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
