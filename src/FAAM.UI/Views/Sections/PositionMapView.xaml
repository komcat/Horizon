<UserControl x:Class="FAAM.UI.Views.Sections.PositionMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: Link mode, remove the selected node, hint / last result -->
        <Grid Grid.Row="0" Margin="2,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Map" Foreground="{StaticResource Subtle}"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding Hint}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Selected-node actions -->
                <StackPanel Orientation="Horizontal" Margin="8,0,16,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Button Content="Move" Height="26" Padding="14,0" Margin="0,0,6,0" FontWeight="SemiBold"
                            Command="{Binding MoveSelectedCommand}"
                            ToolTip="Move the device to the selected node's position (section velocity). STOP aborts." />
                    <Button Content="Update" Height="26" Padding="12,0"
                            Command="{Binding UpdateSelectedCommand}"
                            ToolTip="Save the device's current axis position into the selected node's position (asks first)" />
                </StackPanel>
                <ToggleButton Content="Link" Height="26" Padding="12,0" Margin="0,0,6,0"
                              IsChecked="{Binding LinkMode}"
                              ToolTip="Link mode: click the 1st node, then the 2nd, to join them with a line" />
                <Button Content="Remove" Height="26" Padding="12,0"
                        Command="{Binding RemoveSelectedCommand}"
                        ToolTip="Take the selected node (and its links) off the map — the position itself is kept (Delete)" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid x:Name="Surface" Width="{Binding Width}" Height="{Binding Height}"
                      Background="{StaticResource Bg}" AllowDrop="True"
                      DragOver="OnDragOver" Drop="OnDrop"
                      MouseLeftButtonDown="OnSurfaceDown" MouseMove="OnSurfaceMove"
                      MouseLeftButtonUp="OnSurfaceUp" LostMouseCapture="OnSurfaceLostCapture">

                    <!-- Links, under the nodes. A wide transparent line makes them easy to right-click. -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Label}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove link" Click="OnRemoveEdge" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Line X1="{Binding A.X}" Y1="{Binding A.Y}" X2="{Binding B.X}" Y2="{Binding B.Y}"
                                          Stroke="Transparent" StrokeThickness="12" />
                                    <Line X1="{Binding A.X}" Y1="{Binding A.Y}" X2="{Binding B.X}" Y2="{Binding B.Y}"
                                          Stroke="{StaticResource Subtle}" StrokeThickness="2.5" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Trajectory: current node → selected node. Dashed = preview, solid = the move is running. -->
                    <Canvas IsHitTestVisible="False"
                            Visibility="{Binding HasTrajectory, Converter={StaticResource BoolToVis}}">
                        <Canvas DataContext="{Binding Trajectory}">
                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                  Stroke="{StaticResource Accent}">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="StrokeThickness" Value="2.5" />
                                        <Setter Property="StrokeDashArray" Value="3 2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="StrokeThickness" Value="4" />
                                                <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                            <Polygon Points="{Binding Head}" Fill="{StaticResource Accent}" />
                        </Canvas>
                    </Canvas>

                    <!-- Nodes: circle centred on (X, Y), name below. Green = the device is on this position. -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="120" Cursor="SizeAll" MouseLeftButtonDown="OnNodeDown"
                                            ToolTip="{Binding Name}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from map" Click="OnRemoveNode" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Ellipse Width="36" Height="36" HorizontalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Panel}" />
                                                <Setter Property="Stroke" Value="{StaticResource Subtle}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTaught}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource Bg}" />
                                                        <Setter Property="StrokeDashArray" Value="2 2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAtPosition}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLinkSource}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Warn}" />
                                                        <Setter Property="StrokeThickness" Value="4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
