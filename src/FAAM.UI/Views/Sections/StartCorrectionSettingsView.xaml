<!-- Machine › Settings, FAAM panel: Start correction (StartCorrectionSettingsViewModel). -->
<UserControl x:Class="FAAM.UI.Views.Sections.StartCorrectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Start correction" Foreground="{StaticResource Text}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
        <CheckBox Content="Move to the vision facets first (visionFacet → visionFAUFacet) and measure U by vision"
                  Foreground="{StaticResource Text}" Margin="0,0,0,4"
                  IsChecked="{Binding AutoVisionUCorrection}"
                  ToolTip="Off: Start correction skips the vision facet moves and goes straight to the manual UCorr_P1 → P2 → F1 → F2 capture. Same setting as 'Auto-run vision U-correction' on the Find First Light tab." />
    </StackPanel>
</UserControl>
