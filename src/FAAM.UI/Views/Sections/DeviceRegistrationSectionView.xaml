<UserControl x:Class="FAAM.UI.Views.Sections.DeviceRegistrationSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FAAM.UI.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PickOn" Color="#FFA000" />
        <SolidColorBrush x:Key="OutlineOn" Color="#C8C8C8" />
        <SolidColorBrush x:Key="MoveOn" Color="#00C8FF" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Small" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MoveToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource MoveOn}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MoveOn}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PickOn}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PickOn}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutlineToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource OutlineOn}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OutlineOn}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Panel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Live feed: crosshair + MoveClick (jog the camera device) + Pick (add points). -->
        <Border Grid.Column="0" Background="{StaticResource VideoBg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="3" MouseLeftButtonDown="OnFeedClick"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Image x:Name="MainImage" Source="{Binding Camera.Frame}" Stretch="Uniform" Margin="2"
                       MaxWidth="1280" MaxHeight="1024" RenderOptions.BitmapScalingMode="LowQuality" />

                <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="{StaticResource Crosshair}" />
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Fill="{StaticResource Crosshair}" />

                <!-- Live registered-tool overlay (the same control the Run page uses). -->
                <v:ToolOverlayView x:Name="ToolOverlay" />

                <!-- Picked points + their average + outline preview (drawn in code-behind). -->
                <Canvas x:Name="PointOverlay" IsHitTestVisible="False" ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Text="No video" Foreground="{StaticResource Subtle}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Camera.HasNoVideo, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6">
                    <ToggleButton x:Name="MoveToggle" Style="{StaticResource MoveToggle}" Content="MoveClick"
                                  Checked="OnMoveArmed"
                                  ToolTip="Click the image to jog the camera device from the crosshair centre" />
                    <ToggleButton x:Name="PickToggle" Style="{StaticResource PickToggle}" Content="Pick points" Margin="6,0,0,0"
                                  IsChecked="{Binding PickArmed, Mode=TwoWay}" Checked="OnPickArmed"
                                  ToolTip="Click the gripper in the image to add a registration point" />
                    <ToggleButton x:Name="OutlineToggle" Style="{StaticResource OutlineToggle}" Content="Pick outline" Margin="6,0,0,0"
                                  IsChecked="{Binding PickOutlineArmed, Mode=TwoWay}" Checked="OnOutlineArmed"
                                  ToolTip="Click two opposite corners of the gripper body to set the outline box" />
                    <Border Background="{StaticResource Overlay}" CornerRadius="3" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Camera.SelectedCamera}" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource Overlay}"
                        CornerRadius="3" Margin="6" Padding="8,3">
                    <TextBlock Text="{Binding LiveText}" Foreground="#FFA000" FontFamily="Consolas" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <!-- Procedure panel -->
        <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="4" Margin="8,0,0,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Device registration" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,6"
                               Text="Register the tool (gripper) on one motion device to the camera on another. Persists until the hardware changes." />

                    <!-- Status — pinned near the top so a refused action is never scrolled out of view. -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusWarn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tool device" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Height="24" Margin="0,2" ItemsSource="{Binding MotionDevices}"
                                  SelectedItem="{Binding ToolDevice}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Camera device" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2" ItemsSource="{Binding MotionDevices}"
                                  SelectedItem="{Binding CameraDevice}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2" ItemsSource="{Binding Camera.Cameras}"
                                  SelectedItem="{Binding Camera.SelectedCamera}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Label" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Height="24" Margin="0,2" VerticalContentAlignment="Center" Text="{Binding Label}" />
                    </Grid>

                    <!-- Step 1 -->
                    <TextBlock Text="1 · Tool pose" Style="{StaticResource StepTitle}" />
                    <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11.5"
                               Text="Park the gripper anywhere (jog rail), then capture its pose." />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <Button Content="Capture tool pose" Height="26" Padding="10,0" Command="{Binding CaptureToolPoseCommand}" />
                        <Button Content="Move to pose" Height="26" Padding="10,0" Margin="8,0,0,0" Command="{Binding MoveToPoseCommand}"
                                ToolTip="Send the tool device back to the captured pose (all axes)" />
                    </StackPanel>
                    <TextBlock Text="{Binding ToolPoseText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

                    <!-- Step 2 -->
                    <TextBlock Text="2 · Camera on the gripper" Style="{StaticResource StepTitle}" />
                    <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11.5"
                               Text="Jog the camera device (rail or MoveClick on the feed) until the gripper is in view and in focus, then capture the focus height." />
                    <Button Content="Capture focus Z" Height="26" Margin="0,4,0,2" HorizontalAlignment="Left" Padding="10,0"
                            Command="{Binding CaptureFocusZCommand}"
                            ToolTip="Record the camera device Z now as the height at which the gripper is in focus" />
                    <TextBlock Text="{Binding CameraZText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11" />

                    <!-- Step 3 -->
                    <TextBlock Text="3 · Tool centre points" Style="{StaticResource StepTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Points" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="56" Height="24" ItemsSource="{Binding PointModes}" SelectedItem="{Binding PointMode}" />
                        <TextBlock Text="{Binding PointsSummary}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Button Content="Clear" Height="24" Padding="8,0" Margin="10,0,0,0" Command="{Binding ClearPointsCommand}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"
                               Text="Arm 'Pick points' on the feed and click opposite edges (2) or the four corners (4) of the gripper. The average is the tool centre; the camera may be re-jogged between clicks." />
                    <ItemsControl ItemsSource="{Binding Points}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AverageText}" Foreground="#FFA000" FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0" />

                    <!-- Step 4 -->
                    <TextBlock Text="4 · Outline" Style="{StaticResource StepTitle}" />
                    <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11.5"
                               Text="Arm 'Pick outline' on the feed and click two opposite corners of the gripper body. The box is anchored to the tool centre (step 3) but need not be centred on it — its offset is computed from the corners. Fine-tune the numbers below." />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding OutlineSummary}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                        <Button Content="Clear outline" Height="24" Padding="8,0" Margin="10,0,0,0" Command="{Binding ClearOutlineCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding OutlineWidth, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Length (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding OutlineLength, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Box offset X (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding OutlineOffsetX, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Box centre minus tool anchor along image X (gantry frame). 0 = anchor at the box centre." />
                        <TextBlock Text="Y (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding OutlineOffsetY, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Box centre minus tool anchor along image Y (gantry frame). 0 = anchor at the box centre." />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"
                               Text="Width runs along image X, length along image Y; the grey box on the feed is the live preview." TextWrapping="Wrap" />

                    <!-- Axis map + bound -->
                    <TextBlock Text="Axis map (camera ← tool)" Style="{StaticResource StepTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="X ←" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="48" Height="24" ItemsSource="{Binding Axes}" SelectedItem="{Binding MapXAxis}" />
                        <TextBlock Text="×" Style="{StaticResource FieldLabel}" Margin="6,0" />
                        <ComboBox Width="52" Height="24" ItemsSource="{Binding Signs}" SelectedItem="{Binding MapXSign}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Y ←" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="48" Height="24" ItemsSource="{Binding Axes}" SelectedItem="{Binding MapYAxis}" />
                        <TextBlock Text="×" Style="{StaticResource FieldLabel}" Margin="6,0" />
                        <ComboBox Width="52" Height="24" ItemsSource="{Binding Signs}" SelectedItem="{Binding MapYSign}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Z ←" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="48" Height="24" ItemsSource="{Binding Axes}" SelectedItem="{Binding MapZAxis}" />
                        <TextBlock Text="×" Style="{StaticResource FieldLabel}" Margin="6,0" />
                        <ComboBox Width="52" Height="24" ItemsSource="{Binding Signs}" SelectedItem="{Binding MapZSign}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Seeded from jog_transforms.json: which tool axis (and sign) moves the tool along camera X / Y / Z." />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Max move (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding MaxMove}" />
                    </StackPanel>

                    <!-- Step 5 -->
                    <TextBlock Text="5 · Save" Style="{StaticResource StepTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save registration" Height="28" Padding="12,0" FontWeight="SemiBold" Command="{Binding SaveCommand}" />
                        <Button Content="Delete" Height="28" Padding="10,0" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
                        <Button Content="Reload" Height="28" Padding="10,0" Margin="8,0,0,0" Command="{Binding ReloadCommand}" />
                    </StackPanel>

                    <!-- Test -->
                    <TextBlock Text="Test (bounded moves)" Style="{StaticResource StepTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Camera → tool" Height="26" Padding="10,0" Command="{Binding CameraToToolCommand}"
                                ToolTip="Move the camera device so the camera is centred on the tool" />
                        <Button Content="Tool → camera" Height="26" Padding="10,0" Margin="8,0,0,0" Command="{Binding ToolToCameraCommand}"
                                ToolTip="Move the tool device so the tool sits under the camera centre" />
                        <CheckBox Content="include Z" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="10,0,0,0"
                                  IsChecked="{Binding TestIncludeZ}"
                                  ToolTip="Also move Z (camera to the focus height / tool to the camera focus plane + offset). Needs a captured focus Z." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Tool → camera Z offset (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Small}" Text="{Binding ZOffset, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Gripper parks at the focus plane + this when Z is included. −1 = 1 mm higher (gantry Z− is up). Saved with the registration." />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Negative = higher (out of focus above). Camera → tool ignores it and always goes to the taught focus height." />

                    <TextBlock Text="Tracking arm (test)" Style="{StaticResource StepTitle}" />
                    <CheckBox Content="Track — jog either device, the other follows" Foreground="{StaticResource Text}"
                              IsChecked="{Binding Tracking}"
                              ToolTip="Jog gantry-main and the gripper comes under the camera (tool → camera, with the Z offset when Z is included); jog hex-right and the camera goes to the gripper (camera → tool). Bounded moves; off when you leave this section." />
                    <TextBlock Foreground="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Uses the same bounded moves as the test buttons; the follower moves once the jog settles. A jog beyond the max move is refused, so re-couple with a test button." />

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
