<UserControl x:Class="FAAM.UI.Views.Sections.LaserSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Device picker -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Device" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ListBox Style="{StaticResource DeviceSelector}" VerticalAlignment="Center" Margin="0,0,16,0"
                         ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                <TextBlock Text="Connected" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Connected}" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- TEC group -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel>
                <TextBlock Text="TEC" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Temperature" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Temperature}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                               Width="90" Margin="8,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="setpoint" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SetpointTemperature}" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                               Width="90" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Set °C" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBox Width="64" Margin="8,0,8,0" VerticalAlignment="Center" Text="{Binding TemperatureSetpoint}" />
                    <Button Content="Set" Width="56" Height="26" Margin="0,0,16,0"
                            Command="{Binding SetTemperatureCommand}" />
                    <Button Content="TEC On" Width="74" Height="26" Margin="0,0,6,0"
                            Command="{Binding TecOnCommand}" />
                    <Button Content="TEC Off" Width="74" Height="26" Margin="0,0,16,0"
                            Command="{Binding TecOffCommand}" />
                    <TextBlock Text="On" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TecOn}" Foreground="{StaticResource Text}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Laser-diode group -->
        <Border Grid.Row="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Laser diode" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LaserCurrent}" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                               Width="90" Margin="8,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="setpoint" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SetpointLaserCurrent}" Foreground="{StaticResource Subtle}" FontFamily="Consolas"
                               Width="90" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="Set mA" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBox Width="64" Margin="8,0,8,0" VerticalAlignment="Center" Text="{Binding LaserCurrentSetpoint}" />
                    <Button Content="Set" Width="56" Height="26" Margin="0,0,16,0"
                            Command="{Binding SetLaserCurrentCommand}" />
                    <Button Content="Laser On" Width="74" Height="26" Margin="0,0,6,0"
                            Command="{Binding LaserOnCommand}" />
                    <Button Content="Laser Off" Width="74" Height="26" Margin="0,0,16,0"
                            Command="{Binding LaserOffCommand}" />
                    <TextBlock Text="On" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LaserOn}" Foreground="{StaticResource Text}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Subtle}" FontStyle="Italic"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
