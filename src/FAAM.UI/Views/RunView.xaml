<UserControl x:Class="FAAM.UI.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="urn:horizon-station-ui"
             xmlns:v="clr-namespace:FAAM.UI.Views">
    <Grid>
        <!-- Main area: left content + camera column. The Log sits under the LEFT column
             only (Row 1, Col 0); the camera column spans both rows so its feed / zoom /
             chart area keeps the vertical space beside the log. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <!-- Draggable splitter between the left panels and the camera column. -->
                <ColumnDefinition Width="Auto" />
                <!-- Auto so the camera column shrinks to the (aspect-correct) feed
                     width instead of pillar-boxing it; the left column takes the rest.
                     Dragging the splitter pins it to a pixel width (the feed scales down
                     uniformly); double-clicking the splitter restores Auto. -->
                <ColumnDefinition x:Name="CameraColumn" Width="Auto" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left column — process steps panel + the alignment utilities. -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <st:RunStepsPanel Grid.Column="0" x:Name="StepsPanel"
                                  HorizontalAlignment="Left" Width="240" />

                <!-- Alignment utilities laid out directly and always ready to use
                     (power-supply channel ON/OFF + V/A readout on top, U correction + FAU
                     pre-align + Hill Climber below). The SiPhOG connection + chart live in the
                     camera-column tab group. -->
                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <v:PsuQuickPanel DockPanel.Dock="Top" x:Name="PsuPanel" Margin="0,0,0,8" />
                    <v:UtilityAppHost x:Name="AppHost" />
                </DockPanel>
            </Grid>

            <!-- Splitter — drag left/right to grow/shrink the camera column (so the left
                 panels are not cut off); double-click to snap back to the full feed width. -->
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="8"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False"
                          MouseDoubleClick="OnSplitterReset" DragCompleted="OnSplitterDragCompleted"
                          ToolTip="Drag to resize the camera area · double-click to reset">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <!-- Grip: a short vertical bar centred on the splitter. -->
                            <Rectangle Width="2" Height="40" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource Edge}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Camera column — spans both rows so it extends down beside the log. -->
            <st:RunCameraPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" x:Name="Camera" />

            <!-- Log area — under the left column only (Row 1, Col 0); the camera column
                 (RowSpan 2) keeps the vertical space to its right. -->
            <st:RunLogView Grid.Row="1" Grid.Column="0" Height="120" Margin="0,8,0,0" x:Name="LogView" />
        </Grid>
    </Grid>
</UserControl>
