<Window x:Class="FAAM.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FAAM.UI.Views"
        Title="FAAM"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top-left: Home button (native themed). -->
        <Button Grid.Row="0" Grid.Column="0" Content="Home" Click="OnHomeClick"
                Width="290" Height="56" Margin="2,2,8,8" FontSize="14" />

        <!-- Top: Header1 (page title) + engine status + identity chip. -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,2,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                <TextBlock x:Name="Header1Text" Text="HOME" Foreground="{StaticResource Accent}"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Engine status + Reconnect — bound to the Machine page VM in code,
                 shown only on the Machine page (its sampler drives these). -->
            <Border x:Name="EngineHeader" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Visibility="Collapsed">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <Run Text="Engine: " Foreground="{StaticResource Subtle}" />
                        <Run Text="{Binding EngineState, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding DeviceSummary, Mode=OneWay}"
                               Foreground="{StaticResource Subtle}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Reconnect" Width="100" Height="26"
                            VerticalAlignment="Center" Command="{Binding ReconnectCommand}" />
                </Grid>
            </Border>

            <!-- Identity chip — current product + signed-in operator + log in/out.
                 Always visible; populated in code from the product/session state. -->
            <Border x:Name="IdentityHeader" Grid.Column="2" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Product: " Foreground="{StaticResource Subtle}" />
                        <Run x:Name="ProductRun" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0">
                        <Run Text="Operator: " Foreground="{StaticResource Subtle}" />
                        <Run x:Name="OperatorRun" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button x:Name="LogoutButton" Content="Logout" Width="82" Height="26"
                            Margin="16,0,0,0" Click="OnLogout" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Left rail — global jog panel. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Width="290" Margin="2,0,8,2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <v:JogPanel x:Name="JogPanelControl" />
        </ScrollViewer>

        <!-- Main content: the active page. -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,2,2"
                Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
            <ContentControl x:Name="PageHost" Margin="12" />
        </Border>
    </Grid>
</Window>
